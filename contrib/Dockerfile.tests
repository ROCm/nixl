# Builds the nixl C++ unit-test suite on Ubuntu 24.04 so the binaries are
# ABI-compatible with the rocjitsu QEMU guests (which also run Ubuntu 24.04).
#
# DOCA, Mooncake and Redis paths are excluded by restricting plugins. Without
# ROCM_VERSION the build is CPU-only. With it, ROCm X.Y.Z is installed, UCX
# and nixl are built against it, and the tests that take a memory type also
# run on GPU memory; the guest then has to carry the same ROCm release, which
# is not bundled.
#
# The build produces /nixl-tests/, the meson install tree that upstream's
# .gitlab/test_cpp.sh runs from, plus what the tests need beside it:
#   bin/       — every test and example executable meson installs
#   lib/       — nixl shared libs, with the plugins and the gtest mock
#                plugins under lib/plugins/
#   ucx/       — UCX built from source (lib/ with its modules, bin/ucx_info)
#   deps/      — the other shared libraries the tests load (gtest, libaio,
#                ...), so the guest needs nothing installed
#   build-dir  — the build directory compiled into some gtests as BUILD_DIR;
#                they look for plugins under it, so the guest links it back
#                to lib/plugins
#
# The workflow extracts /nixl-tests/, scps it to the guest and runs the tests
# there. UCX is bundled because the UCX plugin needs a newer UCX than Ubuntu
# 24.04 packages (it uses UCS_MEMORY_TYPE_ZE_DEVICE and UCS_BIT_GET).
#
# Build usage:
#   docker build [--build-arg ROCM_VERSION=10.2.0] -t nixl-tests \
#       -f contrib/Dockerfile.tests .
#   docker run --rm nixl-tests tar -cC /nixl-tests . | tar -xC local-tests-dir/

# ---------------------------------------------------------------------------
# stage: gtest-build — build googletest as .so from source
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS gtest-build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake libgtest-dev \
    && cmake -S /usr/src/googletest -B /tmp/gtest-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_INSTALL_PREFIX=/gtest-install \
    && cmake --build /tmp/gtest-build --parallel "$(nproc)" \
    && cmake --install /tmp/gtest-build \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# stage: deps — UCX built from source + meson
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS deps

# Same UCX ref as contrib/Dockerfile, which builds the wheels.
ARG UCX_REPO="https://github.com/openucx/ucx.git"
ARG UCX_REF="v1.23.x"

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config ninja-build git ca-certificates \
        autoconf automake libtool \
        python3 python3-dev python3-pip python3-venv \
        libaio-dev \
    && pip3 install --break-system-packages meson meson-python pybind11 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gtest-build /gtest-install /usr/local

# ROCm, when asked for: the same packages and the same /opt/rocm layout as the
# wheel build in contrib/Dockerfile.manylinux, from the apt repository.
# amdrocm-runtime-dev (HIP and HSA headers) is unpacked without its dependency
# amdrocm-llvm-dev, which is 2 GB and unused.
ARG ROCM_VERSION=""
RUN if [ -z "$ROCM_VERSION" ]; then exit 0; fi \
    && mm="$(echo "$ROCM_VERSION" | cut -d. -f1,2)" \
    && case "$mm" in \
         7.14) repo=https://repo.amd.com/rocm/packages-multi-arch/ubuntu2404 \
               key=https://repo.amd.com/rocm/packages-multi-arch/gpg/rocm.gpg ;; \
         1[0-9].*) repo=https://stable.repo.amd.com/rocm/core/packages/ubuntu2404 \
               key=https://stable.repo.amd.com/rocm/gpg/packages.gpg ;; \
         *) echo "ROCm $ROCM_VERSION is not supported: needs 7.14, or 10.0 and newer" >&2; exit 1 ;; \
       esac \
    && apt-get update && apt-get install -y --no-install-recommends curl gpg \
    && curl -fsSL "$key" | gpg --dearmor -o /usr/share/keyrings/amdrocm.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/amdrocm.gpg] $repo stable main" \
        > /etc/apt/sources.list.d/amdrocm.list \
    && apt-get update \
    && pkgs="" \
    && for p in base sysdeps llvm runtime hipify; do \
         pkgs="$pkgs amdrocm-$p$mm=$ROCM_VERSION-*"; \
       done \
    && apt-get install -y --no-install-recommends $pkgs \
    && cd /tmp && apt-get download "amdrocm-runtime-dev$mm=$ROCM_VERSION-*" \
    && dpkg -i --force-depends /tmp/amdrocm-runtime-dev*.deb \
    && rm -rf /tmp/amdrocm-runtime-dev*.deb /var/lib/apt/lists/* \
    && core="/opt/rocm/core-$mm" \
    && for e in bin include lib .info; do \
         [ -e "/opt/rocm/$e" ] || ln -s "$core/$e" "/opt/rocm/$e"; \
       done \
    && for f in lib/libamdhip64.so include/hip/hip_runtime.h bin/hipify-perl \
                lib/libhsa-runtime64.so include/hsa/hsa.h; do \
         test -e "/opt/rocm/$f" || { echo "ROCm $ROCM_VERSION install is missing /opt/rocm/$f" >&2; exit 1; }; \
       done
ENV PATH=/opt/rocm/bin:${PATH}

RUN git clone --depth 1 --branch "$UCX_REF" "$UCX_REPO" /tmp/ucx \
    && cd /tmp/ucx \
    && ./autogen.sh \
    && ./contrib/configure-release-mt \
        --prefix=/opt/ucx \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --without-avx \
        --enable-cma \
        --enable-devel-headers \
        --without-cuda \
        $([ -n "$ROCM_VERSION" ] && echo --with-rocm=/opt/rocm || echo --without-rocm) \
        --without-verbs \
    && make -j"$(nproc)" \
    && make -j"$(nproc)" install-strip \
    && rm -rf /tmp/ucx

# ---------------------------------------------------------------------------
# stage: build — nixl source → test binaries
# ---------------------------------------------------------------------------
FROM deps AS build

ARG ROCM_VERSION=""
WORKDIR /src
COPY . .

# --buildtype=debug is required: ucx_worker_test is conditionally built only
# for non-release builds (see test/unit/plugins/ucx/meson.build).
# PKG_CONFIG_PATH lets meson find the shared-lib gtest we just installed.
RUN PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-} \
    meson setup build \
        --buildtype=debug \
        --prefix=/nixl-tests \
        --libdir=lib \
        -Ducx_path=/opt/ucx \
        -Dbuild_tests=true \
        -Dbuild_examples=true \
        -Denable_plugins=UCX,POSIX \
        -Dbuild_docs=false \
        -Drust=false \
        -Dwith_trace=false \
        ${ROCM_VERSION:+-Drocm_path=/opt/rocm} \
    && meson compile -C build \
    && meson install -C build

# Add what the install tree does not carry, and drop what no test uses.
# deps/ gets every shared library the tests load that is not glibc,
# libstdc++ or ROCm, so the guest needs nothing installed but ROCm.
RUN mkdir -p /nixl-tests/deps /nixl-tests/ucx/bin \
    && cp -a /opt/ucx/lib /nixl-tests/ucx/lib \
    && cp /opt/ucx/bin/ucx_info /nixl-tests/ucx/bin/ \
    && rm -rf /nixl-tests/ucx/lib/pkgconfig /nixl-tests/ucx/lib/cmake \
              /nixl-tests/include /nixl-tests/lib/pkgconfig \
              /nixl-tests/lib/python3*

# ldd exits non-zero for the files that are not ELF; what matters is that
# every library it was asked about resolved.
RUN find /nixl-tests/bin /nixl-tests/lib -type f \
        | LD_LIBRARY_PATH=/nixl-tests/lib:/nixl-tests/lib/plugins:/opt/ucx/lib:/usr/local/lib:/opt/rocm/lib \
          xargs ldd > /tmp/ldd.txt 2>/dev/null || true; \
    if grep 'not found' /tmp/ldd.txt; then exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// { print $3 }' /tmp/ldd.txt | sort -u \
        | grep -Ev '^/(nixl-tests|opt/ucx|opt/rocm)/|/(libc|libm|libdl|librt|libpthread|libgcc_s|libstdc\+\+)\.so' \
        | xargs cp -L -t /nixl-tests/deps \
    && echo /src/build > /nixl-tests/build-dir \
    && echo "$ROCM_VERSION" > /nixl-tests/rocm-version

# ---------------------------------------------------------------------------
# stage: package — final image that only holds /nixl-tests/
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS package

COPY --from=build /nixl-tests /nixl-tests

RUN apt-get update && apt-get install -y --no-install-recommends binutils \
    && find /nixl-tests/bin -type f -executable -exec strip --strip-debug {} + \
    && rm -rf /var/lib/apt/lists/*
