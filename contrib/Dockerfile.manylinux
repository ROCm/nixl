# Two-stage build: wheel_base uses the public PyPA manylinux_2_28 image; the
# CUDA toolkit + cuObject client pkg-config files are copied in from a public
# NGC CUDA *devel* image (el8/ubi8, which matches the AlmaLinux-8 manylinux
# base). All four ARGs must be declared before the FROM lines that use them.
ARG ARCH="x86_64"
# Pinned PyPA manylinux release — fully-qualified image name prefix + tag.
ARG MANYLINUX_IMAGE="quay.io/pypa/manylinux_2_28"
ARG MANYLINUX_IMAGE_TAG="2026.06.06-1"
# CUDA toolkit provider: a public NGC CUDA *devel* image, el8/ubi8 to match
# the AlmaLinux-8 manylinux base. 13.4 matches the CUDA 13 container images;
# 13.2 is the minimum for cuObject support.
ARG BASE_IMAGE="nvcr.io/nvidia/cuda"
ARG BASE_IMAGE_TAG="13.4.2-devel-ubi8"
# When overridden to an Artifactory URL, the wheel stage pulls the pre-built deps
# image instead of building wheel_base locally (CI caching). Default builds wheel_base here.
ARG wheel_base=wheel_base
# The image nixlbench is built in: the wheel stage, or a pre-built wheel image
# (build-container.sh --nixlbench-base-image) so that it is not built again.
ARG nixlbench_base=wheel
# "cuda" (default) or "rocm"; selects the wheel_base_<stack> stage.
ARG GPU_STACK="cuda"

# CUDA donor stage — copies the toolkit and cuObject client pkg-config files
# onto the manylinux base. The cuobjclient*.pc files are staged in a separate
# directory so they survive the copy even if /usr/lib64/pkgconfig has noise.
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG} AS cuda
RUN mkdir -p /opt/nixl-cuda-pkgconfig && \
    (cp -a /usr/lib64/pkgconfig/cuobjclient*.pc /opt/nixl-cuda-pkgconfig/ 2>/dev/null || true)

# Manylinux build base — official PyPA image (public on quay.io; ECR pull-through
# available). AlmaLinux 8 / glibc 2.28 => manylinux_2_28 wheels.
FROM ${MANYLINUX_IMAGE}_${ARCH}:${MANYLINUX_IMAGE_TAG} AS manylinux_base

# Trusts the root CA of a TLS-intercepting proxy, passed as the "proxy_ca" build
# secret (build-container.sh --proxy-ca-cert). A no-op without the secret.
# Secrets are not part of the layer cache key; the checksum argument is.
ARG PROXY_CA_SHA256=""
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -s /run/secrets/proxy_ca ] && ! cmp -s /run/secrets/proxy_ca /etc/pki/ca-trust/source/anchors/proxy-ca.crt; then \
        install -m 0644 /run/secrets/proxy_ca /etc/pki/ca-trust/source/anchors/proxy-ca.crt && \
        update-ca-trust extract && \
        ca_bundle=/etc/pki/tls/certs/ca-bundle.crt && \
        if [ -f "${SSL_CERT_FILE:-}" ]; then { echo; cat /run/secrets/proxy_ca; } >> "$SSL_CERT_FILE"; fi && \
        printf '[global]\ncert = %s\n' "$ca_bundle" > /etc/pip.conf && \
        mkdir -p /etc/uv && printf 'system-certs = true\n' > /etc/uv/uv.toml && \
        git config --system http.sslCAInfo "$ca_bundle" && \
        mkdir -p /usr/local/cargo && printf '[http]\ncainfo = "%s"\n' "$ca_bundle" > /usr/local/cargo/config.toml; \
    fi

FROM manylinux_base AS wheel_base_cuda

# torch wheel index. Decoupled from the toolkit version: PyTorch does not
# publish wheels for every CUDA minor.
ARG TORCH_CUDA_INDEX="cu132"
ENV TORCH_CUDA_INDEX=${TORCH_CUDA_INDEX}

# Bring the CUDA toolkit onto the manylinux base (dynamo wheel_builder pattern).
COPY --from=cuda /usr/local/cuda /usr/local/cuda
# cuobjclient-13.x.pc uses cudaroot=/usr/local/cuda-<version> for its includedir/libdir.
# Create the versioned symlink so those paths resolve in the manylinux environment.
RUN ln -sfn /usr/local/cuda "/usr/local/cuda-$(/usr/local/cuda/bin/nvcc --version | grep -Eo 'release [0-9]+\.[0-9]+' | cut -d' ' -f2)"
# cuObject client pkg-config files (cuobjclient-13.x.pc) — lets meson find and
# link the OBJ plugin against libcuobjclient at build time. The library itself
# is excluded from the final wheel by auditwheel (build-wheel.sh AUDITWHEEL_EXCLUDES).
COPY --from=cuda /opt/nixl-cuda-pkgconfig/ /usr/lib64/pkgconfig/
ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH:-}

# ROCm build base (x86_64 only). ROCm is a build-time dependency here and a host
# prerequisite at runtime; it is never bundled into the wheel.
FROM manylinux_base AS wheel_base_rocm

ARG ARCH="x86_64"
ARG ROCM_VERSION="10.1.0"
# Not configurable: the ROCm rpms install under /opt/rocm/core-<X.Y>.
ENV ROCM_PATH=/opt/rocm

# ROCm 10 and newer are on stable.repo.amd.com; 7.13 and 7.14 are on
# repo.amd.com (packages-multi-arch). 7.14 is the oldest release accepted:
# 7.13 has no amdrocm-hipfile packages, and the releases before it are
# published elsewhere.
#
# The component rpms populate /opt/rocm/core-<X.Y> only. The unversioned
# /opt/rocm/{bin,include,lib} that NIXL builds against is linked below instead
# of installing the amdrocm-core metapackages that normally create it, which
# would pull in the whole math and ML stack. amdrocm-runtime-devel (HIP and
# HSA headers) is installed without dependencies: the only one not already there
# is amdrocm-llvm-devel (2 GB, unused). Of amdrocm-llvm only the two libraries
# libamd_comgr links are kept; the ldd check fails the build if that changes.
RUN if [ "$ARCH" != "x86_64" ]; then \
        echo "ERROR: GPU_STACK=rocm supports x86_64 only (ROCm publishes no $ARCH packages)" >&2; \
        exit 1; \
    fi && \
    ROCM_MM="$(echo "$ROCM_VERSION" | cut -d. -f1,2)" && \
    case "$ROCM_MM" in \
        7.14) \
            ROCM_REPO_URL="https://repo.amd.com/rocm/packages-multi-arch/rhel8/x86_64/"; \
            ROCM_REPO_GPG="https://repo.amd.com/rocm/packages-multi-arch/gpg/rocm.gpg" ;; \
        [1-9][0-9].*) \
            ROCM_REPO_URL="https://stable.repo.amd.com/rocm/core/packages/rhel8/x86_64/"; \
            ROCM_REPO_GPG="https://stable.repo.amd.com/rocm/gpg/packages.gpg" ;; \
        *) \
            echo "ERROR: ROCm $ROCM_VERSION is not supported: the wheel build needs ROCm 7.14, or 10.0 and newer" >&2; \
            exit 1 ;; \
    esac && \
    printf '[amdrocm]\nname=AMD ROCm %s\nbaseurl=%s\nenabled=1\ngpgcheck=1\ngpgkey=%s\ntimeout=300\nretries=20\n' \
        "$ROCM_VERSION" "$ROCM_REPO_URL" "$ROCM_REPO_GPG" > /etc/yum.repos.d/amdrocm.repo && \
    ROCM_PKGS="" && \
    for pkg in base sysdeps llvm runtime hipfile hipfile-devel hipify; do \
        ROCM_PKGS="$ROCM_PKGS amdrocm-${pkg}${ROCM_MM}-${ROCM_VERSION}"; \
    done && \
    dnf install -y $ROCM_PKGS && \
    dnf download --destdir /tmp/rocm-rpm "amdrocm-runtime-devel${ROCM_MM}-${ROCM_VERSION}" && \
    rpm -K /tmp/rocm-rpm/*.rpm | grep 'signatures OK' && \
    rpm -i --nodeps /tmp/rocm-rpm/*.rpm && \
    rm -r /tmp/rocm-rpm && \
    dnf clean all && \
    ROCM_CORE="$ROCM_PATH/core-${ROCM_MM}" && \
    find "$ROCM_CORE/lib/llvm" -mindepth 1 \( -type f -o -type l \) \
        ! -name 'libLLVM.so*' ! -name 'libLLVM-*.so' ! -name 'libclang-cpp.so*' -delete && \
    rm -f "$ROCM_CORE/bin/hipify-clang" && \
    # No package installed here creates /opt/rocm/{bin,include,lib}: they are
    # update-alternatives links made by the amdrocm-core metapackages. .info is
    # linked too, so that the ROCm version can be read from $ROCM_PATH.
    for entry in bin include lib .info; do \
        [ -e "$ROCM_PATH/$entry" ] || ln -s "$ROCM_CORE/$entry" "$ROCM_PATH/$entry"; \
    done && \
    for f in lib/libamdhip64.so include/hip/hip_runtime.h bin/hipify-perl \
             lib/libhsa-runtime64.so include/hsa/hsa.h \
             lib/libhipfile.so include/hipfile.h .info/version; do \
        test -e "$ROCM_PATH/$f" || { echo "ERROR: ROCm $ROCM_VERSION install is missing $ROCM_PATH/$f" >&2; exit 1; }; \
    done && \
    if ldd "$ROCM_PATH/lib/libamdhip64.so" "$ROCM_PATH/lib/libhipfile.so" | grep 'not found'; then \
        echo "ERROR: the ROCm $ROCM_VERSION runtime has unresolved libraries" >&2; \
        exit 1; \
    fi

ENV PATH=${ROCM_PATH}/bin:${PATH} \
    LD_LIBRARY_PATH=${ROCM_PATH}/lib:${LD_LIBRARY_PATH:-}

FROM wheel_base_${GPU_STACK} AS wheel_base

# Re-declare args needed inside this stage (pre-FROM args are only visible to FROM lines).
ARG ARCH="x86_64"
ARG DEFAULT_PYTHON_VERSION="3.14"
ARG GPU_STACK

# CUDA needs gcc <= 14. The PyPA manylinux base + system "Development Tools" can
# pull in a gcc that CUDA rejects, so pin gcc-toolset-14 on PATH ahead of the
# system gcc (gcc-toolset-14 is added to the dnf install list below).
ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-14/root/usr/lib64:${LD_LIBRARY_PATH:-}

# PyPA manylinux_2_28 ships CMake 4.x, which removed support for
# cmake_minimum_required(VERSION < 3.5). Some bundled deps (e.g. gRPC's c-ares)
# still declare ancient minimums. This tells CMake 4.x to accept them.
ENV CMAKE_POLICY_VERSION_MINIMUM=3.5

# Force CMake to always copy files in install directives, rather than skip based on file modification timestamp.
# File modification timestamp check in CMake uses 1 second resolution.
# This causes problems for fast builds that install, patch then reinstall the same file, as the final install step
# may be incorrectly skipped.
# Seen in CI as flaky ASAN failure due to inconsistent Azure SDK headers causing memory corruption.
# Inherited by the wheel stage below via FROM $wheel_base.
ENV CMAKE_INSTALL_ALWAYS=1

# === end Option B header ======================================================
ARG LIBFABRIC_VERSION="v1.21.0"
ARG HWLOC_VERSION="2.12.2"
ARG BUILD_TYPE="release"
ARG ABSL_TAG="20260526.0"
ARG GRPC_TAG="v1.85.0"
ARG HIREDIS_VERSION="1.4.0"
ARG WGET_RETRY_OPTS="--tries=10 --waitretry=15 --retry-connrefused --retry-on-http-error=429,500,502,503,504 --no-http-keep-alive --timeout=30 --read-timeout=60"
ARG NPROC

RUN yum groupinstall -y 'Development Tools' &&  \
    dnf install -y almalinux-release-synergy epel-release && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y \
    boost \
    boost-devel \
    clang-devel \
    cmake \
    distribution-gpg-keys-copr \
    dkms \
    flex \
    gflags \
    glibc-headers \
    gcc-c++ \
    gcc-toolset-14 \
    libaio \
    libaio-devel \
    libtool-ltdl \
    ninja-build \
    openssl \
    openssl-devel \
    protobuf-compiler \
    protobuf-c-devel \
    protobuf-devel \
    libibverbs \
    libibverbs-devel \
    rdma-core \
    rdma-core-devel \
    libibumad \
    libibumad-devel \
    numactl-devel \
    librdmacm-devel \
    pciutils-devel \
    wget \
    zlib && \
    if [ "$GPU_STACK" = "rocm" ]; then dnf clean all; fi

# Build latest hwloc from source to avoid older RHEL8 API limitations.
RUN cd /tmp && \
    HWLOC_SERIES="$(echo ${HWLOC_VERSION} | cut -d. -f1,2)" && \
    wget -q ${WGET_RETRY_OPTS} "https://download.open-mpi.org/release/hwloc/v${HWLOC_SERIES}/hwloc-${HWLOC_VERSION}.tar.gz" && \
    tar -xzf "hwloc-${HWLOC_VERSION}.tar.gz" && \
    cd "hwloc-${HWLOC_VERSION}" && \
    ./configure --prefix=/usr/local --disable-nvml && \
    make -j"${NPROC:-$(nproc)}" && \
    make install && \
    ldconfig && \
    rm -rf "/tmp/hwloc-${HWLOC_VERSION}" "/tmp/hwloc-${HWLOC_VERSION}.tar.gz"

# Build OpenSSL
ARG OPENSSL_VERSION="3.0.16"
ARG OPENSSL_SHA256="57e03c50feab5d31b152af2b764f10379aecd8ee92f16c985983ce4a99f7ef86"
RUN yum install -y perl-IPC-Cmd perl-Test-Simple perl-Data-Dumper perl-Time-Piece && \
    if [ "$GPU_STACK" = "rocm" ]; then dnf clean all; fi
RUN cd /tmp && \
    wget -q ${WGET_RETRY_OPTS} "https://www.openssl.org/source/openssl-${OPENSSL_VERSION}.tar.gz" && \
    echo "${OPENSSL_SHA256}  openssl-${OPENSSL_VERSION}.tar.gz" | sha256sum -c - && \
    tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz" && \
    cd "openssl-${OPENSSL_VERSION}" && \
    ./Configure --prefix=/usr/local/openssl --openssldir=/usr/local/openssl \
        shared zlib linux-$ARCH && \
    make -j${NPROC:-$(nproc)} && \
    make install_sw && \
    echo "/usr/local/openssl/lib64" > /etc/ld.so.conf.d/nixl-openssl.conf && \
    echo "/usr/local/openssl/lib" >> /etc/ld.so.conf.d/nixl-openssl.conf && \
    ldconfig && \
    rm -rf "/tmp/openssl-${OPENSSL_VERSION}" "/tmp/openssl-${OPENSSL_VERSION}.tar.gz"

ENV PKG_CONFIG_PATH="/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"

# Set environment variables to use the new OpenSSL
ENV PKG_CONFIG_PATH="/usr/local/openssl/lib64/pkgconfig:/usr/local/openssl/lib/pkgconfig:$PKG_CONFIG_PATH"
ENV LD_LIBRARY_PATH="/usr/local/openssl/lib64:/usr/local/openssl/lib:$LD_LIBRARY_PATH"
ENV OPENSSL_ROOT_DIR="/usr/local/openssl"
ENV OPENSSL_LIBRARIES="/usr/local/openssl/lib64:/usr/local/openssl/lib"
ENV OPENSSL_INCLUDE_DIR="/usr/local/openssl/include"

WORKDIR /workspace

# CI supplies a github.com credential as the optional "ghconfig" build secret;
# without it these clones stay anonymous. RUN --mount needs BuildKit or podman.
ARG GIT_TERMINAL_PROMPT=0

RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone --depth 1 --branch release-2.1.13-stable https://github.com/libevent/libevent.git && \
    cmake -S libevent -B libevent/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DEVENT__LIBRARY_TYPE=SHARED -DEVENT__DISABLE_TESTS=ON -DEVENT__DISABLE_SAMPLES=ON && \
    cmake --build libevent/build -j${NPROC:-$(nproc)} && \
    cmake --install libevent/build && ldconfig

# Build hiredis from source: EPEL8's hiredis-devel is 0.13, which is affected by
# CVE-2021-32765 (fixed in 1.0.1). The libevent adapter is header-only, so only
# the core library is built.
RUN cd /tmp && \
    wget -q ${WGET_RETRY_OPTS} "https://github.com/redis/hiredis/archive/refs/tags/v${HIREDIS_VERSION}.tar.gz" \
        -O "hiredis-${HIREDIS_VERSION}.tar.gz" && \
    tar -xzf "hiredis-${HIREDIS_VERSION}.tar.gz" && \
    cd "hiredis-${HIREDIS_VERSION}" && \
    make -j"${NPROC:-$(nproc)}" PREFIX=/usr/local && \
    make install PREFIX=/usr/local && \
    ldconfig && \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig pkg-config --atleast-version=1.0.1 hiredis && \
    rm -rf "/tmp/hiredis-${HIREDIS_VERSION}" "/tmp/hiredis-${HIREDIS_VERSION}.tar.gz"

# Build Abseil from source (required for absl/log).
# The ROCm build removes each source tree in the RUN that built it, to keep the
# layer small. These rm take no -f on purpose: if a path has moved (WORKDIR,
# clone directory, version) the build must fail, not silently keep the tree.
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone https://github.com/abseil/abseil-cpp.git && \
    cd abseil-cpp && \
    git fetch --depth 1 origin ${ABSL_TAG} && \
    git checkout ${ABSL_TAG} && \
    mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_STANDARD=20 \
        -DBUILD_SHARED_LIBS=ON \
        -DABSL_PROPAGATE_CXX_STD=ON \
        -DABSL_ENABLE_INSTALL=ON && \
    make -j${NPROC:-$(nproc)} && \
    make install && \
    ldconfig && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/abseil-cpp; fi

ARG GRPC_NPROC
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone --recurse-submodules -b ${GRPC_TAG} --depth 1 --shallow-submodules https://github.com/grpc/grpc && \
    cd grpc && \
    mkdir -p cmake/build && \
    cd cmake/build && \
    export CMAKE_PREFIX_PATH="/usr/local${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}" && \
    export PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:/usr/local/lib/${ARCH}-linux-gnu/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" && \
    cmake -DgRPC_INSTALL=ON \
    -DgRPC_BUILD_TESTS=OFF \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_CXX_STANDARD=20 \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DCMAKE_PREFIX_PATH=/usr/local \
    -Dabsl_DIR=/usr/local/lib/cmake/absl \
    -DgRPC_SSL_PROVIDER=package \
    -DgRPC_ABSL_PROVIDER=package \
    -DgRPC_PROTOBUF_PROVIDER=module \
    -DgRPC_ZLIB_PROVIDER=package ../.. && \
    make -j${GRPC_NPROC:-$(nproc)} && \
    make install && \
    ldconfig && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/grpc; fi

ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:$LD_LIBRARY_PATH

RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig cd /workspace && \
    git clone --depth 1 https://github.com/etcd-cpp-apiv3/etcd-cpp-apiv3.git && \
    cd etcd-cpp-apiv3 && \
    sed -i '/^find_dependency(cpprestsdk)$/d' etcd-cpp-api-config.in.cmake && \
    mkdir build && cd build && \
    cmake .. -DBUILD_ETCD_CORE_ONLY=ON -DCMAKE_BUILD_TYPE=Release -DETCD_CMAKE_CXX_STANDARD=20 -DCMAKE_CXX_STANDARD=20 && \
    make -j${NPROC:-$(nproc)} && make install

# Build curl against the selected OpenSSL for aws-sdk-cpp.
RUN wget ${WGET_RETRY_OPTS} https://curl.se/download/curl-8.19.0.tar.gz && \
    tar xzf curl-8.19.0.tar.gz && cd curl-8.19.0 && \
    ./configure --prefix=/usr/local --with-ssl=/usr/local/openssl --without-libpsl --enable-shared && \
    make -j${NPROC:-$(nproc)} && make install && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/curl-8.19.0 /workspace/curl-8.19.0.tar.gz; fi

# The ROCm build clones in the RUN that builds, so that the layer can drop the 2 GB tree.
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig if [ "$GPU_STACK" != "rocm" ]; then \
    git clone --recurse-submodules --depth 1 --shallow-submodules https://github.com/aws/aws-sdk-cpp.git --branch 1.11.920; \
    fi
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig if [ "$GPU_STACK" = "rocm" ]; then \
    git clone --recurse-submodules --depth 1 --shallow-submodules https://github.com/aws/aws-sdk-cpp.git --branch 1.11.920; \
    fi && \
    mkdir aws_sdk_build && cd aws_sdk_build && \
    export LDFLAGS="-L/usr/local/openssl/lib64 -L/usr/local/openssl/lib" && \
    export CFLAGS="-I/usr/local/openssl/include" && \
    export CXXFLAGS="-I/usr/local/openssl/include" && \
    cmake ../aws-sdk-cpp/ -DCMAKE_BUILD_TYPE=Release -DBUILD_ONLY="s3;s3-crt" -DENABLE_TESTING=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_CXX_STANDARD=20 \
        -DCMAKE_PREFIX_PATH="/usr/local/openssl;/usr/local" \
        -DCURL_LIBRARY=/usr/local/lib/libcurl.so \
        -DCURL_INCLUDE_DIR=/usr/local/include \
        -DOPENSSL_USE_STATIC_LIBS=OFF && \
    make -j${NPROC:-$(nproc)} && make install && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/aws-sdk-cpp /workspace/aws_sdk_build; fi

ENV PKG_CONFIG_PATH=$PKG_CONFIG_PATH:/usr/local/lib64/pkgconfig:/usr/lib64/pkgconfig:/usr/lib/pkgconfig

RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone https://github.com/nvidia/gusli.git && \
     cd gusli && \
     sed -i '/^LFLAGS_ALL =/{/-lrt/ b; s/$/ -lrt/}' Makefile && \
     make all BUILD_RELEASE=1 BUILD_FOR_UNITEST=0 VERBOSE=1 ALLOW_USE_URING=1 CXX="g++ -std=c++20" && \
     cd ..

# Required for Azure SDK
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone --depth 1 https://github.com/GNOME/libxml2.git --branch 2.15 && \
    cd libxml2 && \
    ACLOCAL_PATH=/usr/share/aclocal ./autogen.sh && make -j${NPROC:-$(nproc)} && \
    make install && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/libxml2; fi

# Fetch the upstream fix with its parent so git show can produce the patch.
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig git clone --depth 1 https://github.com/Azure/azure-sdk-for-cpp.git --branch azure-storage-blobs_12.15.0 && \
    cd azure-sdk-for-cpp/ && \
    git fetch --depth 2 origin 7ebdd503aa8da2987f42715a37a031d4d88947db && \
    git show 7ebdd503aa8da2987f42715a37a031d4d88947db -- sdk/core/azure-core/src/http/curl/curl.cpp | git apply && \
    mkdir build && cd build && \
    export LDFLAGS="-L/usr/local/openssl/lib64 -L/usr/local/openssl/lib" && \
    export CFLAGS="-isystem /usr/local/openssl/include" && \
    export CXXFLAGS="-isystem /usr/local/openssl/include" && \
    AZURE_SDK_DISABLE_AUTO_VCPKG=1 cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local -DDISABLE_AMQP=ON -DDISABLE_AZURE_CORE_OPENTELEMETRY=ON \
        -DCMAKE_CXX_STANDARD=20 \
        -DCMAKE_PREFIX_PATH="/usr/local/openssl;/usr/local" \
        -DCURL_LIBRARY=/usr/local/lib/libcurl.so \
        -DCURL_INCLUDE_DIR=/usr/local/include \
        -DOPENSSL_USE_STATIC_LIBS=OFF && \
    cmake --build . --target azure-storage-blobs azure-identity && \
    cmake --install sdk/core && \
    cmake --install sdk/storage/azure-storage-common && \
    cmake --install sdk/storage/azure-storage-blobs && \
    cmake --install sdk/identity && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/azure-sdk-for-cpp; fi

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUST_VERSION=1.95.0 \
    RUSTARCH=${ARCH}-unknown-linux-gnu

# The wheel build does not use Rust; the ROCm build skips the toolchain.
RUN if [ "$GPU_STACK" != "rocm" ]; then \
    wget ${WGET_RETRY_OPTS} "https://static.rust-lang.org/rustup/archive/1.28.1/${RUSTARCH}/rustup-init" && \
    chmod +x rustup-init && \
    ./rustup-init -y --no-modify-path --profile minimal --default-toolchain $RUST_VERSION --default-host ${RUSTARCH} && \
    case "$ARCH" in \
        aarch64) RUSTUP_SHA256="c64b33db2c6b9385817ec0e49a84bcfe018ed6e328fe755c3c809580cc70ce7a" ;; \
        x86_64) RUSTUP_SHA256="a3339fb004c3d0bb9862ba0bce001861fe5cbde9c10d16591eb3f39ee6cd3e7f" ;; \
        *) echo "Unsupported architecture for Rust: $ARCH" && exit 1 ;; \
    esac && \
    echo "$RUSTUP_SHA256 *rustup-init" | sha256sum -c - && \
    rm rustup-init && \
    chmod -R a+w $RUSTUP_HOME $CARGO_HOME; \
    fi

RUN wget ${WGET_RETRY_OPTS} https://www.mellanox.com/downloads/DOCA/DOCA_v3.5.0/host/doca-host-3.5.0-082000_26.07_rhel8.${ARCH}.rpm -O doca-host.rpm && \
    rpm -i doca-host.rpm && \
    dnf install -y libnl3-devel && \
    cd /usr/share/doca-host-3.5.0/repo/Packages/ && \
    rpm -ivh --nodeps doca-sdk-common-*rpm && \
    rpm -ivh --nodeps doca-sdk-rdma-*rpm && \
    rpm -ivh --nodeps doca-sdk-verbs-*rpm && \
    if [ "$GPU_STACK" != "rocm" ]; then rpm -ivh --nodeps doca-sdk-gpunetio-*rpm; fi && \
    rpm -ivh --nodeps doca-sdk-telemetry-exporter-*rpm && \
    # CollectX provides libclx-api.pc, required (Requires.private) by
    # doca-telemetry-exporter.pc and needed to link the telemetry exporter plugin.
    # Pulls both collectx-clxapi and collectx-clxapidev.
    rpm -ivh --nodeps collectx-clxapi*rpm && \
    # Check that gpunetio and telemetry-exporter development packages are installed correctly
    # The ROCm build drops the 900 MB bundle and its unpacked package repository.
    if [ "$GPU_STACK" = "rocm" ]; then \
        rm /workspace/doca-host.rpm && rpm -e doca-host && dnf clean all; \
    else \
        pkg-config --cflags --libs doca-gpunetio; \
    fi && \
    pkg-config --cflags --libs doca-telemetry-exporter

ENV LD_LIBRARY_PATH=/usr/lib:/usr/local/lib:$LD_LIBRARY_PATH

ENV CUDA_PATH=/usr/local/cuda

WORKDIR /workspace

RUN rm -rf /usr/lib/ucx
RUN rm -rf /opt/hpcx/ucx

# gdrcopy is NVIDIA-only; it has no ROCm counterpart.
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig if [ "$GPU_STACK" != "rocm" ]; then \
    cd /workspace && \
    git clone --depth 1 https://github.com/NVIDIA/gdrcopy.git && \
    cd gdrcopy && \
    git fetch --tags --depth=1 && \
    latest_tag=$(git describe --tags "$(git rev-list --tags --max-count=1)") && \
    git checkout "$latest_tag" && \
    cd packages && \
    CUDA=/usr/local/cuda ./build-rpm-packages.sh && \
    rpm -Uvh gdrcopy-kmod-*.el8.noarch.rpm && \
    rpm -Uvh gdrcopy-*.el8.$ARCH.rpm && \
    rpm -Uvh gdrcopy-devel-*.el8.noarch.rpm; \
    fi

# Build libfabric from source
RUN wget ${WGET_RETRY_OPTS} \
    "https://github.com/ofiwg/libfabric/releases/download/${LIBFABRIC_VERSION}/libfabric-${LIBFABRIC_VERSION#v}.tar.bz2" -O libfabric.tar.bz2 && \
    tar xjf libfabric.tar.bz2 && rm libfabric.tar.bz2 && \
    cd libfabric-* && \
    if [ "$GPU_STACK" = "rocm" ]; then \
        LIBFABRIC_GPU_PARAMS="--with-rocr=$ROCM_PATH --enable-rocr-dlopen"; \
    else \
        LIBFABRIC_GPU_PARAMS="--with-cuda=/usr/local/cuda --enable-cuda-dlopen --with-gdrcopy --enable-gdrcopy-dlopen"; \
    fi && \
    ./autogen.sh && \
    ./configure --prefix=/usr/local \
                --disable-verbs \
                --disable-psm3 \
                --disable-opx \
                --disable-usnic \
                --disable-rstream \
                --enable-efa \
                $LIBFABRIC_GPU_PARAMS && \
    make -j${NPROC:-$(nproc)} && \
    make install && \
    ldconfig && \
    if [ "$GPU_STACK" = "rocm" ]; then rm -r /workspace/libfabric-*; fi

# By default, uv downloads python packages to $HOME/.cache/uv and hard links them
# from the virtual environment. This means that the files reside in /root/.cache/uv,
# which is not what we want since some systems mount user home dir into /root,
# in which case the venv is broken when the container is started.
# Set a custom cache directory inside /workspace to avoid this.
ENV UV_CACHE_DIR=/workspace/.cache/uv
RUN mkdir -p $UV_CACHE_DIR
# Create a new virtual environment
ENV VIRTUAL_ENV=/workspace/.venv
RUN rm -rf $VIRTUAL_ENV && uv venv $VIRTUAL_ENV --python $DEFAULT_PYTHON_VERSION
# Activate the virtual environment
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
# Install python dependencies
RUN uv pip install --upgrade meson meson-python pybind11 patchelf pyYAML click setuptools tabulate auditwheel tomlkit
# Install the default PyTorch used by the outer NIXL build. Per-version NIXL EP
# extensions are built later in isolated environments by build-wheel.sh.
# NIXL EP needs torch >= 2.14. A ROCm build installs no torch: it is a build
# dependency of NIXL EP only, which is CUDA-only.
ARG DEFAULT_TORCH_VERSION="2.14"
RUN if [ "$GPU_STACK" != "rocm" ]; then \
    export UV_INDEX="https://download.pytorch.org/whl/${TORCH_CUDA_INDEX}" && \
    uv pip install "torch==${DEFAULT_TORCH_VERSION}.*"; \
    fi
# Upgrade setuptools to latest version for compatibility with PEP 639 (license format)
RUN uv pip install --upgrade 'setuptools>=80.9.0'

ARG UCX_REPO="https://github.com/openucx/ucx.git"
ARG UCX_REF="v1.24.x"
ARG UCX_SONAME_SUFFIX=""
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig cd /usr/local/src && \
     git clone "$UCX_REPO" ucx && \
     cd ucx &&                       \
     git checkout "${UCX_REF}" &&    \
     git log -1 &&                   \
     ./autogen.sh &&                 \
     if [ -n "$UCX_SONAME_SUFFIX" ]; then \
         if ./configure --help | grep -q -- "--with-soname-suffix"; then \
             UCX_SONAME_PARAM="--with-soname-suffix=$UCX_SONAME_SUFFIX"; \
         else \
             echo "UCX_REF=$UCX_REF does not support --with-soname-suffix" >&2; \
             exit 1; \
         fi; \
         if ./configure --help | grep -q -- "--enable-module-deepbind"; then \
             UCX_MODULE_DEEPBIND_PARAM="--enable-module-deepbind"; \
         else \
             echo "UCX_REF=$UCX_REF does not support --enable-module-deepbind" >&2; \
             exit 1; \
         fi; \
     else \
         UCX_SONAME_PARAM=""; \
         UCX_MODULE_DEEPBIND_PARAM=""; \
     fi && \
     if [ "$GPU_STACK" = "rocm" ]; then \
         UCX_GPU_PARAM="--with-rocm=$ROCM_PATH"; \
     else \
         UCX_GPU_PARAM="--with-cuda=/usr/local/cuda"; \
     fi && \
     ./contrib/configure-release-mt  \
         --enable-shared             \
         --disable-static            \
         --disable-doxygen-doc       \
         --enable-experimental-api   \
         --enable-optimizations      \
         --without-avx               \
         --enable-cma                \
         --enable-devel-headers      \
         $UCX_GPU_PARAM              \
         --with-verbs                \
         --with-dm                   \
         --without-gdrcopy           \
         --with-efa                  \
         --without-dc                \
         --without-rdmacm            \
         --without-gga               \
         $UCX_SONAME_PARAM           \
         $UCX_MODULE_DEEPBIND_PARAM && \
     make -j &&                      \
     make -j install-strip &&        \
     ldconfig &&                     \
     if [ "$GPU_STACK" = "rocm" ]; then \
         if ! ls /usr/lib64/ucx/*rocm*.so* >/dev/null 2>&1; then \
             echo "ERROR: UCX was built without its ROCm module (no *rocm* under /usr/lib64/ucx)" >&2; \
             exit 1; \
         fi && \
         rm -r /usr/local/src/ucx; \
     fi

FROM $wheel_base AS wheel

ARG GPU_STACK
ARG ARCH="x86_64"
ARG BUILD_TYPE="release"
ARG BUILD_NIXL_EP="true"
ARG UCX_SONAME_SUFFIX=""
ARG NPROC=1
ARG UCX_SPCX_PLUGIN_VERSION=""
ARG INFINIA_PLUGIN_VERSION=""

COPY . /workspace/nixl
WORKDIR /workspace/nixl

RUN { \
        echo ""; \
        echo "## Build info"; \
        echo ""; \
        echo '```text'; \
        { \
            echo "NIXL commit: $(git rev-parse HEAD 2>/dev/null || echo unavailable)"; \
            if command -v ucx_info >/dev/null 2>&1; then \
                echo "UCX (ucx_info -v):"; \
                ucx_info -v; \
            else \
                echo "UCX: ucx_info unavailable"; \
            fi; \
            if [ -n "$UCX_SPCX_PLUGIN_VERSION" ]; then \
                echo "SPCX Plugin: $UCX_SPCX_PLUGIN_VERSION"; \
            fi; \
            if [ -n "$INFINIA_PLUGIN_VERSION" ]; then \
                echo "Infinia Plugin: $INFINIA_PLUGIN_VERSION"; \
            fi; \
        } | fold -s -w 96 | sed -e 's/[[:space:]]*$//'; \
        echo '```'; \
    } >> README.md

# Opt-in: place the pre-staged DDN Infinia libs (from infinia-libs/ in the build
# context, populated by build-container.sh --build-infinia) into /opt/ddn/red so
# meson auto-detects red_client and builds libplugin_INFINIA.so into the wheel.
# libred_client/libred_async are excluded from the final wheel by auditwheel
# (build-wheel.sh AUDITWHEEL_EXCLUDES) — only libplugin_INFINIA.so is bundled;
# the DDN libs are loaded at runtime from the customer's installation.
# No external registry pull here: libs arrive via COPY . /workspace/nixl above.
# libuuid-devel provides uuid/uuid.h, included by the DDN red_client headers;
# it is the only extra build-time system dep the plugin needs (the DDN libs'
# own runtime deps are provided by the customer's install and excluded by auditwheel).
ARG BUILD_INFINIA=false
RUN if [ "$BUILD_INFINIA" = "true" ]; then \
        if [ -z "$(ls -A /workspace/nixl/infinia-libs 2>/dev/null)" ]; then \
            echo "ERROR: BUILD_INFINIA=true but /workspace/nixl/infinia-libs is empty (staging failed?)" >&2; \
            exit 1; \
        fi; \
        dnf install -y libuuid-devel && \
        mkdir -p /opt/ddn/red && \
        cp -a /workspace/nixl/infinia-libs/. /opt/ddn/red/; \
    fi

# Opt-in: install the internal ucx-spcx-plugin into the UCX plugins dir, where
# the wheel bundling (wheel_add_ucx_plugins.py) picks it up like any other UCX
# module.
#
# The module is compiled outside this build - by nixl-ci-compile-ucx-plugin, or
# by hand - and staged into the build context (ucx-spcx-plugin-install/) by
# build-container.sh --ucx-spcx-plugin-install. It links this image's UCX, so it
# must come from a build against the same wheel_base image. Its build-time deps
# (FlexIO SDK, dpacc) are installed there rather than here; libflexio is
# compile-against only, at runtime it comes from the target machine's
# DOCA/FlexIO installation, like libmlx5 from rdma-core.
#
# Only the built module enters the build context: the plugin is closed source,
# and a COPY of its source would persist in this layer even after an rm.
ARG BUILD_UCX_SPCX_PLUGIN=false
RUN if [ "$BUILD_UCX_SPCX_PLUGIN" = "true" ]; then \
        if [ -z "$(ls -A /workspace/nixl/ucx-spcx-plugin-install 2>/dev/null)" ]; then \
            echo "ERROR: BUILD_UCX_SPCX_PLUGIN=true but /workspace/nixl/ucx-spcx-plugin-install is empty (staging failed?)" >&2; \
            exit 1; \
        fi; \
        mkdir -p /usr/lib64/ucx && \
        cp -a /workspace/nixl/ucx-spcx-plugin-install/. /usr/lib64/ucx/ && \
        ldconfig; \
    fi

# meson setup clones the taskflow and prometheus-cpp [wrap-git] subprojects from github.com.
RUN --mount=type=secret,id=ghconfig,target=/root/.gitconfig rm -rf build && \
    mkdir build && \
    if [ "$GPU_STACK" = "rocm" ]; then \
        BUILD_NIXL_EP="false"; \
        GPU_STACK_FLAGS="-Drocm_path=$ROCM_PATH"; \
    else \
        GPU_STACK_FLAGS="-Dcudapath_lib=/usr/local/cuda/lib64 -Dcudapath_inc=/usr/local/cuda/include -Drelease_wheel=true"; \
    fi && \
    if [ "$BUILD_NIXL_EP" = "true" ]; then \
        echo "=== NIXL EP enabled: Building NIXL with NIXL EP support ===" && \
        NIXL_EP_FLAG="-Dbuild_nixl_ep=true -Dbuild_examples=true"; \
    else \
        NIXL_EP_FLAG=""; \
    fi && \
    meson setup build/ --prefix=/usr/local/nixl --buildtype=$BUILD_TYPE $NIXL_EP_FLAG -Ducx_path=/usr/local \
    $GPU_STACK_FLAGS && \
    cd build && \
    ninja -j"${NPROC}" && \
    ninja install

ENV LD_LIBRARY_PATH=/usr/local/nixl/lib64/:$LD_LIBRARY_PATH
ENV LD_LIBRARY_PATH=/usr/local/nixl/lib64/plugins:$LD_LIBRARY_PATH
ENV NIXL_PLUGIN_DIR=/usr/local/nixl/lib64/plugins

RUN echo "/usr/local/nixl/lib/$ARCH-linux-gnu" > /etc/ld.so.conf.d/nixl.conf && \
    echo "/usr/local/nixl/lib/$ARCH-linux-gnu/plugins" >> /etc/ld.so.conf.d/nixl.conf && \
    ldconfig && \
    if [ "$GPU_STACK" != "rocm" ]; then \
        OBJ_PLUGIN="$(find /usr/local/nixl -name libplugin_OBJ.so -print -quit)"; \
        test -n "$OBJ_PLUGIN" || { echo "ERROR: libplugin_OBJ.so not found" >&2; exit 1; }; \
        readelf -d "$OBJ_PLUGIN" | grep 'libcuobjclient'; \
    fi

# Create the wheel
# No need to specifically add path to libcuda.so here, meson finds the stubs and links them
ARG WHL_PYTHON_VERSIONS="3.10,3.11,3.12,3.13,3.14"
# NIXL EP needs torch >= 2.14. build-wheel.sh skips versions the index cannot resolve.
ARG WHL_TORCH_VERSIONS="2.14,2.15,2.16"
ARG WHL_PLATFORM="manylinux_2_28_$ARCH"
RUN IFS=',' read -ra PYTHON_VERSIONS <<< "$WHL_PYTHON_VERSIONS" && \
    if [ "$GPU_STACK" = "rocm" ]; then \
        BUILD_NIXL_EP="false"; \
        GPU_STACK_FLAGS="--rocm-path $ROCM_PATH"; \
    else \
        GPU_STACK_FLAGS=""; \
    fi && \
    if [ "$BUILD_NIXL_EP" = "true" ]; then \
        EP_BUILD_FLAGS="--build-nixl-ep --torch-versions $WHL_TORCH_VERSIONS"; \
    else \
        EP_BUILD_FLAGS=""; \
    fi && \
    rm -rf dist && mkdir -p dist && \
    for PYTHON_VERSION in "${PYTHON_VERSIONS[@]}"; do \
        export PATH=$VIRTUAL_ENV/bin:$PATH && \
        ./contrib/build-wheel.sh \
            --python-version $PYTHON_VERSION \
            --platform $WHL_PLATFORM \
            --ucx-plugins-dir /usr/lib64/ucx \
            --nixl-plugins-dir $NIXL_PLUGIN_DIR \
            --output-dir dist \
            $EP_BUILD_FLAGS $GPU_STACK_FLAGS ; \
    done

# Meta package wheel, pushed to PyPI alongside the backend wheel. A ROCm build
# has none: wheel_merge_rocm.py adds the dispatcher to the nixl-rocm wheel.
RUN if [ "$GPU_STACK" != "rocm" ]; then \
      cp build/src/bindings/python/nixl-meta/nixl*.whl dist/; \
    fi

# Just the wheels, for "--target wheel_dist --output type=local,dest=<dir>"
# (build-container.sh --wheel-output-dir).
FROM scratch AS wheel_dist
COPY --from=wheel /workspace/nixl/dist /

# nixlbench as a wheel of its own that requires the NIXL wheel built above, for
# "--target nixlbench_wheel_dist" (build-container.sh --nixlbench-wheel-output-dir).
# Nothing the NIXL wheels are built from depends on these stages, so a nixlbench
# build failure cannot keep the NIXL wheels from being built: that relies on the
# builder skipping the stages a target does not need, as choosing between
# wheel_base_cuda and wheel_base_rocm already does. They take their files from
# nixlbench_wheel, never from wheel, so a pre-built nixlbench_base does not make
# the wheel stage build again.
FROM ${nixlbench_base} AS nixlbench_wheel

ARG GPU_STACK
ARG ARCH="x86_64"
ARG NPROC=1
ARG WHL_PLATFORM="manylinux_2_28_$ARCH"

WORKDIR /workspace/nixl

# gflags-devel is installed here rather than in wheel_base, whose layers the
# NIXL wheels are built from. nixl-wheels.sha256 lists the NIXL wheels nixlbench
# was linked and tested against, to compare with the ones that are published.
RUN if [ "$GPU_STACK" != "rocm" ]; then \
        echo "ERROR: the nixlbench wheel is only built for ROCm so far (GPU_STACK=$GPU_STACK)" >&2; \
        exit 1; \
    fi && \
    dnf install -y gflags-devel && \
    dnf clean all && \
    ./contrib/build-nixlbench-wheel.sh \
        --nixl-path /usr/local/nixl \
        --nixl-wheel-dir dist \
        --rocm-path "$ROCM_PATH" \
        --platform "$WHL_PLATFORM" \
        --output-dir /wheels/nixlbench && \
    (cd dist && sha256sum -- *.whl) > /wheels/nixlbench/nixl-wheels.sha256

# Installs and runs the nixlbench wheel where neither NIXL nor gflags is
# installed: on the ROCm base stage, which is therefore built (or taken from the
# cache) even with a pre-built nixlbench_base. Like the NIXL wheel it needs
# OpenSSL 3 on the host, which EL8 does not have: the one built for the wheels
# stands in, registered with ldconfig because the test runs nixlbench without
# LD_LIBRARY_PATH.
FROM wheel_base_${GPU_STACK} AS nixlbench_wheel_test

COPY --from=nixlbench_wheel /usr/local/openssl/ /usr/local/openssl/
COPY --from=nixlbench_wheel /etc/ld.so.conf.d/nixl-openssl.conf /etc/ld.so.conf.d/nixl-openssl.conf
COPY --from=nixlbench_wheel /workspace/nixl/dist/ /wheels/nixl/
COPY --from=nixlbench_wheel /wheels/nixlbench/ /wheels/nixlbench/
COPY --from=nixlbench_wheel /workspace/nixl/contrib/test-nixlbench-wheel.sh /usr/local/bin/

RUN ldconfig && \
    test-nixlbench-wheel.sh --nixl-wheel-dir /wheels/nixl --nixlbench-wheel-dir /wheels/nixlbench

# Just the tested nixlbench wheel and nixl-wheels.sha256.
FROM scratch AS nixlbench_wheel_dist
COPY --from=nixlbench_wheel_test /wheels/nixlbench /

# Keeps the wheel image as the default target.
FROM wheel
