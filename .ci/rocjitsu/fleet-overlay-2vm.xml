qemu-tool fleet overlay for .github/workflows/rocm-wheels-rocjitsu-2vm.yml,
layered over fleet-overlay-common.xml, which names the images. It gives the
fleet its shape and nothing else.
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">
  <!-- Both restate rocm-golden.xml: two guests, and the TAP that gives their
       emulated RDMA NICs a shared Ethernet segment. The workflow depends on
       them, so a change to the base file must not take them away. -->
  <vm-count>2</vm-count>
  <ernic-tap>true</ernic-tap>
  <vm-name-prefix>nixl-rocjitsu-2vm</vm-name-prefix>
</fleet>
