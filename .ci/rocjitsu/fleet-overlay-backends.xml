qemu-tool fleet overlay for the vm1-loop and vm1-fabric lanes of
.github/workflows/amd-bench-vm.yml and the ernic-backend job of
amd-bench-probe.yml, layered over fleet-overlay-common.xml, which names the
images. It gives the fleet its shape and nothing else: one guest, no TAP and
no P4. The jobs replace the NIC server's command with a compose override,
which was the only way before the <devices> block of qemu-tool 3 and is
kept until the lanes move to that block.
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">
  <!-- Both are what the compose override depends on, and the jobs check
       them before they write it: with a second guest the other NIC server
       would wait for a mesh manager that no longer exists, and with the TAP
       the server is started through an entrypoint that ignores the replaced
       command. -->
  <vm-count>1</vm-count>
  <ernic-tap>false</ernic-tap>
  <vm-name-prefix>nixl-rocjitsu-backend</vm-name-prefix>
  <!-- The override replaces the server's whole command, P4 flags included, so
       these lanes run without P4 whatever this says. Off here so that the
       generated compose file does not claim otherwise. -->
  <p4-enable>false</p4-enable>
  <!-- Kept so the guest has a local (pcie) NVMe controller beside the fabric
       one: the nvmeof lane must tell the two apart and never write to this
       one. -->
  <vm-nvme>1</vm-nvme>
</fleet>
