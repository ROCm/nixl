qemu-tool fleet overlay for the vm1-local lane of
.github/workflows/amd-bench-vm.yml and the guest-facts job of
amd-bench-probe.yml, layered over fleet-overlay-common.xml, which names the
images. It gives the fleet its shape and nothing else: one guest with two
spare NVMe drives.
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">
  <vm-count>1</vm-count>
  <vm-name-prefix>nixl-bench-local</vm-name-prefix>
  <!-- One guest reached over its forwarded SSH port needs no inter-guest L2
       path. -->
  <ernic-tap>false</ernic-tap>
  <!-- Two spare emulated NVMe drives: the lane makes a file system on the
       first by controller serial and hands the second to nixlbench as a raw
       block device. -->
  <vm-nvme>2</vm-nvme>
</fleet>
