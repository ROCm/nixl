qemu-tool fleet overlay for .github/workflows/rocm-wheels-rocjitsu.yml, layered
over fleet-overlay-common.xml, which names the images. It gives the fleet its
shape and nothing else: one guest with a spare NVMe drive.
-->
<fleet xmlns="http://qemu-tool/fleet/1.0">
  <vm-count>1</vm-count>
  <vm-name-prefix>nixl-rocjitsu</vm-name-prefix>
  <!-- One guest reached over its forwarded SSH port needs no inter-guest L2
       path. -->
  <ernic-tap>false</ernic-tap>
  <!-- The spare emulated NVMe drive the AIS check formats and mounts. -->
  <vm-nvme>1</vm-nvme>
</fleet>
