+BatchWorkerPool::BatchWorkerPool(unsigned num_threads)
+{
+    if (num_threads == 0) {
+        throw std::invalid_argument("Batch worker pool must have at least one thread");
+    }
+
+    threads.reserve(num_threads);
+    for (unsigned i = 0; i < num_threads; i++) {
+        threads.emplace_back(&BatchWorkerPool::worker, this);
+    }
