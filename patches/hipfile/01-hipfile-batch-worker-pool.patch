+unsigned
+BatchWorkerPool::configured_threads()
+{
+    if (const auto configured = Environment::batch_threads(); configured && *configured > 0) {
+        return *configured;
+    }
+
+    // A batch operation blocks in pread/pwrite, so the useful worker count
+    // tracks how many IOs the caller wants in flight rather than the core
+    // count -- but a library cannot see that, nor how many NVMe the caller has
+    // spread its files over.  Measured with fio's libhipfile engine, 8 jobs x
+    // iodepth 16 x 1 MiB over 7 NVMe on one MI300X node (GB/s write / read):
+    //
+    //     threads      8     16     32     64    128
+    //     write     16.5   20.2   26.6   29.3   29.1
+    //     read      14.0   25.3   37.1   47.2   47.8
+    //
+    // The knee is at 64, and past it the extra workers only block, so that is
+    // the default.  Callers who know their device count set
+    // HIPFILE_BATCH_THREADS.
+    //
+    // Not clamped to hardware_concurrency: these threads are blocked in a
+    // syscall, not competing for CPU, so a small core count is not a reason to
+    // keep fewer of them.  The pool is created lazily, so a process that never
+    // issues a batch operation never pays for them.
+    constexpr unsigned DEFAULT_THREADS = 64;
+
+    return DEFAULT_THREADS;
+}
