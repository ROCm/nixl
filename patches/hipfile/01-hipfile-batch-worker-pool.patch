+unsigned
+BatchContext::reap(unsigned max_nr, hipFileIOEvents_t *events)
+{
+    unsigned                            count{0};
+    std::unique_lock<std::shared_mutex> _ulock{context_mutex};
+
+    for (auto it = outstanding_ops.begin(); it != outstanding_ops.end() && count < max_nr;) {
+        const auto &op = *it;
+        if (op->status() == hipFilePending) {
+            ++it;
+            continue;
+        }
+
+        events[count].cookie = op->cookie();
+        events[count].status = op->status();
+        events[count].ret    = static_cast<size_t>(op->result());
+        count++;
+
+        it = outstanding_ops.erase(it);
+    }
+
+    if (count > 0) {
+        std::lock_guard<std::mutex> lock{notify->mutex};
+        notify->completed -= count;
+    }
+
+    return count;
+}
+
+void
+BatchContext::get_status(unsigned min_nr, unsigned *nr, hipFileIOEvents_t *events,
+                         const struct timespec *timeout)
+{
+    if (nr == nullptr) {
+        throw std::invalid_argument("nr must not be null");
+    }
+    const unsigned max_nr = *nr;
+    *nr                   = 0;
+
+    if (max_nr == 0) {
+        return;
+    }
+    if (events == nullptr) {
+        throw std::invalid_argument("events must not be null");
+    }
+
+    // Wait before taking context_mutex, never while holding it: reap() needs
+    // that lock and a worker completing is what ends this wait.
+    if (min_nr > 0) {
+        const unsigned                 want = std::min(min_nr, max_nr);
+        std::unique_lock<std::mutex>   lock{notify->mutex};
+        const auto                     ready = [&] { return notify->completed >= want; };
+
+        if (timeout == nullptr) {
+            notify->cv.wait(lock, ready);
+        }
+        else {
+            const auto duration = std::chrono::seconds{timeout->tv_sec} +
+                                  std::chrono::nanoseconds{timeout->tv_nsec};
+            notify->cv.wait_for(lock, duration, ready);
+        }
+    }
+
+    *nr = reap(max_nr, events);
+}
+
+void
+BatchContext::cancel()
+{
+    std::unique_lock<std::shared_mutex> _ulock{context_mutex};
+
+    for (const auto &op : outstanding_ops) {
+        // Losing the claim means a worker already owns this operation. There is
+        // no way to interrupt a pread/pwrite in progress, so it is left to run
+        // and report its real outcome.
+        if (op->claim()) {
+            op->cancel();
+        }
+    }
