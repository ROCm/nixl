+++ b/src/plugins/rocm_ais/ais_backend.h
@@ -0,0 +1,145 @@
+/* Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ */
+#ifndef __AIS_BACKEND_H
+#define __AIS_BACKEND_H
+
+#include <nixl.h>
+#include <nixl_types.h>
+#include <hip/hip_runtime.h>
+#include <hipfile.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <list>
+#include <vector>
+#include <mutex>
+#include <memory>
+#include <unordered_map>
+#include "ais_utils.h"
+#include "backend/backend_engine.h"
+#include "file/file_path_mode.h"
+
+class nixlAisMetadata : public nixlFilePathMD {
+public:
+    aisFileHandle handle;
+    aisMemBuf buf;
+    nixl_mem_t type;
+
+    nixlAisMetadata() = default;
+
+    nixlAisMetadata(uint64_t devid, const std::string &metaInfo)
+        : nixlFilePathMD(devid, metaInfo),
+          type(FILE_SEG) {}
+};
+
+// hipFileReadAsync/WriteAsync take the size and both offsets by pointer and
+// dereference them when the op reaches the head of the stream, not at
+// submission.  So these fields have to outlive the submit call -- they live in
+// the request handle, and the handle owns the stream until checkXfer reaps it.
+class AisTransferRequestH {
+public:
+    void *addr = nullptr;
+    size_t size = 0;
+    hoff_t file_offset = 0;
+    hoff_t buf_offset = 0;
+    ssize_t bytes_done = 0;
+    hipFileHandle_t fh = nullptr;
+    hipFileOpcode_t op = hipFileBatchRead;
+    int dev_id = -1;
+
+    AisTransferRequestH() = default;
+
+    AisTransferRequestH(void *a, size_t s, hoff_t offset, hipFileHandle_t handle,
+                        hipFileOpcode_t operation, int device_id)
+        : addr(a),
+          size(s),
+          file_offset(offset),
+          fh(handle),
+          op(operation),
+          dev_id(device_id) {}
+};
+
+class nixlAisBackendReqH : public nixlBackendReqH {
+public:
+    std::vector<AisTransferRequestH> request_list;
+    std::vector<aisStream *> streams;
+    bool needs_prep = true;
+};
+
+class nixlAisEngine : public nixlBackendEngine {
+private:
+    std::unique_ptr<aisUtil> ais_utils;
+    std::unordered_map<int, aisFileHandle> ais_file_map;
+    nixl::PathModeDevIdRegistry path_mode_devids_;
+
+    // Streams are per-device (Fastpath::async_io rejects a buffer whose GPU id
+    // differs from the stream's), so the pool is keyed by device rather than
+    // being the single free list cuda_gds keeps for batch handles.
+    mutable std::mutex stream_pool_lock;
+    mutable std::unordered_map<int, std::vector<std::unique_ptr<aisStream>>> stream_store;
+    mutable std::unordered_map<int, std::list<aisStream *>> stream_pool;
+
+    unsigned int stream_pool_size;
+    unsigned int ops_per_stream;
+    unsigned int max_request_size;
+
+    aisStream *getStreamFromPool(int dev_id) const;
+    void returnStreamsToPool(std::vector<aisStream *> &streams) const;
+    nixl_status_t resolveFileHandle(const nixlMetaDesc &d, aisFileHandle &fh) const;
+    nixl_status_t submitRequest(AisTransferRequestH &req, hipStream_t stream) const;
+
+public:
+    nixlAisEngine(const nixlBackendInitParams *init_params);
+    ~nixlAisEngine();
+
+    // The target is the filesystem, so there is nothing to connect to.
+    bool supportsNotif() const override { return false; }
+    bool supportsRemote() const override { return false; }
+    bool supportsLocal() const override { return true; }
+
+    nixl_mem_list_t getSupportedMems() const override {
+        nixl_mem_list_t mems;
+        mems.push_back(DRAM_SEG);
+        mems.push_back(VRAM_SEG);
+        mems.push_back(FILE_SEG);
+        return mems;
+    }
+
+    nixl_status_t connect(const std::string &remote_agent) override { return NIXL_SUCCESS; }
+    nixl_status_t disconnect(const std::string &remote_agent) override { return NIXL_SUCCESS; }
+
+    nixl_status_t loadLocalMD(nixlBackendMD *input, nixlBackendMD *&output) override {
+        output = input;
+        return NIXL_SUCCESS;
+    }
+
+    nixl_status_t unloadMD(nixlBackendMD *input) override { return NIXL_SUCCESS; }
+
+    nixl_status_t registerMem(const nixlBlobDesc &mem, const nixl_mem_t &nixl_mem,
+                              nixlBackendMD *&out) override;
+    nixl_status_t deregisterMem(nixlBackendMD *meta) override;
+
+    nixl_status_t prepXfer(const nixl_xfer_op_t &operation,
+                           const nixl_meta_dlist_t &local,
+                           const nixl_meta_dlist_t &remote,
+                           const std::string &remote_agent,
+                           nixlBackendReqH *&handle,
+                           const nixl_opt_b_args_t *opt_args = nullptr) const override;
+
+    nixl_status_t postXfer(const nixl_xfer_op_t &operation,
+                           const nixl_meta_dlist_t &local,
+                           const nixl_meta_dlist_t &remote,
+                           const std::string &remote_agent,
+                           nixlBackendReqH *&handle,
+                           const nixl_opt_b_args_t *opt_args = nullptr) const override;
+
+    nixl_status_t checkXfer(nixlBackendReqH *handle) const override;
+    nixl_status_t releaseReqH(nixlBackendReqH *handle) const override;
+
+    nixl_status_t queryMem(const nixl_reg_dlist_t &descs,
+                           std::vector<nixl_query_resp_t> &resp) const override;
+};
+
+#endif
