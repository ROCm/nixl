index 0000000..5660cf1
--- /dev/null
+++ b/src/plugins/rocm_ais/ais_backend.cpp
@@ -0,0 +1,420 @@
+/* Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ */
+#include <cassert>
+#include <cstring>
+#include <algorithm>
+#include <memory>
+#include <stdexcept>
+#include <unordered_map>
+#include <hip/hip_runtime.h>
+#include <hipfile.h>
+#include "ais_backend.h"
+#include "ais_utils.h"
+#include "common/backend.h"
+#include "common/nixl_log.h"
+#include "file/file_path_mode.h"
+#include "file/file_utils.h"
+
+namespace {
+/** Streams held per device.  Ops on one stream serialise, so this is the
+ *  backend's concurrency width. */
+constexpr unsigned DEFAULT_STREAM_POOL_SIZE = 16;
+/** Requests chained onto one stream before moving to the next. */
+constexpr unsigned DEFAULT_OPS_PER_STREAM = 128;
+/** Split anything larger, so one huge descriptor still spreads over streams. */
+constexpr unsigned DEFAULT_MAX_REQUEST_SIZE = 16 * 1024 * 1024;
+} // namespace
+
+nixlAisEngine::nixlAisEngine(const nixlBackendInitParams *init_params)
+    : nixlBackendEngine(init_params),
+      ais_utils(std::make_unique<aisUtil>()) {
+    try {
+        nixl_b_params_t *custom_params = init_params->customParams;
+        // Parameter names are cuda_gds's, not descriptions of a batch handle:
+        // nixlbench drives both backends through --gds_batch_pool_size /
+        // --gds_batch_limit, and keeping the keys identical is what lets an AIS
+        // run and a GDS run be configured from the same sweep row.
+        stream_pool_size = nixl::getBackendParamDefaulted(
+            custom_params, "batch_pool_size", DEFAULT_STREAM_POOL_SIZE);
+        ops_per_stream =
+            nixl::getBackendParamDefaulted(custom_params, "batch_limit", DEFAULT_OPS_PER_STREAM);
+        max_request_size = nixl::getBackendParamDefaulted(
+            custom_params, "max_request_size", DEFAULT_MAX_REQUEST_SIZE);
+    }
+    catch (const std::exception &e) {
+        NIXL_ERROR << e.what();
+        this->initErr = true;
+        return;
+    }
+
+    if (stream_pool_size == 0 || ops_per_stream == 0 || max_request_size == 0) {
+        NIXL_ERROR << "AIS: batch_pool_size, batch_limit and max_request_size must be non-zero";
+        this->initErr = true;
+        return;
+    }
+
+    this->initErr = false;
+    if (ais_utils->openAisDriver() != NIXL_SUCCESS) {
+        this->initErr = true;
+        return;
+    }
+
+    // Unlike cuda_gds there is no pool to prime here: a stream is bound to a
+    // device, and no device is known until the first registerMem/prepXfer.
+}
+
+nixlAisEngine::~nixlAisEngine() {
+    {
+        const std::lock_guard<std::mutex> lock(stream_pool_lock);
+        stream_pool.clear();
+        stream_store.clear();
+    }
+    if (ais_utils) {
+        ais_utils->closeAisDriver();
+    }
+}
+
+nixl_status_t
+nixlAisEngine::registerMem(const nixlBlobDesc &mem, const nixl_mem_t &nixl_mem,
+                           nixlBackendMD *&out) {
+    if (nixl_mem == FILE_SEG) {
+        auto resv = path_mode_devids_.reserve(mem.devId, mem.metaInfo);
+        if (!resv.ok()) {
+            NIXL_ERROR << "AIS path-mode requires a unique devId per file (devId=" << mem.devId
+                       << " already registered)";
+            return NIXL_ERR_INVALID_PARAM;
+        }
+        std::unique_ptr<nixlAisMetadata> md;
+        try {
+            md = std::make_unique<nixlAisMetadata>(mem.devId, mem.metaInfo);
+        }
+        catch (const std::system_error &e) {
+            NIXL_ERROR << "AIS path-mode open failed: " << e.what();
+            return NIXL_ERR_BACKEND;
+        }
+        const int fd = md->file_fd.fd();
+
+        if (auto it = ais_file_map.find(fd); it != ais_file_map.end()) {
+            md->handle = it->second;
+            md->handle.size = mem.len;
+            md->handle.metadata = mem.metaInfo;
+        } else {
+            const nixl_status_t s =
+                ais_utils->registerFileHandle(fd, mem.len, mem.metaInfo, md->handle);
+            if (s != NIXL_SUCCESS) {
+                return s; // ~FileFd via unique_ptr drop closes the owned fd
+            }
+            ais_file_map[fd] = md->handle;
+        }
+        resv.commit();
+        out = md.release();
+        return NIXL_SUCCESS;
+    }
+
+    auto md = std::make_unique<nixlAisMetadata>();
+    md->type = nixl_mem;
+
+    if (nixl_mem == VRAM_SEG) {
+        if (const hipError_t e = hipSetDevice(mem.devId); e != hipSuccess) {
+            NIXL_ERROR << "AIS: hipSetDevice returned " << hipGetErrorString(e)
+                       << " for device ID " << mem.devId;
+            return NIXL_ERR_BACKEND;
+        }
+    } else if (nixl_mem != DRAM_SEG) {
+        return NIXL_ERR_BACKEND;
+    }
+
+    if (const nixl_status_t s = ais_utils->registerBufHandle((void *)mem.addr, mem.len, 0);
+        s != NIXL_SUCCESS) {
+        return s;
+    }
+    md->buf.base = (void *)mem.addr;
+    md->buf.size = mem.len;
+    out = md.release();
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nixlAisEngine::deregisterMem(nixlBackendMD *meta) {
+    std::unique_ptr<nixlAisMetadata> md((nixlAisMetadata *)meta);
+    if (md->type == FILE_SEG) {
+        if (!md->file_fd.path().empty()) {
+            path_mode_devids_.release(md->devId);
+        }
+        ais_utils->deregisterFileHandle(md->handle);
+        ais_file_map.erase(md->handle.fd);
+    } else {
+        ais_utils->deregisterBufHandle(md->buf.base);
+    }
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nixlAisEngine::resolveFileHandle(const nixlMetaDesc &d, aisFileHandle &fh) const {
+    auto *md = static_cast<const nixlAisMetadata *>(d.metadataP);
+    if (!md || md->type != FILE_SEG) {
+        NIXL_ERROR << "AIS: missing FILE_SEG metadata at xfer time";
+        return NIXL_ERR_NOT_FOUND;
+    }
+    fh = md->handle;
+    return NIXL_SUCCESS;
+}
+
+aisStream *
+nixlAisEngine::getStreamFromPool(int dev_id) const {
+    const std::lock_guard<std::mutex> lock(stream_pool_lock);
+
+    auto &free_list = stream_pool[dev_id];
+    if (!free_list.empty()) {
+        aisStream *s = free_list.back();
+        free_list.pop_back();
+        return s;
+    }
+
+    auto &owned = stream_store[dev_id];
+    if (owned.size() >= stream_pool_size) {
+        return nullptr;
+    }
+
+    try {
+        owned.push_back(std::make_unique<aisStream>(dev_id));
+    }
+    catch (const std::exception &e) {
+        NIXL_ERROR << "AIS: " << e.what();
+        return nullptr;
+    }
+    return owned.back().get();
+}
+
+void
+nixlAisEngine::returnStreamsToPool(std::vector<aisStream *> &streams) const {
+    const std::lock_guard<std::mutex> lock(stream_pool_lock);
+    for (aisStream *s : streams) {
+        stream_pool[s->deviceId()].push_back(s);
+    }
+    streams.clear();
+}
+
+nixl_status_t
+nixlAisEngine::prepXfer(const nixl_xfer_op_t &operation,
+                        const nixl_meta_dlist_t &local,
+                        const nixl_meta_dlist_t &remote,
+                        const std::string &remote_agent,
+                        nixlBackendReqH *&handle,
+                        const nixl_opt_b_args_t *opt_args) const {
+    auto ais_handle = std::make_unique<nixlAisBackendReqH>();
+    const size_t buf_cnt = local.descCount();
+    const size_t file_cnt = remote.descCount();
+
+    if ((buf_cnt != file_cnt) || ((operation != NIXL_READ) && (operation != NIXL_WRITE))) {
+        NIXL_ERROR << "AIS: incorrect count or operation selection";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    if ((remote.getType() != FILE_SEG) && (local.getType() != FILE_SEG)) {
+        NIXL_ERROR << "AIS: only supports I/O between memory (DRAM/VRAM) and file type";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    const bool is_local_file = (local.getType() == FILE_SEG);
+
+    for (size_t i = 0; i < buf_cnt; i++) {
+        void *base_addr;
+        size_t total_size;
+        size_t base_offset;
+        int dev_id;
+        aisFileHandle fh;
+
+        if (is_local_file) {
+            base_addr = (void *)remote[i].addr;
+            total_size = remote[i].len;
+            base_offset = (size_t)local[i].addr;
+            dev_id = remote[i].devId;
+            if (resolveFileHandle(local[i], fh) != NIXL_SUCCESS) {
+                return NIXL_ERR_NOT_FOUND;
+            }
+        } else {
+            base_addr = (void *)local[i].addr;
+            total_size = local[i].len;
+            base_offset = (size_t)remote[i].addr;
+            dev_id = local[i].devId;
+            if (resolveFileHandle(remote[i], fh) != NIXL_SUCCESS) {
+                return NIXL_ERR_NOT_FOUND;
+            }
+        }
+
+        if (!base_addr) {
+            return NIXL_ERR_INVALID_PARAM;
+        }
+
+        size_t remaining_size = total_size;
+        size_t current_offset = 0;
+
+        while (remaining_size > 0) {
+            const size_t request_size = std::min(remaining_size, (size_t)max_request_size);
+
+            ais_handle->request_list.emplace_back(
+                (char *)base_addr + current_offset,
+                request_size,
+                (hoff_t)(base_offset + current_offset),
+                fh.hip_fhandle,
+                (operation == NIXL_READ) ? hipFileBatchRead : hipFileBatchWrite,
+                dev_id);
+
+            remaining_size -= request_size;
+            current_offset += request_size;
+        }
+    }
+
+    if (ais_handle->request_list.empty()) {
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    ais_handle->needs_prep = false;
+    handle = ais_handle.release();
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nixlAisEngine::submitRequest(AisTransferRequestH &req, hipStream_t stream) const {
+    req.bytes_done = 0;
+
+    const hipFileError_t err = (req.op == hipFileBatchRead) ?
+        hipFileReadAsync(req.fh, req.addr, &req.size, &req.file_offset, &req.buf_offset,
+                         &req.bytes_done, stream) :
+        hipFileWriteAsync(req.fh, req.addr, &req.size, &req.file_offset, &req.buf_offset,
+                          &req.bytes_done, stream);
+
+    if (err.err != hipFileSuccess) {
+        NIXL_ERROR << "AIS: hipFile" << ((req.op == hipFileBatchRead) ? "Read" : "Write")
+                   << "Async failed: err=" << err.err;
+        return NIXL_ERR_BACKEND;
+    }
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nixlAisEngine::postXfer(const nixl_xfer_op_t &operation,
+                        const nixl_meta_dlist_t &local,
+                        const nixl_meta_dlist_t &remote,
+                        const std::string &remote_agent,
+                        nixlBackendReqH *&handle,
+                        const nixl_opt_b_args_t *opt_args) const {
+    auto *ais_handle = (nixlAisBackendReqH *)handle;
+
+    if (ais_handle->request_list.empty()) {
+        NIXL_ERROR << "AIS: empty request list";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    if (!ais_handle->streams.empty()) {
+        NIXL_ERROR << "AIS: handle already has in-flight work";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    // Acquire one stream per ops_per_stream requests, per device.  A device
+    // whose pool is exhausted keeps reusing the streams already taken -- extra
+    // requests just chain onto them, which costs concurrency but never fails a
+    // transfer the way cuda_gds's "batch pool exhausted" path does.
+    std::unordered_map<int, std::vector<aisStream *>> per_dev;
+    std::unordered_map<int, size_t> issued;
+
+    for (AisTransferRequestH &req : ais_handle->request_list) {
+        auto &streams = per_dev[req.dev_id];
+        const size_t n = issued[req.dev_id]++;
+
+        if (streams.empty() || (n % ops_per_stream == 0)) {
+            if (aisStream *s = getStreamFromPool(req.dev_id)) {
+                streams.push_back(s);
+                ais_handle->streams.push_back(s);
+            } else if (streams.empty()) {
+                NIXL_ERROR << "AIS: no stream available for device " << req.dev_id;
+                returnStreamsToPool(ais_handle->streams);
+                return NIXL_ERR_BACKEND;
+            }
+        }
+
+        aisStream *s = streams[(n / ops_per_stream) % streams.size()];
+        if (const nixl_status_t st = submitRequest(req, s->get()); st != NIXL_SUCCESS) {
+            for (aisStream *used : ais_handle->streams) {
+                (void)hipStreamSynchronize(used->get());
+            }
+            returnStreamsToPool(ais_handle->streams);
+            return st;
+        }
+    }
+
+    return NIXL_IN_PROG;
+}
+
+nixl_status_t
+nixlAisEngine::checkXfer(nixlBackendReqH *handle) const {
+    auto *ais_handle = (nixlAisBackendReqH *)handle;
+
+    if (ais_handle->streams.empty()) {
+        ais_handle->needs_prep = true;
+        return NIXL_SUCCESS;
+    }
+
+    for (aisStream *s : ais_handle->streams) {
+        const hipError_t q = hipStreamQuery(s->get());
+        if (q == hipErrorNotReady) {
+            return NIXL_IN_PROG;
+        }
+        if (q != hipSuccess) {
+            NIXL_ERROR << "AIS: hipStreamQuery failed: " << hipGetErrorString(q);
+            returnStreamsToPool(ais_handle->streams);
+            ais_handle->needs_prep = true;
+            return NIXL_ERR_BACKEND;
+        }
+    }
+
+    // Every op has retired, so its bytes_done is final.  hipFile clamps a
+    // single async op to hipFile::getMaxRwCount() and reports a POSIX errno as
+    // a negative count, neither of which surfaces through the stream: the
+    // per-request byte count is the only completion status there is.
+    nixl_status_t status = NIXL_SUCCESS;
+    for (const AisTransferRequestH &req : ais_handle->request_list) {
+        if (req.bytes_done < 0) {
+            NIXL_ERROR << "AIS: async " << ((req.op == hipFileBatchRead) ? "read" : "write")
+                       << " failed: " << strerror((int)-req.bytes_done)
+                       << " - address=" << req.addr;
+            status = NIXL_ERR_BACKEND;
+        } else if ((size_t)req.bytes_done != req.size) {
+            NIXL_ERROR << "AIS: short " << ((req.op == hipFileBatchRead) ? "read: " : "write: ")
+                       << req.bytes_done << " out of " << req.size
+                       << " bytes - address=" << req.addr;
+            status = NIXL_ERR_BACKEND;
+        }
+    }
+
+    returnStreamsToPool(ais_handle->streams);
+    ais_handle->needs_prep = true;
+    return status;
+}
+
+nixl_status_t
+nixlAisEngine::releaseReqH(nixlBackendReqH *handle) const {
+    std::unique_ptr<nixlAisBackendReqH> ais_handle((nixlAisBackendReqH *)handle);
+
+    // Releasing while ops are still enqueued would let request_list die under
+    // hipFile, which dereferences the size/offset pointers on the stream.
+    for (aisStream *s : ais_handle->streams) {
+        (void)hipStreamSynchronize(s->get());
+    }
+    returnStreamsToPool(ais_handle->streams);
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nixlAisEngine::queryMem(const nixl_reg_dlist_t &descs,
+                        std::vector<nixl_query_resp_t> &resp) const {
+    std::vector<nixl_blob_t> metadata(descs.descCount());
+    for (int i = 0; i < descs.descCount(); ++i) {
+        metadata[i] = descs[i].metaInfo;
+    }
+
+    return nixl::queryFileInfoList(metadata, resp);
+}
