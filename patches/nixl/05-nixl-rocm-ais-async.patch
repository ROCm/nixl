diff --git a/src/plugins/rocm_ais/ais_utils.cpp b/src/plugins/rocm_ais/ais_utils.cpp
new file mode 100644
index 0000000..66e6283
--- /dev/null
+++ b/src/plugins/rocm_ais/ais_utils.cpp
@@ -0,0 +1,136 @@
+/* Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ */
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <strings.h>
+#include "ais_utils.h"
+#include "common/nixl_log.h"
+
+namespace {
+// hipFileBufRegister rejects host memory and can also fail on a GPU whose
+// P2PDMA path is unavailable.  Upstream cuda_gds downgrades that to a warning
+// and silently proceeds in compat mode; AIS_MT made it fatal unless opted out.
+// Keep AIS_MT's behaviour so both ROCm backends report the same thing -- a
+// silent compat-mode fallback produces numbers that look like a regression.
+bool
+aisCompatModeAllowed() {
+    const char *v = std::getenv("HIPFILE_ALLOW_COMPAT_MODE");
+    if (v == nullptr || v[0] == '\0') {
+        return false;
+    }
+    return std::strcmp(v, "1") == 0 || strcasecmp(v, "true") == 0 || strcasecmp(v, "yes") == 0;
+}
+} // namespace
+
+nixl_status_t
+aisUtil::registerFileHandle(int fd, size_t size, std::string metaInfo, aisFileHandle &ais_handle) {
+    hipFileDescr_t descr = {};
+    hipFileHandle_t handle;
+
+    descr.handle.fd = fd;
+    descr.type = hipFileHandleTypeOpaqueFD;
+
+    const hipFileError_t status = hipFileHandleRegister(&handle, &descr);
+    if (status.err != hipFileSuccess) {
+        NIXL_ERROR << "AIS: file register error: err=" << status.err << " fd=" << fd;
+        return NIXL_ERR_BACKEND;
+    }
+
+    ais_handle.hip_fhandle = handle;
+    ais_handle.fd = fd;
+    ais_handle.size = size;
+    ais_handle.metadata = std::move(metaInfo);
+
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+aisUtil::registerBufHandle(void *ptr, size_t size, int flags) {
+    const hipFileError_t status = hipFileBufRegister(ptr, size, flags);
+    if (status.err != hipFileSuccess) {
+        if (aisCompatModeAllowed()) {
+            NIXL_WARN << "AIS: buffer registration failed - compat mode: err=" << status.err;
+            return NIXL_SUCCESS;
+        }
+        NIXL_ERROR << "AIS: hipFileBufRegister failed (err=" << status.err
+                   << "); set HIPFILE_ALLOW_COMPAT_MODE=true to allow fallback";
+        return NIXL_ERR_BACKEND;
+    }
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+aisUtil::openAisDriver() {
+    const hipFileError_t err = hipFileDriverOpen();
+    if (err.err != hipFileSuccess) {
+        NIXL_ERROR << "AIS: error initializing AMD Infinity Storage driver: err=" << err.err;
+        return NIXL_ERR_BACKEND;
+    }
+    return NIXL_SUCCESS;
+}
+
+void
+aisUtil::closeAisDriver() {
+    (void)hipFileDriverClose();
+}
+
+void
+aisUtil::deregisterFileHandle(aisFileHandle &handle) {
+    if (handle.hip_fhandle) {
+        hipFileHandleDeregister(handle.hip_fhandle);
+        handle.hip_fhandle = nullptr;
+    }
+}
+
+nixl_status_t
+aisUtil::deregisterBufHandle(void *ptr) {
+    const hipFileError_t status = hipFileBufDeregister(ptr);
+    if (status.err != hipFileSuccess) {
+        NIXL_ERROR << "AIS: error de-registering buffer: err=" << status.err;
+        return NIXL_ERR_BACKEND;
+    }
+    return NIXL_SUCCESS;
+}
+
+aisStream::aisStream(int device_id) : dev_id_(device_id) {
+    if (dev_id_ >= 0) {
+        const hipError_t dev_err = hipSetDevice(dev_id_);
+        if (dev_err != hipSuccess) {
+            throw std::runtime_error("AIS: hipSetDevice failed: " +
+                                     std::string(hipGetErrorString(dev_err)));
+        }
+    }
+
+    const hipError_t err = hipStreamCreateWithFlags(&stream_, hipStreamNonBlocking);
+    if (err != hipSuccess) {
+        throw std::runtime_error("AIS: hipStreamCreate failed: " +
+                                 std::string(hipGetErrorString(err)));
+    }
+
+    // Flags stay 0: the HIPFILE_STREAM_FIXED_* hints promise that the size and
+    // offset pointers hold their submission-time values, which is exactly what
+    // this backend cannot promise -- a request handle is reusable across
+    // postXfer calls, so prepXfer may rewrite them.
+    const hipFileError_t reg = hipFileStreamRegister(stream_, 0);
+    if (reg.err != hipFileSuccess) {
+        (void)hipStreamDestroy(stream_);
+        stream_ = nullptr;
+        throw std::runtime_error("AIS: hipFileStreamRegister failed: err=" +
+                                 std::to_string(reg.err));
+    }
+    registered_ = true;
+}
+
+aisStream::~aisStream() {
+    if (stream_) {
+        (void)hipStreamSynchronize(stream_);
+        if (registered_) {
+            (void)hipFileStreamDeregister(stream_);
+        }
+        (void)hipStreamDestroy(stream_);
+    }
+}
diff --git a/src/plugins/rocm_ais/ais_utils.h b/src/plugins/rocm_ais/ais_utils.h
new file mode 100644
index 0000000..57e7f5d
--- /dev/null
+++ b/src/plugins/rocm_ais/ais_utils.h
@@ -0,0 +1,65 @@
+/* Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ */
+#ifndef __AIS_UTILS_H
+#define __AIS_UTILS_H
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <string>
+#include <nixl.h>
+#include <hip/hip_runtime.h>
+#include <hipfile.h>
+
+class aisFileHandle {
+    public:
+        int fd = -1;
+        size_t size = 0;
+        std::string metadata;
+        hipFileHandle_t hip_fhandle = nullptr;
+};
+
+class aisMemBuf {
+    public:
+        void *base = nullptr;
+        size_t size = 0;
+};
+
+// A HIP stream registered with hipFile, which is the unit of asynchronous
+// submission for this backend: ops enqueued on one stream complete in order,
+// ops on different streams overlap.  Fastpath::async_io rejects a buffer whose
+// GPU does not match the stream's, so a stream is bound to one device for life.
+class aisStream {
+    public:
+        explicit aisStream(int device_id);
+        ~aisStream();
+
+        aisStream(const aisStream &) = delete;
+        aisStream &operator=(const aisStream &) = delete;
+
+        hipStream_t get() const { return stream_; }
+        int deviceId() const { return dev_id_; }
+
+    private:
+        hipStream_t stream_ = nullptr;
+        int dev_id_ = -1;
+        bool registered_ = false;
+};
+
+class aisUtil {
+    public:
+        aisUtil() {}
+        ~aisUtil() {}
+        nixl_status_t registerFileHandle(int fd, size_t size,
+                                         std::string metaInfo,
+                                         aisFileHandle &handle);
+        nixl_status_t registerBufHandle(void *ptr, size_t size, int flags);
+        void deregisterFileHandle(aisFileHandle &handle);
+        nixl_status_t deregisterBufHandle(void *ptr);
+        nixl_status_t openAisDriver();
+        void closeAisDriver();
+};
+
+#endif
diff --git a/src/plugins/rocm_ais/meson.build b/src/plugins/rocm_ais/meson.build
new file mode 100644
index 0000000..4494d27
--- /dev/null
+++ b/src/plugins/rocm_ais/meson.build
@@ -0,0 +1,95 @@
+# Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+#
+# SPDX-License-Identifier: Apache-2.0
+
+# Same discovery as src/plugins/mt/ais: one rocm_ais_path option feeds both
+# hipFile backends, so AIS and AIS_MT always link the same library and a
+# benchmark comparison between them is a comparison of the plugins only.
+rocm_ais_path_opt = get_option('rocm_ais_path')
+if rocm_ais_path_opt == ''
+    rocm_path = run_command('bash', '-c', 'echo ${ROCM_PATH:-$ROCM_HOME}').stdout().strip()
+    if rocm_path == ''
+        rocm_path = '/opt/rocm'
+    endif
+    hipfile_search_dirs = [rocm_path, '/opt/rocs-ais', '/usr/local']
+    hipfile_lib_found = false
+    cc_local = meson.get_compiler('cpp')
+    foreach search_dir : hipfile_search_dirs
+        hipfile_lib_candidate = search_dir + '/lib'
+        hipfile_inc_candidate = search_dir + '/include'
+        if fs.exists(hipfile_lib_candidate) and fs.exists(hipfile_inc_candidate)
+            hipfile_lib_check = cc_local.find_library('hipfile',
+                dirs: [hipfile_lib_candidate], required: false)
+            if hipfile_lib_check.found()
+                ais_hipfile_inc = hipfile_inc_candidate
+                hipfile_dep = declare_dependency(
+                    link_args: ['-L' + hipfile_lib_candidate, '-lhipfile',
+                                '-Wl,-rpath,' + hipfile_lib_candidate],
+                    include_directories: include_directories(hipfile_inc_candidate))
+                hipfile_lib_found = true
+                message('Found hipFile at: ' + search_dir)
+                break
+            endif
+        endif
+    endforeach
+    if not hipfile_lib_found
+        hipfile_dep = declare_dependency()
+        subdir_done()
+    endif
+else
+    hipfile_lib_path = rocm_ais_path_opt + '/lib'
+    hipfile_inc_path = rocm_ais_path_opt + '/include'
+    ais_hipfile_inc = hipfile_inc_path
+    hipfile_dep = declare_dependency(
+        link_args: ['-L' + hipfile_lib_path, '-lhipfile',
+                    '-Wl,-rpath,' + hipfile_lib_path],
+        include_directories: include_directories(hipfile_inc_path))
+endif
+
+if not hip_dep.found()
+    subdir_done()
+endif
+
+# AIS_MT only needs hipFileRead/Write, which every hipFile has.  This backend
+# needs the stream API, which older ones do not export -- skip rather than fail
+# the whole build, the same way an absent hipFile does above.
+cc_ais = meson.get_compiler('cpp')
+if not cc_ais.has_header_symbol('hipfile.h', 'hipFileReadAsync',
+                                args: ['-I' + ais_hipfile_inc])
+    message('hipFile at ' + ais_hipfile_inc + ' has no async API - skipping the AIS plugin')
+    subdir_done()
+endif
+
+if 'AIS' in static_plugins
+    ais_backend_lib = static_library('AIS',
+        'ais_utils.cpp', 'ais_utils.h',
+        'ais_backend.cpp', 'ais_backend.h',
+        'ais_plugin.cpp',
+        dependencies: [nixl_infra, nixl_common_dep, hip_dep, hipfile_dep,
+                       file_utils_interface],
+        include_directories: [nixl_inc_dirs, utils_inc_dirs],
+        install: false,
+        cpp_args: compile_flags,
+        name_prefix: 'libplugin_')
+else
+    ais_backend_lib = shared_library('AIS',
+        'ais_utils.cpp', 'ais_utils.h',
+        'ais_backend.cpp', 'ais_backend.h',
+        'ais_plugin.cpp',
+        dependencies: [nixl_infra, nixl_common_dep, hip_dep, hipfile_dep,
+                       file_utils_interface],
+        include_directories: [nixl_inc_dirs, utils_inc_dirs],
+        install: true,
+        cpp_args: ['-fPIC'],
+        name_prefix: 'libplugin_',
+        install_dir: plugin_install_dir,
+        install_rpath: '$ORIGIN/..')
+    if get_option('buildtype') == 'debug'
+        run_command('sh', '-c',
+            'echo "AIS=' + ais_backend_lib.full_path() + '" >> ' + plugin_build_dir + '/pluginlist',
+            check: true
+        )
+    endif
+endif
+
+ais_backend_interface = declare_dependency(link_with: ais_backend_lib)
