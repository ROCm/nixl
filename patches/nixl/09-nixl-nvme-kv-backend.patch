new file mode 100644
index 0000000..6271c17
--- /dev/null
+++ b/src/plugins/nvme_kv/nvme_kv_backend.h
@@ -0,0 +1,295 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_BACKEND_H
+#define NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_BACKEND_H
+
+#include <liburing.h>
+#ifdef HAVE_HIP
+#include <hip/hip_runtime_api.h>
+#endif
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+#include "backend/backend_engine.h"
+#include "nvme_kv_cmd.h"
+
+/**
+ * A NIXL backend over the NVMe Key Value command set.
+ *
+ * WHAT IT IS, AND WHAT IT IS MODELLED ON
+ *
+ * NIXL's DOCA_MEMOS plugin (ai-dynamo/nixl#1717) is a KV-cache backend whose
+ * store the host sees as an NVMe KV namespace. It reaches that namespace
+ * through NVIDIA's doca-kv library, needs DOCA 4.4 and a BlueField-3, and so
+ * cannot run here at all.
+ *
+ * But its own README gives the game away: `device_name` is `/dev/nvme0n1` -- a
+ * kernel device. The NVMe KV command set is ratified, Linux attaches a KV
+ * namespace (hiding only the block device: "block device for nsid %u not
+ * supported (csi %u)") and exposes it for passthrough, and the commands are
+ * the same commands whoever issues them. So this plugin keeps the DOCA
+ * plugin's NIXL-facing semantics exactly and replaces the vendor library with
+ * io_uring NVMe passthrough -- which works against any KV namespace, from any
+ * vendor, over any fabric.
+ *
+ * THE NIXL MAPPING, WHICH IS DOCA_MEMOS'S
+ *
+ * One descriptor pair is one value. The local DRAM_SEG buffer is the value;
+ * the remote OBJ_SEG descriptor names the key. NIXL_WRITE is Store, NIXL_READ
+ * is Retrieve, and queryMem() is one Exist per descriptor. The key comes from
+ * the OBJ_SEG descriptor: the devId bytes when metaInfo is empty, otherwise
+ * metaInfo parsed as a hex string of up to 16 bytes, or -- with
+ * `convert_key_to_128bit` -- any string hashed to 128 bits.
+ *
+ * A Retrieve whose stored value length differs from the buffer fails, as it
+ * does in DOCA_MEMOS. The device reports the true length in the completion
+ * even when it did not overrun the buffer, so a short read is detected rather
+ * than silently handing back a partly-stale buffer.
+ *
+ * WHY io_uring AND NOT ioctl
+ *
+ * NVME_IOCTL_IO_CMD is synchronous: every value would block a thread for a
+ * fabric round trip, and NIXL's interface is prepare/post/check precisely so
+ * that it does not have to. IORING_OP_URING_CMD carrying NVME_URING_CMD_IO is
+ * the same command, submitted and reaped asynchronously, so postXfer() returns
+ * NIXL_IN_PROG with everything in flight and checkXfer() reaps whatever has
+ * completed. The ring needs SQE128 and CQE32: a passthrough command does not
+ * fit a 64-byte SQE, and the NVMe completion result does not fit a 16-byte CQE.
+ */
+/// Defined in the .cpp; the engine only ever holds pointers to it.
+class nvmeKvBackendReqH;
+
+class nvmeKvEngine : public nixlBackendEngine {
+public:
+    explicit nvmeKvEngine(const nixlBackendInitParams *init_params);
+    ~nvmeKvEngine() override;
+
+    bool
+    supportsRemote() const override {
+        return false;
+    }
+
+    bool
+    supportsLocal() const override {
+        return true;
+    }
+
+    bool
+    supportsNotif() const override {
+        return false;
+    }
+
+    /**
+     * OBJ_SEG names keys; DRAM_SEG and VRAM_SEG hold values.
+     *
+     * VRAM_SEG IS STAGED THROUGH HOST MEMORY, NOT GPU-DIRECT, and the
+     * distinction matters enough to state here rather than bury.
+     *
+     * NVMe passthrough maps its data buffer with blk_rq_map_user_io() or
+     * io_uring_cmd_import_fixed(), both of which pin USER PAGES. A device
+     * pointer is not backed by any, so there is nothing to pin. Nor is there
+     * a dmabuf or p2pdma path in drivers/nvme/host/ioctl.c to take one
+     * instead -- and over nvme-rdma or nvme-tcp it would not help if there
+     * were, because the host moves the data from those same pages.
+     *
+     * So a VRAM registration gets a pinned host staging buffer, a Store
+     * copies device-to-host before submitting and a Retrieve copies
+     * host-to-device once the device has answered. That is exactly what
+     * hipObject does when a device pointer cannot be registered with the NIC
+     * (hipObjBufSync, HIPOBJ_SYNC_TO_HOST / _TO_DEVICE); DOCA_MEMOS avoids
+     * the question by taking DRAM only. The copy is real and it shows up in
+     * the numbers -- see cluster/README.md -- but a NIXL caller holding a
+     * device pointer no longer has to do the staging itself, which is the
+     * point.
+     */
+    nixl_mem_list_t
+    getSupportedMems() const override {
+#ifdef HAVE_HIP
+        return {OBJ_SEG, DRAM_SEG, VRAM_SEG};
+#else
+        return {OBJ_SEG, DRAM_SEG};
+#endif
+    }
+
+    nixl_status_t
+    registerMem(const nixlBlobDesc &mem, const nixl_mem_t &nixl_mem, nixlBackendMD *&out) override;
+
+    nixl_status_t
+    deregisterMem(nixlBackendMD *meta) override;
+
+    nixl_status_t
+    queryMem(const nixl_reg_dlist_t &descs, std::vector<nixl_query_resp_t> &resp) const override;
+
+    nixl_status_t
+    connect(const std::string &remote_agent) override {
+        return NIXL_SUCCESS;
+    }
+
+    nixl_status_t
+    disconnect(const std::string &remote_agent) override {
+        return NIXL_SUCCESS;
+    }
+
+    nixl_status_t
+    unloadMD(nixlBackendMD *input) override {
+        return NIXL_SUCCESS;
+    }
+
+    nixl_status_t
+    loadLocalMD(nixlBackendMD *input, nixlBackendMD *&output) override {
+        output = input;
+        return NIXL_SUCCESS;
+    }
+
+    nixl_status_t
+    prepXfer(const nixl_xfer_op_t &operation,
+             const nixl_meta_dlist_t &local,
+             const nixl_meta_dlist_t &remote,
+             const std::string &remote_agent,
+             nixlBackendReqH *&handle,
+             const nixl_opt_b_args_t *opt_args = nullptr) const override;
+
+    nixl_status_t
+    postXfer(const nixl_xfer_op_t &operation,
+             const nixl_meta_dlist_t &local,
+             const nixl_meta_dlist_t &remote,
+             const std::string &remote_agent,
+             nixlBackendReqH *&handle,
+             const nixl_opt_b_args_t *opt_args = nullptr) const override;
+
+    nixl_status_t
+    checkXfer(nixlBackendReqH *handle) const override;
+
+    nixl_status_t
+    releaseReqH(nixlBackendReqH *handle) const override;
+
+    /**
+     * Resolve an OBJ_SEG descriptor to a key, by DOCA_MEMOS's rules.
+     *
+     * Public and static so the unit test can exercise the three paths without
+     * a device.
+     *
+     * @param dev_id devId, used as the key when meta_info is empty
+     * @param meta_info metaInfo: hex, or any string when hash_long_keys
+     * @param hash_long_keys The `convert_key_to_128bit` parameter
+     * @param key Out: the key bytes
+     * @param key_len Out: the key length, 1..16
+     * @return false when meta_info is neither valid hex nor hashable
+     */
+    static bool
+    resolveKey(uint64_t dev_id,
+               const std::string &meta_info,
+               bool hash_long_keys,
+               uint8_t (&key)[nvme_kv::MAX_KEY_LEN],
+               uint8_t &key_len);
+
+private:
+    /**
+     * Open the namespace and refuse anything that is not a KV one.
+     *
+     * This check is the plugin's single most important line. Store is opcode
+     * 01h, which is Write in the NVM command set: pointed at an LBA namespace
+     * by a typo in `device_name`, a Store would not fail, it would overwrite
+     * the start of a block device. So the CSI is read from the namespace's
+     * Identify data and anything but KV is refused before a command can be
+     * built.
+     */
+    nixl_status_t
+    openDevice(const std::string &path);
+
+    /// Submit one command and wait for its completion. Used by queryMem(),
+    /// which is synchronous in the NIXL interface.
+    nixl_status_t
+    submitSync(struct nvme_uring_cmd &cmd, uint32_t *result_out) const;
+
+    /**
+     * Drain every completion the ring has and give each to the request that
+     * submitted it.
+     *
+     * One ring serves every request, so a completion has to carry enough to
+     * find its owner. Tagging an SQE with the task's index within its request
+     * is not enough -- every request numbers its tasks from zero, so a
+     * straggler from an earlier transfer is indistinguishable from this one's
+     * first task, and checkXfer() counts it as progress it did not make. The
+     * symptom is a transfer that reports completion before the device has
+     * answered, which looks like extraordinary bandwidth rather than like a
+     * bug.
+     *
+     * So the tag is a token unique for the lifetime of the engine, and
+     * inflight_ maps it back to the request and task it belongs to.
+     *
+     * @param wanted A token to stop after, or 0 to drain without blocking
+     * @param wanted_res Out: cqe->res for @p wanted
+     * @param wanted_result Out: the NVMe result dword for @p wanted
+     * @return true when @p wanted was seen (always false when it is 0)
+     */
+    bool
+    reapCompletions(uint64_t wanted, int *wanted_res, uint32_t *wanted_result) const;
+
+    std::string devicePath_;
+    int deviceFd_ = -1;
+    uint32_t nsid_ = 0;
+    bool hashLongKeys_ = false;
+    uint32_t queueDepth_ = 0;
+    /// Controller maximum transfer, from MDTS. 0 means unlimited.
+    uint32_t maxValueLen_ = 0;
+
+    /// One ring for the engine. io_uring is not thread-safe for concurrent
+    /// submission, and NIXL may call postXfer() and checkXfer() from different
+    /// threads, so every touch of the ring takes this.
+    mutable struct io_uring ring_ = {};
+    bool ringReady_ = false;
+    mutable std::mutex ringLock_;
+
+#ifdef HAVE_HIP
+    /// Carries the staging copies. Created once; the null stream would
+    /// serialise them against all other GPU work on the device.
+    hipStream_t stagingStream_ = nullptr;
+    bool stagingStreamReady_ = false;
+#endif
+
+    /// Monotonic, so no two commands in this engine's lifetime share a tag.
+    mutable uint64_t nextToken_ = 1;
+    /// Token -> the request that submitted it and which of its tasks it is.
+    mutable std::unordered_map<uint64_t, std::pair<nvmeKvBackendReqH *, size_t>> inflight_;
+    /// Tokens whose request was released before the device answered. Their
+    /// completions still arrive and must be dropped rather than followed to a
+    /// freed request handle.
+    mutable std::unordered_set<uint64_t> orphaned_;
+
+    /// Free a VRAM registration's staging buffer. Separate so the error
+    /// paths in registerMem() do not have to repeat the HIP call.
+    static void
+    freeStaging(void *staging);
+
+    /**
+     * Copy every staged descriptor of a request in one direction, then wait
+     * once.
+     *
+     * Two things here are worth more than they look. The copies go on a
+     * stream of this engine's own rather than the null stream, which
+     * synchronises device-wide and makes every copy wait on unrelated GPU
+     * work. And a request's descriptors are all issued before anything is
+     * waited on, so a batch pays one synchronisation rather than one per
+     * value -- which matters because the per-call cost here dominates the
+     * per-byte one by orders of magnitude.
+     *
+     * @param to_device true for host->device (after a Retrieve), false for
+     *                  device->host (before a Store)
+     */
+    nixl_status_t
+    stageTasks(nvmeKvBackendReqH *req, bool to_device) const;
+
+    /// OBJ_SEG devId -> key, filled by registerMem() and read by prepXfer(),
+    /// mirroring the devIdToObjKey_ map the OBJ plugin's engines keep.
+    std::unordered_map<uint64_t, std::string> devIdToMetaInfo_;
+};
+
+#endif // NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_BACKEND_H
diff --git a/src/plugins/nvme_kv/nvme_kv_cmd.h b/src/plugins/nvme_kv/nvme_kv_cmd.h
new file mode 100644
index 0000000..2fccd54
--- /dev/null
+++ b/src/plugins/nvme_kv/nvme_kv_cmd.h
@@ -0,0 +1,126 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_CMD_H
+#define NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_CMD_H
+
+#include <linux/nvme_ioctl.h>
+#include <cstdint>
+#include <cstring>
+
+/**
+ * The NVMe Key Value command set, as it goes on the wire.
+ *
+ * This is the whole vendor-independent core of the plugin. The NVM Express Key
+ * Value Command Set is a ratified specification, Linux attaches a KV namespace
+ * and exposes it for passthrough, and the commands below are therefore the
+ * only thing standing between NIXL and any KV device -- no vendor library in
+ * the path, which is the difference between this and the DOCA_MEMOS plugin it
+ * is modelled on.
+ *
+ * THE OPCODES OVERLAP WITH THE BLOCK COMMAND SET, AND THAT IS DANGEROUS.
+ *
+ * Store is 01h and Retrieve is 02h -- the same values as Write and Read in the
+ * NVM command set. Sent to an LBA namespace by mistake, a Store does not fail:
+ * it executes as a block write and destroys data. The engine therefore refuses
+ * to open a namespace whose CSI is not KV (see nvmeKvEngine::openDevice), and
+ * nothing here is reachable until that check has passed.
+ */
+namespace nvme_kv {
+
+/// Store a value under a key. Host-to-device data.
+inline constexpr uint8_t OPC_STORE = 0x01;
+/// Retrieve a value by key. Device-to-host data.
+inline constexpr uint8_t OPC_RETRIEVE = 0x02;
+/// List keys from a starting key. Device-to-host data.
+inline constexpr uint8_t OPC_LIST = 0x06;
+/// Delete a key. No data.
+inline constexpr uint8_t OPC_DELETE = 0x10;
+/// Test whether a key exists. No data.
+inline constexpr uint8_t OPC_EXIST = 0x14;
+
+/// The specification's maximum key length. A key is 1..16 bytes.
+inline constexpr uint32_t MAX_KEY_LEN = 16;
+
+/// Command Set Identifier for Key Value. The value Linux reports in
+/// "block device for nsid %u not supported (csi %u)" when it attaches one.
+inline constexpr uint8_t CSI_KV = 1;
+
+/// Status code the device returns for a key that is not present. Delivered to
+/// the caller as the low 11 bits of the NVMe status field.
+inline constexpr uint16_t SC_KEY_DOES_NOT_EXIST = 0x87;
+
+/**
+ * Place a key into a command's data words.
+ *
+ * The split is not an invention here -- it is where the specification puts a
+ * key, and where SPDK's nvme_kv_cmd_set_key() reads it from:
+ *
+ *   key[0..7]   -> CDW2, CDW3
+ *   key[8..15]  -> CDW14, CDW15
+ *   CDW11[07:00] = key length
+ *
+ * The bytes go in as they are. A key is an opaque octet string, so no byte
+ * order applies to it; the CDWs are just where those octets are carried.
+ */
+inline void
+setKey(struct nvme_uring_cmd &cmd, const uint8_t *key, uint8_t key_len) {
+    uint8_t lo[8] = {};
+    uint8_t hi[8] = {};
+    const uint8_t n_lo = key_len < 8 ? key_len : 8;
+    memcpy(lo, key, n_lo);
+    if (key_len > 8) {
+        memcpy(hi, key + 8, static_cast<size_t>(key_len) - 8);
+    }
+    memcpy(&cmd.cdw2, lo, 4);
+    memcpy(&cmd.cdw3, lo + 4, 4);
+    memcpy(&cmd.cdw14, hi, 4);
+    memcpy(&cmd.cdw15, hi + 4, 4);
+    // kl in [07:00], request options in [15:08] -- none of the options
+    // (SIKE, SINE, no-compress, TTL) are used here, so the high byte is zero.
+    cmd.cdw11 = key_len;
+}
+
+/**
+ * Build a Store or Retrieve.
+ *
+ * @param value_len For Store the size of the value; for Retrieve the size of
+ *                  the host buffer, which the device will not overrun. A
+ *                  Retrieve whose stored value is longer reports the true
+ *                  length in the completion result, which the caller compares
+ *                  against what it asked for.
+ */
+inline struct nvme_uring_cmd
+makeDataCmd(uint8_t opcode,
+            uint32_t nsid,
+            const uint8_t *key,
+            uint8_t key_len,
+            void *value,
+            uint32_t value_len) {
+    struct nvme_uring_cmd cmd = {};
+    cmd.opcode = opcode;
+    cmd.nsid = nsid;
+    cmd.addr = reinterpret_cast<uint64_t>(value);
+    cmd.data_len = value_len;
+    cmd.cdw10 = value_len;
+    setKey(cmd, key, key_len);
+    return cmd;
+}
+
+/**
+ * Build a Delete or Exist: a key and nothing else.
+ */
+inline struct nvme_uring_cmd
+makeKeyOnlyCmd(uint8_t opcode, uint32_t nsid, const uint8_t *key, uint8_t key_len) {
+    struct nvme_uring_cmd cmd = {};
+    cmd.opcode = opcode;
+    cmd.nsid = nsid;
+    setKey(cmd, key, key_len);
+    return cmd;
+}
+
+} // namespace nvme_kv
+
+#endif // NIXL_SRC_PLUGINS_NVME_KV_NVME_KV_CMD_H
diff --git a/src/plugins/nvme_kv/nvme_kv_plugin.cpp b/src/plugins/nvme_kv/nvme_kv_plugin.cpp
new file mode 100644
index 0000000..752f71a
--- /dev/null
+++ b/src/plugins/nvme_kv/nvme_kv_plugin.cpp
@@ -0,0 +1,43 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "backend/backend_plugin.h"
+#include "nvme_kv_backend.h"
+
+// Kept in step with nvmeKvEngine::getSupportedMems(). VRAM is staged through
+// host memory rather than reached directly; the engine's header says why.
+#ifdef HAVE_HIP
+#define NVME_KV_MEM_TYPES {OBJ_SEG, DRAM_SEG, VRAM_SEG}
+#else
+#define NVME_KV_MEM_TYPES {OBJ_SEG, DRAM_SEG}
+#endif
+
+using nvme_kv_plugin_t = nixlBackendPluginCreator<nvmeKvEngine>;
+
+// device_name has no useful default: there is no conventional path for a KV
+// namespace, and guessing one risks naming an LBA namespace, where a Store
+// would execute as a block Write. Empty, and the engine refuses to start.
+static const nixl_b_params_t nvme_kv_params = {
+    {"device_name", ""},
+    {"convert_key_to_128bit", "false"},
+    {"queue_depth", "256"},
+};
+
+#ifdef STATIC_PLUGIN_NVME_KV
+nixlBackendPlugin *
+createStaticNVME_KVPlugin() {
+    return nvme_kv_plugin_t::create(
+        NIXL_PLUGIN_API_VERSION, "NVME_KV", "0.1.0", nvme_kv_params, NVME_KV_MEM_TYPES);
+}
+#else
+extern "C" NIXL_PLUGIN_EXPORT nixlBackendPlugin *
+nixl_plugin_init() {
+    return nvme_kv_plugin_t::create(
+        NIXL_PLUGIN_API_VERSION, "NVME_KV", "0.1.0", nvme_kv_params, NVME_KV_MEM_TYPES);
+}
+
+extern "C" NIXL_PLUGIN_EXPORT void
+nixl_plugin_fini() {}
+#endif
