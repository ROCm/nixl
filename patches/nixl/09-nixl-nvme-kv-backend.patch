+/*
+ * Seeding for the NVME_KV backend.
+ *
+ * A READ run needs its value to exist before the benchmark retrieves it, and
+ * nixlbench seeds through an external CLI rather than through NIXL -- `aws` for
+ * S3, and `nvme` here. The NVMe Key Value command set has no nvme-cli
+ * subcommand, so these build the raw passthrough: Store is opcode 01h,
+ * Retrieve 02h, Delete 10h, with the key split across CDW2/3 and CDW14/15 and
+ * its length in CDW11, exactly as the plugin does it.
+ *
+ * The object name is 32 hex characters for this backend (see nixl_worker.cpp),
+ * so it IS the 16-byte key and no hashing has to agree between here and the
+ * plugin. With --nvme_kv_convert_key the plugin hashes instead, and seeding
+ * cannot predict the result -- which is why that path refuses rather than
+ * silently seeding the wrong key.
+ */
+static bool
+nvmeKvKeyCdws(const std::string &name, std::string &cdws, uint32_t &key_len) {
+    if (xferBenchConfig::nvme_kv_convert_key) {
+        std::cerr << "Error: --nvme_kv_convert_key hashes the key inside the plugin, so this "
+                     "seeding path cannot compute it. Seed by hand, or drop the flag and use "
+                     "hex keys."
+                  << std::endl;
+        return false;
+    }
+    if (name.size() > 32 || (name.size() & 1) != 0) {
+        std::cerr << "Error: NVME_KV object name '" << name
+                  << "' is not an even-length hex string of at most 32 characters" << std::endl;
+        return false;
+    }
+    uint8_t key[16] = {};
+    key_len = static_cast<uint32_t>(name.size() / 2);
+    for (uint32_t i = 0; i < key_len; i++) {
+        unsigned int byte = 0;
+        if (std::sscanf(name.c_str() + i * 2, "%2x", &byte) != 1) {
+            std::cerr << "Error: NVME_KV object name '" << name << "' is not hex" << std::endl;
+            return false;
+        }
+        key[i] = static_cast<uint8_t>(byte);
+    }
+    uint32_t w[4] = {};
+    std::memcpy(&w[0], key, 4);
+    std::memcpy(&w[1], key + 4, 4);
+    std::memcpy(&w[2], key + 8, 4);
+    std::memcpy(&w[3], key + 12, 4);
+    cdws = " --cdw2=" + std::to_string(w[0]) + " --cdw3=" + std::to_string(w[1]) +
+        " --cdw14=" + std::to_string(w[2]) + " --cdw15=" + std::to_string(w[3]) +
+        " --cdw11=" + std::to_string(key_len);
+    return true;
+}
+
+/*
+ * The namespace id the device node actually refers to.
+ *
+ * NOT a constant. A controller may serve several namespaces and only some of
+ * them Key Value -- the rocm-ernic target does exactly that -- and in that
+ * case the Key Value namespace is routinely not nsid 1. Worse, the node name
+ * does not give it away: Linux names namespace devices by the head instance it
+ * allocated rather than by namespace id, and a hidden Key Value namespace
+ * still consumes one, so /dev/ng0n1 is commonly nsid 2.
+ *
+ * Getting this wrong is not a failed command, it is a command sent to the
+ * WRONG NAMESPACE. Store is opcode 01h and so is block Write; Delete is 10h
+ * and so is Dataset Management. Aimed at a block namespace on the same
+ * controller, a seeding Store is a write at an LBA derived from the key and
+ * the value size. NVME_IOCTL_ID asks the kernel which namespace this fd is,
+ * which is the same question the plugin asks of its own fd.
+ */
+static bool
+nvmeKvNsid(const std::string &device, uint32_t &nsid) {
+    int fd = open(device.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) {
+        std::cerr << "Error: cannot open " << device << ": " << std::strerror(errno)
+                  << std::endl;
+        return false;
+    }
+    int id = ioctl(fd, NVME_IOCTL_ID);
+    close(fd);
+    if (id < 0) {
+        std::cerr << "Error: " << device << " has no namespace id: " << std::strerror(errno)
+                  << ". It has to be a namespace character device such as /dev/ng0n1, not a "
+                     "controller handle such as /dev/nvme0."
+                  << std::endl;
+        return false;
+    }
+    nsid = static_cast<uint32_t>(id);
+    return true;
+}
+
+static bool
+nvmeKvRun(const std::string &cmd) {
+    int rc = std::system(cmd.c_str());
+    return rc == 0;
+}
+
+bool
+xferBenchUtils::putObjNvmeKv(size_t buffer_size, const std::string &name) {
+    if (xferBenchConfig::nvme_kv_device.empty()) {
+        std::cerr << "Error: --nvme_kv_device is required for NVME_KV" << std::endl;
+        return false;
+    }
+    std::string cdws;
+    uint32_t key_len = 0;
+    if (!nvmeKvKeyCdws(name, cdws, key_len)) {
+        return false;
+    }
+    uint32_t nsid = 0;
+    if (!nvmeKvNsid(xferBenchConfig::nvme_kv_device, nsid)) {
+        return false;
+    }
+    std::string filename = "/tmp/" + name;
+    int fd = createFile(buffer_size, filename);
+    if (fd < 0) {
+        return false;
+    }
+    close(fd);
+
+    std::string cmd = "nvme io-passthru " + xferBenchConfig::nvme_kv_device +
+        " --opcode=0x01 --namespace-id=" + std::to_string(nsid) + cdws +
+        " --cdw10=" + std::to_string(buffer_size) +
+        " --data-len=" + std::to_string(buffer_size) + " --write --input-file=" + filename +
+        " >/dev/null 2>&1";
+    std::cout << "Storing NVMe KV key: " << name << " (" << buffer_size << " bytes)" << std::endl;
+    bool ok = nvmeKvRun(cmd);
+    unlink(filename.c_str());
+    if (!ok) {
+        std::cerr << "Failed to store NVMe KV key " << name << std::endl;
+    }
+    return ok;
+}
+
+bool
+xferBenchUtils::getObjNvmeKv(const std::string &name) {
+    // Nothing to fetch to the local filesystem: the benchmark reads the value
+    // through NIXL, which is the thing being measured.
+    (void)name;
+    return true;
+}
+
+bool
+xferBenchUtils::rmObjNvmeKv(const std::string &name) {
+    if (xferBenchConfig::nvme_kv_device.empty()) {
+        return false;
+    }
+    std::string cdws;
+    uint32_t key_len = 0;
+    if (!nvmeKvKeyCdws(name, cdws, key_len)) {
+        return false;
+    }
+    uint32_t nsid = 0;
+    if (!nvmeKvNsid(xferBenchConfig::nvme_kv_device, nsid)) {
+        return false;
+    }
+    std::string cmd = "nvme io-passthru " + xferBenchConfig::nvme_kv_device +
+        " --opcode=0x10 --namespace-id=" + std::to_string(nsid) + cdws + " >/dev/null 2>&1";
+    return nvmeKvRun(cmd);
+}
