+namespace {
+
+/// One value in flight: the command, and what we need to judge its completion.
+struct nvmeKvTask {
+    struct nvme_uring_cmd cmd;
+    /// What the caller asked to move. A Retrieve that returns a different
+    /// stored length has not produced the value the caller wanted.
+    uint32_t requestedLen = 0;
+    bool isRetrieve = false;
+    nixl_status_t status = NIXL_IN_PROG;
+    /// Set for a VRAM value: where the device copy lives, and the host
+    /// staging bytes the NVMe command actually names.
+    void *devicePtr = nullptr;
+    void *stagingPtr = nullptr;
+    /// A completed VRAM Retrieve whose bytes are still only in the staging
+    /// buffer. checkXfer() performs the copy outside the ring lock.
+    bool needsHostToDevice = false;
+};
+
+} // namespace
+
+/// What registerMem() hands back, and what prepXfer() reads off
+/// nixlMetaDesc::metadataP to find a VRAM registration's staging buffer.
+class nvmeKvMetadata : public nixlBackendMD {
+public:
+    nvmeKvMetadata(nixl_mem_t mem, uintptr_t a, size_t l, void *stage)
+        : nixlBackendMD(true),
+          memType(mem),
+          addr(a),
+          len(l),
+          staging(stage) {}
+
+    nixl_mem_t memType;
+    uintptr_t addr = 0;
+    size_t len = 0;
+    /// Pinned host memory for VRAM_SEG, nullptr otherwise.
+    void *staging = nullptr;
+};
+
+class nvmeKvBackendReqH : public nixlBackendReqH {
+public:
+    std::vector<nvmeKvTask> tasks_;
+    size_t completed_ = 0;
+    /// First error wins and is what checkXfer() keeps returning.
+    nixl_status_t overall_ = NIXL_IN_PROG;
+    bool posted_ = false;
+};
+
+namespace {
+
+/**
+ * Turn an io_uring completion into a NIXL status.
+ *
+ * cqe->res carries three different things and they have to be told apart:
+ * a negative value is -errno from the submission path, zero is success, and a
+ * positive value is the NVMe status field itself. Only the low 11 bits of that
+ * are the status code; the rest is phase, CRD and the Do Not Retry bit.
+ */
+nixl_status_t
+statusFromCqe(int res, uint8_t opcode) {
+    if (res < 0) {
+        NIXL_ERROR << "NVMe KV command failed before the device saw it: " << strerror(-res);
+        return NIXL_ERR_BACKEND;
+    }
+    if (res == 0) {
+        return NIXL_SUCCESS;
+    }
+
+    const uint16_t sc = static_cast<uint16_t>(res) & 0x7ff;
+    if (sc == nvme_kv::SC_KEY_DOES_NOT_EXIST) {
+        // Not an error for Exist, which is asking the question. For a
+        // Retrieve it is a genuine miss, and NIXL_ERR_NOT_FOUND says which.
+        NIXL_DEBUG << "NVMe KV: key does not exist";
+        return NIXL_ERR_NOT_FOUND;
+    }
+    NIXL_ERROR << absl::StrFormat("NVMe KV opcode 0x%02x failed with status 0x%04x", opcode, sc);
+    return NIXL_ERR_BACKEND;
+}
+
+} // namespace
+
+bool
+nvmeKvEngine::resolveKey(uint64_t dev_id,
+                         const std::string &meta_info,
+                         bool hash_long_keys,
+                         uint8_t (&key)[nvme_kv::MAX_KEY_LEN],
+                         uint8_t &key_len) {
+    // Empty metaInfo: the devId bytes are the key. Same rule DOCA_MEMOS uses,
+    // and what makes a bare `registerMem(desc, OBJ_SEG)` with only a devId
+    // work without the caller inventing a naming scheme.
+    if (meta_info.empty()) {
+        key_len = sizeof(dev_id);
+        memcpy(key, &dev_id, key_len);
+        return true;
+    }
+
+    if (hash_long_keys) {
+        // A 128-bit digest of an arbitrary string, so an application key of
+        // any length and shape fits the specification's 16 bytes.
+        //
+        // DOCA_MEMOS uses unkeyed Blake2b here. This uses FNV-1a over two
+        // halves rather than pulling libb2 in for one call: the keyspace is a
+        // local KV namespace, not a security boundary, and a collision costs
+        // an overwrite rather than a vulnerability. If this ever has to
+        // interoperate with a DOCA_MEMOS client over the same namespace, it
+        // must become Blake2b -- that is the one thing the two could disagree
+        // on and still both appear to work.
+        auto fnv1a = [](const char *p, size_t n, uint64_t seed) {
+            uint64_t h = seed;
+            for (size_t i = 0; i < n; ++i) {
+                h ^= static_cast<uint8_t>(p[i]);
+                h *= 0x100000001b3ULL;
+            }
+            return h;
+        };
+        const uint64_t lo = fnv1a(meta_info.data(), meta_info.size(), 0xcbf29ce484222325ULL);
+        const uint64_t hi = fnv1a(meta_info.data(), meta_info.size(), lo ^ 0x9e3779b97f4a7c15ULL);
+        memcpy(key, &lo, 8);
+        memcpy(key + 8, &hi, 8);
+        key_len = nvme_kv::MAX_KEY_LEN;
+        return true;
+    }
+
+    // Otherwise metaInfo is the key in hex, at most 16 bytes of it.
+    if (meta_info.size() > nvme_kv::MAX_KEY_LEN * 2 || (meta_info.size() & 1) != 0) {
+        return false;
+    }
+    key_len = static_cast<uint8_t>(meta_info.size() / 2);
+    for (uint8_t i = 0; i < key_len; ++i) {
+        const auto hexval = [](char c) -> int {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+            return -1;
+        };
+        const int h = hexval(meta_info[i * 2]);
+        const int l = hexval(meta_info[i * 2 + 1]);
+        if (h < 0 || l < 0) {
+            return false;
+        }
+        key[i] = static_cast<uint8_t>((h << 4) | l);
+    }
+    return key_len > 0;
+}
+
+nixl_status_t
+nvmeKvEngine::openDevice(const std::string &path) {
+    deviceFd_ = open(path.c_str(), O_RDWR);
+    if (deviceFd_ < 0) {
+        NIXL_ERROR << "NVMe KV: cannot open " << path << ": " << strerror(errno);
+        return NIXL_ERR_BACKEND;
+    }
+
+    // NVME_IOCTL_ID returns the namespace id for a namespace character or
+    // block device. It is also the cheapest proof that this is an NVMe
+    // namespace at all rather than, say, a regular file.
+    const int nsid = ioctl(deviceFd_, NVME_IOCTL_ID);
+    if (nsid < 0) {
+        NIXL_ERROR << "NVMe KV: " << path << " is not an NVMe namespace: " << strerror(errno);
+        return NIXL_ERR_BACKEND;
+    }
+    nsid_ = static_cast<uint32_t>(nsid);
+
+    // THE CHECK THAT MATTERS. See the comment on openDevice() in the header:
+    // Store is opcode 01h, which an LBA namespace would execute as Write.
+    //
+    // CNS 03h is the Namespace Identification Descriptor list: a sequence of
+    // {NIDT, NIDL, reserved[2], value[NIDL]} structures. NIDT 04h is the
+    // Command Set Identifier, one byte.
+    std::vector<uint8_t> desc(4096, 0);
+    struct nvme_passthru_cmd id = {};
+    id.opcode = 0x06; // Identify
+    id.nsid = nsid_;
+    id.addr = reinterpret_cast<uint64_t>(desc.data());
+    id.data_len = static_cast<uint32_t>(desc.size());
+    id.cdw10 = 0x03;
+    if (ioctl(deviceFd_, NVME_IOCTL_ADMIN_CMD, &id) != 0) {
+        NIXL_ERROR << "NVMe KV: Identify (CNS 03h) failed on " << path << ": " << strerror(errno);
+        return NIXL_ERR_BACKEND;
+    }
+
+    uint8_t csi = 0;
+    bool csi_found = false;
+    for (size_t off = 0; off + 4 <= desc.size();) {
+        const uint8_t nidt = desc[off];
+        const uint8_t nidl = desc[off + 1];
+        if (nidt == 0 || nidl == 0) {
+            break; // End of the list.
+        }
+        if (nidt == 0x04 && nidl >= 1 && off + 4 + nidl <= desc.size()) {
+            csi = desc[off + 4];
+            csi_found = true;
+            break;
+        }
+        off += 4 + nidl;
+    }
+
+    if (!csi_found) {
+        NIXL_ERROR << "NVMe KV: " << path
+                   << " reports no Command Set Identifier, so it cannot be shown to be a KV "
+                      "namespace. Refusing: a Store sent to an LBA namespace executes as a Write.";
+        return NIXL_ERR_NOT_SUPPORTED;
+    }
+    if (csi != nvme_kv::CSI_KV) {
+        NIXL_ERROR << absl::StrFormat(
+            "NVMe KV: %s is csi %u, not Key Value (csi %u). Refusing: Store is opcode 0x01, "
+            "which this namespace would execute as a block Write.",
+            path.c_str(),
+            csi,
+            nvme_kv::CSI_KV);
+        return NIXL_ERR_NOT_SUPPORTED;
+    }
+
+    // Maximum Data Transfer Size. Identify Controller (CNS 01h) byte 77 holds
+    // it as a power of two of the minimum page size, and zero means "no
+    // limit". Without this a value larger than the controller accepts comes
+    // back from io_uring as a bare EINVAL with nothing to say which limit was
+    // hit -- the kernel rejects it before the device ever sees it, so there is
+    // no NVMe status to report either.
+    std::vector<uint8_t> ctrl(4096, 0);
+    struct nvme_passthru_cmd idc = {};
+    idc.opcode = 0x06; // Identify
+    idc.addr = reinterpret_cast<uint64_t>(ctrl.data());
+    idc.data_len = static_cast<uint32_t>(ctrl.size());
+    idc.cdw10 = 0x01; // CNS 01h, Identify Controller
+    if (ioctl(deviceFd_, NVME_IOCTL_ADMIN_CMD, &idc) == 0) {
+        const uint8_t mdts = ctrl[77];
+        if (mdts != 0 && mdts < 32) {
+            // MPSMIN is in CAP[55:52] and is almost always 0, meaning 4 KiB.
+            // Reading CAP needs the controller's sysfs or a register map that
+            // passthrough does not offer, so 4 KiB is assumed and said so in
+            // the message rather than silently.
+            maxValueLen_ = 4096u << mdts;
+            NIXL_INFO << absl::StrFormat(
+                "NVMe KV: MDTS %u caps a single value at %u bytes (assuming 4 KiB pages)",
+                mdts,
+                maxValueLen_);
+        }
+    } else {
+        NIXL_WARN << "NVMe KV: Identify Controller failed, so the transfer-size limit is "
+                     "unknown; an oversized value will fail with EINVAL";
+    }
+
+    NIXL_INFO << "NVMe KV: " << path << " nsid " << nsid_ << " is a Key Value namespace";
+    return NIXL_SUCCESS;
+}
+
+nvmeKvEngine::nvmeKvEngine(const nixlBackendInitParams *init_params)
+    : nixlBackendEngine(init_params) {
+    nixl_b_params_t *params = init_params->customParams;
+
+    devicePath_ = nixl::getBackendParamDefaulted<std::string>(params, "device_name", "");
+    if (devicePath_.empty()) {
+        NIXL_ERROR << "NVMe KV: device_name is required (e.g. /dev/ng0n1)";
+        return;
+    }
+    hashLongKeys_ = nixl::getBackendParamDefaulted<bool>(params, "convert_key_to_128bit", false);
+    queueDepth_ = nixl::getBackendParamDefaulted<uint32_t>(params, "queue_depth", 256);
+
+    if (openDevice(devicePath_) != NIXL_SUCCESS) {
+        return;
+    }
+
+    // SQE128 and CQE32 are not tuning. A passthrough command does not fit in a
+    // 64-byte SQE, and the NVMe completion result -- which is how a Retrieve
+    // reports the stored value length -- does not fit in a 16-byte CQE.
+    struct io_uring_params p = {};
+    p.flags = IORING_SETUP_SQE128 | IORING_SETUP_CQE32;
+    const int ret = io_uring_queue_init_params(queueDepth_, &ring_, &p);
+    if (ret < 0) {
+        NIXL_ERROR << "NVMe KV: io_uring_queue_init_params failed: " << strerror(-ret);
+        return;
+    }
+    ringReady_ = true;
+
+#ifdef HAVE_HIP
+    // Non-blocking so it never implicitly synchronises with the null stream,
+    // which is the whole reason for having a stream of our own.
+    if (hipStreamCreateWithFlags(&stagingStream_, hipStreamNonBlocking) == hipSuccess) {
+        stagingStreamReady_ = true;
+    } else {
+        NIXL_WARN << "NVMe KV: could not create a staging stream; VRAM copies will use the "
+                     "null stream and serialise against other GPU work";
+    }
+#endif
+
+    NIXL_INFO << absl::StrFormat(
+        "NVMe KV backend ready on %s (nsid %u, queue_depth %u, convert_key_to_128bit %s)",
+        devicePath_.c_str(),
+        nsid_,
+        queueDepth_,
+        hashLongKeys_ ? "true" : "false");
+}
+
+nvmeKvEngine::~nvmeKvEngine() {
+#ifdef HAVE_HIP
+    if (stagingStreamReady_) {
+        (void)hipStreamDestroy(stagingStream_);
+    }
+#endif
+    if (ringReady_) {
+        io_uring_queue_exit(&ring_);
+    }
+    if (deviceFd_ >= 0) {
+        close(deviceFd_);
+    }
+}
+
+nixl_status_t
+nvmeKvEngine::registerMem(const nixlBlobDesc &mem,
+                          const nixl_mem_t &nixl_mem,
+                          nixlBackendMD *&out) {
+    if (!ringReady_) {
+        NIXL_ERROR << "NVMe KV: backend did not initialise";
+        return NIXL_ERR_BACKEND;
+    }
+
+    if (nixl_mem == OBJ_SEG) {
+        // Validate now rather than at prepXfer: a key that cannot be resolved
+        // is a caller mistake, and saying so at registration points at the
+        // descriptor that is wrong.
+        uint8_t key[nvme_kv::MAX_KEY_LEN];
+        uint8_t key_len = 0;
+        if (!resolveKey(mem.devId, mem.metaInfo, hashLongKeys_, key, key_len)) {
+            NIXL_ERROR << "NVMe KV: metaInfo '" << mem.metaInfo
+                       << "' is not a hex key of 1..16 bytes; set convert_key_to_128bit=true to "
+                          "hash arbitrary strings instead";
+            return NIXL_ERR_INVALID_PARAM;
+        }
+        devIdToMetaInfo_[mem.devId] = mem.metaInfo;
+        out = new nvmeKvMetadata(nixl_mem, mem.addr, mem.len, nullptr);
+        return NIXL_SUCCESS;
+    }
+
+    if (nixl_mem == DRAM_SEG) {
+        // Nothing to pin. NVMe passthrough takes a user virtual address and
+        // the kernel pins it for the duration of each command, so there is no
+        // registration to hold between transfers.
+        out = new nvmeKvMetadata(nixl_mem, mem.addr, mem.len, nullptr);
+        return NIXL_SUCCESS;
+    }
+
+#ifdef HAVE_HIP
+    if (nixl_mem == VRAM_SEG) {
+        // One staging buffer per registration, sized to it, so a transfer
+        // never has to allocate. hipHostMalloc rather than malloc: the pages
+        // are pinned, which both makes the copies faster and means the kernel
+        // has nothing to do when it pins them again for the NVMe command.
+        void *staging = nullptr;
+        const hipError_t err = hipHostMalloc(&staging, mem.len, hipHostMallocDefault);
+        if (err != hipSuccess || staging == nullptr) {
+            NIXL_ERROR << "NVMe KV: could not allocate a " << mem.len
+                       << "-byte host staging buffer for a VRAM registration: "
+                       << hipGetErrorString(err);
+            return NIXL_ERR_BACKEND;
+        }
+        NIXL_DEBUG << absl::StrFormat(
+            "NVMe KV: staging %zu bytes of VRAM at 0x%x through host %p",
+            mem.len,
+            mem.addr,
+            staging);
+        out = new nvmeKvMetadata(nixl_mem, mem.addr, mem.len, staging);
+        return NIXL_SUCCESS;
+    }
+#endif
+
+    return NIXL_ERR_NOT_SUPPORTED;
+}
+
+void
+nvmeKvEngine::freeStaging(void *staging) {
+#ifdef HAVE_HIP
+    if (staging != nullptr) {
+        (void)hipHostFree(staging);
+    }
+#else
+    (void)staging;
+#endif
+}
+
+nixl_status_t
+nvmeKvEngine::deregisterMem(nixlBackendMD *meta) {
+    auto *md = static_cast<nvmeKvMetadata *>(meta);
+    if (md != nullptr) {
+        freeStaging(md->staging);
+    }
+    delete md;
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nvmeKvEngine::submitSync(struct nvme_uring_cmd &cmd, uint32_t *result_out) const {
+    const std::lock_guard<std::mutex> lock(ringLock_);
+
+    struct io_uring_sqe *sqe = io_uring_get_sqe(&ring_);
+    if (sqe == nullptr) {
+        NIXL_ERROR << "NVMe KV: submission queue full";
+        return NIXL_ERR_BACKEND;
+    }
+    const uint64_t token = nextToken_++;
+    io_uring_prep_rw(IORING_OP_URING_CMD, sqe, deviceFd_, nullptr, 0, 0);
+    sqe->cmd_op = NVME_URING_CMD_IO;
+    memcpy(sqe->cmd, &cmd, sizeof(cmd));
+    io_uring_sqe_set_data64(sqe, token);
+
+    if (io_uring_submit(&ring_) < 0) {
+        NIXL_ERROR << "NVMe KV: io_uring_submit failed";
+        return NIXL_ERR_BACKEND;
+    }
+
+    // Other requests' completions may arrive first; reapCompletions() files
+    // them with their owners rather than discarding them.
+    int res = 0;
+    uint32_t result = 0;
+    if (!reapCompletions(token, &res, &result)) {
+        NIXL_ERROR << "NVMe KV: no completion for the submitted command";
+        return NIXL_ERR_BACKEND;
+    }
+    if (result_out != nullptr) {
+        *result_out = result;
+    }
+    return statusFromCqe(res, cmd.opcode);
+}
+
+
+bool
+nvmeKvEngine::reapCompletions(uint64_t wanted, int *wanted_res, uint32_t *wanted_result) const {
+    bool saw_wanted = false;
+    struct io_uring_cqe *cqe = nullptr;
+
+    while (true) {
+        int ret;
+        if (wanted != 0 && !saw_wanted) {
+            // queryMem() has nothing else to do until its answer arrives.
+            ret = io_uring_wait_cqe(&ring_, &cqe);
+        } else {
+            ret = io_uring_peek_cqe(&ring_, &cqe);
+        }
+        if (ret != 0 || cqe == nullptr) {
+            break;
+        }
+
+        const uint64_t token = io_uring_cqe_get_data64(cqe);
+        const int res = cqe->res;
+        const uint32_t result = static_cast<uint32_t>(cqe->big_cqe[0]);
+        io_uring_cqe_seen(&ring_, cqe);
+        cqe = nullptr;
+
+        if (token == wanted) {
+            if (wanted_res != nullptr) *wanted_res = res;
+            if (wanted_result != nullptr) *wanted_result = result;
+            saw_wanted = true;
+            continue;
+        }
+
+        // A completion for a request that has already been released. Its
+        // handle is gone, so there is nothing to record -- but the token had
+        // to be kept until now so this could be told from a stray one.
+        if (orphaned_.erase(token) != 0) {
+            continue;
+        }
+
+        const auto it = inflight_.find(token);
+        if (it == inflight_.end()) {
+            NIXL_ERROR << "NVMe KV: completion with unknown token " << token;
+            continue;
+        }
+        nvmeKvBackendReqH *req = it->second.first;
+        const size_t idx = it->second.second;
+        inflight_.erase(it);
+
+        auto &task = req->tasks_[idx];
+        if (task.status != NIXL_IN_PROG) {
+            continue;
+        }
+
+        nixl_status_t status = statusFromCqe(res, task.cmd.opcode);
+
+        // A Retrieve that succeeded still has to have produced the value the
+        // caller asked for. The device reports the stored length in the
+        // completion result, so a value shorter or longer than the buffer is
+        // caught here rather than handed back as a partly-stale buffer.
+        // DOCA_MEMOS makes the same check for the same reason.
+        if (status == NIXL_SUCCESS && task.isRetrieve && result != task.requestedLen) {
+            NIXL_ERROR << absl::StrFormat(
+                "NVMe KV: Retrieve returned a %u-byte value into a %u-byte buffer",
+                result,
+                task.requestedLen);
+            status = NIXL_ERR_BACKEND;
+        }
+
+        // The bytes are in the staging buffer, not yet on the device. The
+        // copy is left to checkXfer(), which runs without the ring lock.
+        if (status == NIXL_SUCCESS && task.isRetrieve && task.stagingPtr != nullptr) {
+            task.needsHostToDevice = true;
+        }
+
+        task.status = status;
+        req->completed_++;
+        if (status != NIXL_SUCCESS && req->overall_ == NIXL_IN_PROG) {
+            req->overall_ = status;
+        }
+    }
+
+    return saw_wanted;
+}
+
+nixl_status_t
+nvmeKvEngine::queryMem(const nixl_reg_dlist_t &descs, std::vector<nixl_query_resp_t> &resp) const {
+    resp.assign(descs.descCount(), std::nullopt);
+    if (!ringReady_) {
+        return NIXL_ERR_BACKEND;
+    }
+
+    for (int i = 0; i < descs.descCount(); ++i) {
+        uint8_t key[nvme_kv::MAX_KEY_LEN];
+        uint8_t key_len = 0;
+        if (!resolveKey(descs[i].devId, descs[i].metaInfo, hashLongKeys_, key, key_len)) {
+            continue; // Leave nullopt: the descriptor names no usable key.
+        }
+
+        struct nvme_uring_cmd cmd =
+            nvme_kv::makeKeyOnlyCmd(nvme_kv::OPC_EXIST, nsid_, key, key_len);
+        const nixl_status_t status = submitSync(cmd, nullptr);
+        if (status == NIXL_SUCCESS) {
+            // Present. An empty param map is a value, so has_value() is the
+            // "exists" answer and the map is room for attributes later.
+            resp[i] = nixl_b_params_t{};
+        }
+        // NIXL_ERR_NOT_FOUND leaves nullopt, which is the "absent" answer.
+        // A real error does too -- queryMem has no way to distinguish them in
+        // its return type, so the log above is where that shows up.
+    }
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nvmeKvEngine::stageTasks(nvmeKvBackendReqH *req, bool to_device) const {
+#ifdef HAVE_HIP
+    bool issued = false;
+    for (auto &task : req->tasks_) {
+        if (task.stagingPtr == nullptr) {
+            continue;
+        }
+        if (to_device && !task.needsHostToDevice) {
+            continue;
+        }
+        const hipError_t err = to_device ?
+            hipMemcpyAsync(task.devicePtr,
+                           task.stagingPtr,
+                           task.requestedLen,
+                           hipMemcpyHostToDevice,
+                           stagingStream_) :
+            hipMemcpyAsync(task.stagingPtr,
+                           task.devicePtr,
+                           task.requestedLen,
+                           hipMemcpyDeviceToHost,
+                           stagingStream_);
+        if (err != hipSuccess) {
+            NIXL_ERROR << "NVMe KV: staging copy failed to start: " << hipGetErrorString(err);
+            return NIXL_ERR_BACKEND;
+        }
+        task.needsHostToDevice = false;
+        issued = true;
+    }
+
+    if (!issued) {
+        return NIXL_SUCCESS;
+    }
+
+    // One wait for the whole request. Before a Store this is also what makes
+    // the caller's own GPU work ordering safe to assume: the copy cannot read
+    // the buffer until work already queued ahead of it on the caller's stream
+    // has retired, and this returns only once the copy itself has.
+    const hipError_t err = hipStreamSynchronize(stagingStream_);
+    if (err != hipSuccess) {
+        NIXL_ERROR << "NVMe KV: staging copy failed: " << hipGetErrorString(err);
+        return NIXL_ERR_BACKEND;
+    }
+#else
+    (void)req;
+    (void)to_device;
+#endif
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nvmeKvEngine::prepXfer(const nixl_xfer_op_t &operation,
+                       const nixl_meta_dlist_t &local,
+                       const nixl_meta_dlist_t &remote,
+                       const std::string &remote_agent,
+                       nixlBackendReqH *&handle,
+                       const nixl_opt_b_args_t *opt_args) const {
+    if (!ringReady_) {
+        return NIXL_ERR_BACKEND;
+    }
+    if (operation != NIXL_WRITE && operation != NIXL_READ) {
+        NIXL_ERROR << "NVMe KV: invalid operation " << operation;
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    if (local.getType() != DRAM_SEG && local.getType() != VRAM_SEG) {
+        NIXL_ERROR << "NVMe KV: the value must be DRAM_SEG or VRAM_SEG, got "
+                   << local.getType();
+        return NIXL_ERR_INVALID_PARAM;
+    }
+#ifndef HAVE_HIP
+    if (local.getType() == VRAM_SEG) {
+        NIXL_ERROR << "NVMe KV: this build has no HIP, so VRAM_SEG cannot be staged";
+        return NIXL_ERR_NOT_SUPPORTED;
+    }
+#endif
+    if (remote.getType() != OBJ_SEG) {
+        NIXL_ERROR << "NVMe KV: the key must be OBJ_SEG, got " << remote.getType();
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    if (local.descCount() != remote.descCount()) {
+        NIXL_ERROR << absl::StrFormat("NVMe KV: %d values against %d keys",
+                                      local.descCount(),
+                                      remote.descCount());
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    auto req = std::make_unique<nvmeKvBackendReqH>();
+    req->tasks_.reserve(local.descCount());
+
+    for (int i = 0; i < local.descCount(); ++i) {
+        // The key comes from what registerMem() recorded, not from the
+        // transfer descriptor: nixlMetaDesc carries no metaInfo, only
+        // nixlBlobDesc does. So an OBJ_SEG must be registered before it can
+        // be transferred to, and its devId is the handle for it -- the same
+        // devIdToObjKey_ arrangement the OBJ plugin's engines use.
+        std::string meta;
+        const auto it = devIdToMetaInfo_.find(remote[i].devId);
+        if (it != devIdToMetaInfo_.end()) {
+            meta = it->second;
+        } else {
+            NIXL_ERROR << "NVMe KV: OBJ_SEG devId " << remote[i].devId
+                       << " is not registered with this backend";
+            return NIXL_ERR_INVALID_PARAM;
+        }
+
+        uint8_t key[nvme_kv::MAX_KEY_LEN];
+        uint8_t key_len = 0;
+        if (!resolveKey(remote[i].devId, meta, hashLongKeys_, key, key_len)) {
+            NIXL_ERROR << "NVMe KV: descriptor " << i << " names no usable key";
+            return NIXL_ERR_INVALID_PARAM;
+        }
+
+        nvmeKvTask task;
+        task.isRetrieve = (operation == NIXL_READ);
+        task.requestedLen = static_cast<uint32_t>(local[i].len);
+        if (maxValueLen_ != 0 && task.requestedLen > maxValueLen_) {
+            NIXL_ERROR << absl::StrFormat(
+                "NVMe KV: descriptor %d is %u bytes, over the controller's %u-byte maximum "
+                "transfer (MDTS). Split the value, or use a controller with a larger MDTS.",
+                i,
+                task.requestedLen,
+                maxValueLen_);
+            return NIXL_ERR_INVALID_PARAM;
+        }
+        // The buffer the NVMe command names. For VRAM that is the staging
+        // slice, not the device pointer: see the comment on getSupportedMems().
+        void *value = reinterpret_cast<void *>(local[i].addr);
+        if (local.getType() == VRAM_SEG) {
+            const auto *md = static_cast<const nvmeKvMetadata *>(local[i].metadataP);
+            if (md == nullptr || md->staging == nullptr) {
+                NIXL_ERROR << "NVMe KV: descriptor " << i
+                           << " is VRAM_SEG but carries no staging buffer; the segment has to "
+                              "be registered with this backend first";
+                return NIXL_ERR_INVALID_PARAM;
+            }
+            // A descriptor may name a slice of the registration, so the
+            // staging offset has to match rather than always starting at zero.
+            if (local[i].addr < md->addr ||
+                (local[i].addr - md->addr) + task.requestedLen > md->len) {
+                NIXL_ERROR << absl::StrFormat(
+                    "NVMe KV: descriptor %d [0x%x, +%u) lies outside its registration "
+                    "[0x%x, +%zu)",
+                    i,
+                    local[i].addr,
+                    task.requestedLen,
+                    md->addr,
+                    md->len);
+                return NIXL_ERR_INVALID_PARAM;
+            }
+            task.devicePtr = reinterpret_cast<void *>(local[i].addr);
+            task.stagingPtr = static_cast<uint8_t *>(md->staging) + (local[i].addr - md->addr);
+            value = task.stagingPtr;
+        }
+
+        task.cmd = nvme_kv::makeDataCmd(
+            task.isRetrieve ? nvme_kv::OPC_RETRIEVE : nvme_kv::OPC_STORE,
+            nsid_,
+            key,
+            key_len,
+            value,
+            task.requestedLen);
+        req->tasks_.push_back(task);
+    }
+
+    handle = req.release();
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+nvmeKvEngine::postXfer(const nixl_xfer_op_t &operation,
+                       const nixl_meta_dlist_t &local,
+                       const nixl_meta_dlist_t &remote,
+                       const std::string &remote_agent,
+                       nixlBackendReqH *&handle,
+                       const nixl_opt_b_args_t *opt_args) const {
+    if (handle == nullptr) {
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    auto *req = static_cast<nvmeKvBackendReqH *>(handle);
+
+#ifdef HAVE_HIP
+    // A Store reads the staging buffer, so the device's bytes have to be in
+    // it first. Outside the ring lock: the wait inside stageTasks() blocks,
+    // and holding the lock across it would serialise every other request
+    // behind this request's GPU copies.
+    if (operation == NIXL_WRITE) {
+        const nixl_status_t staged = stageTasks(req, false);
+        if (staged != NIXL_SUCCESS) {
+            req->overall_ = staged;
+            return staged;
+        }
+    }
+#endif
+
+    const std::lock_guard<std::mutex> lock(ringLock_);
+
+    for (size_t i = 0; i < req->tasks_.size(); ++i) {
+        struct io_uring_sqe *sqe = io_uring_get_sqe(&ring_);
+        if (sqe == nullptr) {
+            // The ring is full. Everything already queued is submitted below
+            // and the rest would need a second pass; rather than half-post a
+            // transfer silently, say so and fail it.
+            NIXL_ERROR << "NVMe KV: submission queue exhausted at descriptor " << i << " of "
+                       << req->tasks_.size() << "; raise queue_depth (currently " << queueDepth_
+                       << ")";
+            req->overall_ = NIXL_ERR_BACKEND;
+            return NIXL_ERR_BACKEND;
+        }
+        io_uring_prep_rw(IORING_OP_URING_CMD, sqe, deviceFd_, nullptr, 0, 0);
+        sqe->cmd_op = NVME_URING_CMD_IO;
+        memcpy(sqe->cmd, &req->tasks_[i].cmd, sizeof(req->tasks_[i].cmd));
+        // A token unique for the engine's lifetime, not the task's index:
+        // see reapCompletions() for why the index is not enough.
+        const uint64_t token = nextToken_++;
+        inflight_[token] = {req, i};
+        io_uring_sqe_set_data64(sqe, token);
+    }
+
+    const int submitted = io_uring_submit(&ring_);
+    if (submitted < 0) {
+        NIXL_ERROR << "NVMe KV: io_uring_submit failed: " << strerror(-submitted);
+        req->overall_ = NIXL_ERR_BACKEND;
+        return NIXL_ERR_BACKEND;
+    }
+
+    req->posted_ = true;
+    return NIXL_IN_PROG;
+}
+
+nixl_status_t
+nvmeKvEngine::checkXfer(nixlBackendReqH *handle) const {
+    if (handle == nullptr) {
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    auto *req = static_cast<nvmeKvBackendReqH *>(handle);
+    if (!req->posted_) {
+        return req->overall_;
+    }
+
+    {
+        const std::lock_guard<std::mutex> lock(ringLock_);
+        // Drain without blocking and let every completion find its owner;
+        // NIXL polls, so returning NIXL_IN_PROG is the normal answer.
+        reapCompletions(0, nullptr, nullptr);
+    }
+
+#ifdef HAVE_HIP
+    // Finish any VRAM Retrieve by copying the staged bytes up to the device.
+    // Doing it here rather than in reapCompletions() keeps the blocking wait
+    // out of the ring lock, and doing it before the success below is what
+    // keeps NIXL_SUCCESS meaning "the data is where the caller asked for it".
+    if (req->completed_ == req->tasks_.size()) {
+        const nixl_status_t staged = stageTasks(req, true);
+        if (staged != NIXL_SUCCESS && req->overall_ == NIXL_IN_PROG) {
+            req->overall_ = staged;
+        }
+    }
+#endif
+
+    if (req->completed_ < req->tasks_.size()) {
+        return NIXL_IN_PROG;
+    }
+    return req->overall_ == NIXL_IN_PROG ? NIXL_SUCCESS : req->overall_;
+}
+
+nixl_status_t
+nvmeKvEngine::releaseReqH(nixlBackendReqH *handle) const {
+    if (handle == nullptr) {
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    auto *req = static_cast<nvmeKvBackendReqH *>(handle);
+    {
+        const std::lock_guard<std::mutex> lock(ringLock_);
+        // Releasing a handle whose commands are still in flight is legal --
+        // NIXL may abandon a transfer -- but their completions will still
+        // arrive, and following a stale pointer then would be a use-after-free.
+        // Move the tokens aside so reapCompletions() drops them instead.
+        for (auto it = inflight_.begin(); it != inflight_.end();) {
+            if (it->second.first == req) {
+                orphaned_.insert(it->first);
+                it = inflight_.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    delete req;
+    return NIXL_SUCCESS;
+}
