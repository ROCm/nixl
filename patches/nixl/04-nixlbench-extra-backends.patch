# Teach nixlbench about the two backends this tree adds: MORI_IO and AIS_MT.
#
# nixlbench's --backend is NOT a free-form string: nixl_worker.cpp gates it on
# a hardcoded list of known names and exits with "Unsupported NIXLBench
# backend" for anything else, even when the NIXL plugin exists and the agent
# can see it.  So shipping a plugin is necessary but not sufficient.
#
# Both backends live in one patch on purpose.  They touch the same three files
# (utils.h, utils.cpp, nixl_worker.cpp) within a few lines of each other, so as
# separate patches the second would have to be generated against a tree with
# the first already applied -- an ordering trap that is easy to get wrong and
# annoying to maintain.  One patch, one place.
#
# MORI_IO is a memory transport, so it joins the accepted-backend list and maps
# --progress_threads onto the plugin's mori_worker_threads.
#
# AIS_MT is hipFile-backed storage, so it additionally joins isStorageBackend():
# that is what makes nixlbench address it with --filepath, keep the local
# segment in DRAM, and print the storage options.  Without it nixlbench would
# treat a file backend as a peer-memory backend and the run makes no sense.
#
# Depends on 01 (which adds the AIS_MT plugin) and 02 (the MORI_IO plugin).
#
diff --git a/benchmark/nixlbench/src/utils/utils.cpp b/benchmark/nixlbench/src/utils/utils.cpp
index 0801ae9..280a51d 100644
--- a/benchmark/nixlbench/src/utils/utils.cpp
+++ b/benchmark/nixlbench/src/utils/utils.cpp
@@ -63,7 +63,7 @@ NB_ARG_STRING(worker_type, XFERBENCH_WORKER_NIXL, "Type of worker [nixl, nvshmem
 NB_ARG_STRING(backend,
               XFERBENCH_BACKEND_UCX,
               "Name of NIXL backend [UCX, GDS, GDS_MT, POSIX, GPUNETIO, Mooncake, HF3FS, OBJ, "
-              "GUSLI, AZURE_BLOB] (only used with nixl worker)");
+              "GUSLI, AZURE_BLOB, MORI_IO, AIS_MT] (only used with nixl worker)");
 NB_ARG_STRING(initiator_seg_type,
               XFERBENCH_SEG_TYPE_DRAM,
               "Type of memory segment for initiator [DRAM, VRAM]. Note: Storage backends always "
@@ -807,6 +807,7 @@ bool
 xferBenchConfig::isStorageBackend() {
     return (XFERBENCH_BACKEND_GDS == xferBenchConfig::backend ||
             XFERBENCH_BACKEND_GDS_MT == xferBenchConfig::backend ||
+            XFERBENCH_BACKEND_AIS_MT == xferBenchConfig::backend ||
             XFERBENCH_BACKEND_HF3FS == xferBenchConfig::backend ||
             XFERBENCH_BACKEND_POSIX == xferBenchConfig::backend ||
             XFERBENCH_BACKEND_OBJ == xferBenchConfig::backend ||
