 option('rocm_ais_path', type: 'string', value: '', description: 'Path to hipFile install for AIS_MT (default: auto-detect via ROCM_PATH or /opt/rocm)')
+option('mori_path', type: 'string', value: '', description: 'Path to the MORI (ROCm/mori) C++ SDK install prefix for the MORI_IO backend. Empty disables the plugin.')
 option('cudapath_inc', type: 'string', value: '', description: 'Include path for CUDA')
