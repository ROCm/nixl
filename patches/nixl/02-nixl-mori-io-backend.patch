# NIXL MORI-IO backend plugin (MORI_IO) for upstream ai-dynamo/nixl.
#
# Adds src/plugins/mori_io/, a NIXL backend engine implemented on top of
# MORI-IO (ROCm/mori), so any NIXL consumer -- nixlbench in particular -- can
# drive MORI's point-to-point transport by name:
#
#     nixlbench --backend MORI_IO ...
#
# This plugin is what makes MORI reachable from NIXL at all.  nixlbench needs
# one more, small change on top of it -- its --backend flag is gated on a
# hardcoded list of names, so it rejects MORI_IO even when the agent can see
# the plugin; that is 04-nixlbench-extra-backends.patch.  Together they mean
# one benchmark, one set of buffer setup/warmup/timing rules, and switching
# transport is one flag.
#
# Scope:
#   meson_options.txt     + mori_path (empty = plugin not built)
#   meson.build           + MORI_IO in all_plugins, + mori_dep detection
#   src/plugins/meson.build + subdir('mori_io') when mori_dep is found
#   src/plugins/mori_io/  the backend itself (new tree)
#
# The plugin is entirely opt-in: with no -Dmori_path the MORI dependency is a
# disabler, the subdir is skipped, and a stock CUDA build is byte-identical to
# unpatched upstream.
#
# Concept mapping is documented at the top of mori_io_backend.h.
#
# To regenerate on a NIXL bump: clone the new tag, `git apply` this patch, and
# if the three wiring hunks conflict, re-apply them by hand (they are small and
# additive) and re-export with:
#   git diff --cached --no-renames -- meson.build meson_options.txt \
#     src/plugins/meson.build src/plugins/mori_io
#
diff --git a/meson.build b/meson.build
index 10ba75f..8e0c118 100644
--- a/meson.build
+++ b/meson.build
@@ -29,7 +29,7 @@ if enable_plugins_opt != '' and disable_plugins_opt != ''
     error('Cannot specify both enable_plugins and disable_plugins options')
 endif
 
-all_plugins = ['UCX', 'LIBFABRIC', 'POSIX', 'OBJ', 'GDS', 'GDS_MT', 'AIS_MT', 'MOONCAKE', 'HF3FS', 'GUSLI', 'GPUNETIO', 'UCCL', 'AZURE_BLOB', 'INFINIA']
+all_plugins = ['UCX', 'LIBFABRIC', 'POSIX', 'OBJ', 'GDS', 'GDS_MT', 'AIS_MT', 'MOONCAKE', 'HF3FS', 'GUSLI', 'GPUNETIO', 'UCCL', 'AZURE_BLOB', 'INFINIA', 'MORI_IO']
 
 enabled_plugins = {}
 
@@ -312,6 +312,54 @@ endif
 
 has_gpu = cuda_dep.found() or hip_dep.found()
 
+# --- MORI (ROCm/mori) C++ SDK, for the MORI_IO backend plugin ---------------
+# Opt-in and path-driven: -Dmori_path=<prefix> pointing at a `cmake --install`
+# of ROCm/mori (include/mori/... plus lib/libmori_io.so).  Left empty -- the
+# default -- mori_dep is a disabler and src/plugins/meson.build skips the
+# plugin entirely, so an unpatched CUDA build is completely unaffected.
+#
+# ROCm detection is done here rather than reusing hip_dep so this patch stands
+# on its own: it applies with or without the AIS_MT/HIP patch ahead of it.
+mori_dep = disabler()
+mori_path = get_option('mori_path')
+if mori_path != ''
+    mori_inc = mori_path + '/include'
+    mori_lib = mori_path + '/lib'
+    # MORI's public headers include <hip/hip_runtime_api.h> directly, so a
+    # consumer needs the ROCm include/lib on its own command line.
+    mori_rocm_home = run_command('bash', '-c', 'echo ${ROCM_PATH:-/opt/rocm}',
+                                 check: true).stdout().strip()
+    if not fs.exists(mori_inc / 'mori' / 'io' / 'engine.hpp')
+        error('mori_path=' + mori_path + ' has no include/mori/io/engine.hpp; ' +
+              'point it at a `cmake --install` of ROCm/mori.')
+    endif
+    if not fs.exists(mori_rocm_home / 'include' / 'hip' / 'hip_runtime_api.h')
+        error('mori_path is set but no ROCm HIP headers under ' + mori_rocm_home +
+              '; set ROCM_PATH to the ROCm install root.')
+    endif
+    mori_io_lib = cpp.find_library('mori_io', dirs: [mori_lib], required: true)
+    mori_app_lib = cpp.find_library('mori_application', dirs: [mori_lib], required: true)
+    # MORI builds spdlog as a COMPILED static lib with hidden visibility (see
+    # the comment in ROCm/mori's CMakeLists: two copies of spdlog exporting the
+    # same symbols corrupt the heap).  mori/utils/mori_log.hpp is pulled in by
+    # every mori/io header, so a consumer must compile in the same mode
+    # (SPDLOG_COMPILED_LIB) and link MORI's own libspdlog.a.
+    mori_spdlog_lib = cpp.find_library('spdlog', dirs: [mori_lib], required: true)
+    mori_dep = declare_dependency(
+        dependencies: [mori_io_lib, mori_app_lib, mori_spdlog_lib],
+        # MSGPACK_NO_BOOST mirrors what MORI compiles libmori_io with
+        # (target_compile_definitions(mori_io PUBLIC MSGPACK_NO_BOOST)).
+        compile_args: ['-D__HIP_PLATFORM_AMD__', '-DMSGPACK_NO_BOOST',
+                       '-DSPDLOG_COMPILED_LIB'],
+        # is_system (-isystem): MORI's and ROCm's headers are third-party here,
+        # and NIXL compiles with -Werror.
+        include_directories: include_directories(mori_inc, mori_rocm_home + '/include',
+                                                 is_system: true),
+        link_args: ['-L' + mori_lib, '-Wl,-rpath,' + mori_lib,
+                    '-L' + mori_rocm_home + '/lib', '-lamdhip64'])
+    message('MORI SDK found at ' + mori_path + '; MORI_IO backend enabled')
+endif
+
 # Allow callers (e.g. ROCm CI/Dockerfile) to override the wheel variant suffix
 # without otherwise affecting the build. Non-empty value wins over the
 # autodetected CUDA-major value above: e.g. -Dwheel_variant=rocm -> nixl_rocm.
