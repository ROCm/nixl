+/**
+ * Render a hipObject error for a log line. The HIP error is only meaningful
+ * when the failure came from HIP, so it is printed only when set.
+ */
+std::string
+hipObjErrStr(hipObjError_t err) {
+    const char *op = hipObjGetErrorString(err.opError);
+    if (err.hipError == 0) {
+        return op != nullptr ? op : "unknown";
+    }
+    return absl::StrFormat("%s (hip %d)", op != nullptr ? op : "unknown", err.hipError);
+}
+
+/**
+ * Release a token minted by hipObjGetRdmaToken(). The library allocated it and
+ * only it can free it, so this is the deleter rather than delete[].
+ */
+struct hipObjTokenDeleter {
+    void
+    operator()(char *token) const noexcept {
+        if (token != nullptr) {
+            (void)hipObjPutRdmaToken(token);
+        }
+    }
+};
+
+using hipObjTokenPtr = std::unique_ptr<char, hipObjTokenDeleter>;
+
+/**
+ * Validate parameters for prepXfer. Identical in substance to the Dell
+ * engine's check: the local side is memory, the remote side is an object.
+ */
+bool
+isValidPrepXferParams(const nixl_xfer_op_t &operation,
+                      const nixl_meta_dlist_t &local,
+                      const nixl_meta_dlist_t &remote,
+                      const std::string &remote_agent,
+                      const std::string &local_agent) {
+    if (operation != NIXL_WRITE && operation != NIXL_READ) {
+        NIXL_ERROR << absl::StrFormat("Invalid operation type: %d", operation);
+        return false;
+    }
+
+    if (remote_agent != local_agent) {
+        NIXL_WARN << absl::StrFormat(
+            "Remote agent doesn't match the requesting agent (%s). Got %s",
+            local_agent,
+            remote_agent);
+    }
+
+    if ((local.getType() != DRAM_SEG) && (local.getType() != VRAM_SEG)) {
+        NIXL_ERROR << absl::StrFormat("Local memory type must be VRAM_SEG or DRAM_SEG, got %d",
+                                      local.getType());
+        return false;
+    }
+
+    if (remote.getType() != OBJ_SEG) {
+        NIXL_ERROR << absl::StrFormat("Remote memory type must be OBJ_SEG, got %d",
+                                      remote.getType());
+        return false;
+    }
+
+    if (local.descCount() != remote.descCount()) {
+        NIXL_ERROR << absl::StrFormat(
+            "Local and remote descriptor counts must match. Got %d local, %d remote",
+            local.descCount(),
+            remote.descCount());
+        return false;
+    }
+
+    return true;
+}
