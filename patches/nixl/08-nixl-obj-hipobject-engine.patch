+S3HipObjEngineImpl::S3HipObjEngineImpl(const nixlBackendInitParams *init_params)
+    : S3AccelObjEngineImpl(init_params) {
+    init(init_params, nullptr);
+}
+
+S3HipObjEngineImpl::S3HipObjEngineImpl(const nixlBackendInitParams *init_params,
+                                       std::shared_ptr<iS3Client> s3_client)
+    : S3AccelObjEngineImpl(init_params, s3_client) {
+    init(init_params, std::move(s3_client));
+}
+
+void
+S3HipObjEngineImpl::init(const nixlBackendInitParams *init_params,
+                         std::shared_ptr<iS3Client> s3_client) {
+    // An RDMA GET answers with an empty body and delivers the payload out of
+    // band, so the SDK's body-checksum validation has nothing to check and
+    // fails whenever the server sends checksum headers. The Dell engine
+    // disables it for the same reason; RoCEv2's iCRC covers the wire.
+    nixl_b_params_t *params_to_use = init_params->customParams;
+    nixl_b_params_t local_params;
+    if (!init_params->customParams) {
+        local_params["resp_checksum"] = "required";
+        params_to_use = &local_params;
+    } else {
+        init_params->customParams->emplace("resp_checksum", "required");
+    }
+
+    s3Client_ = s3_client ? std::move(s3_client) :
+                            std::make_shared<awsS3HipObjClient>(params_to_use, executor_);
+
+    // gpuDevice -1 lets hipObject pick the NIC closest to the calling thread's
+    // current device, which is the right default under nixlbench. nicHint is
+    // the escape hatch for a host whose topology lookup cannot choose, and the
+    // only way to select a NIC on a host with no GPU at all.
+    const int gpu_device = nixl::getBackendParamDefaulted<int>(params_to_use, "hipobj_gpu", -1);
+    const std::string nic_hint =
+        nixl::getBackendParamDefaulted<std::string>(params_to_use, "hipobj_nic", "");
+
+    hipObjConfig_t config = {};
+    config.gpuDevice = gpu_device;
+    config.nicHint = nic_hint.empty() ? nullptr : nic_hint.c_str();
+
+    const hipObjError_t err = hipObjInit(&config);
+    if (err.opError == hipObjSuccess) {
+        ownsHipObjInit_ = true;
+        hipObjReady_ = true;
+    } else if (err.opError == hipObjAlreadyInitialized) {
+        // hipObject is initialised once per process. A second engine in the
+        // same process shares it and must not shut it down underneath the
+        // first, so it does not take ownership.
+        hipObjReady_ = true;
+        NIXL_DEBUG << "hipObject was already initialized; sharing it";
+    } else {
+        NIXL_ERROR << "hipObjInit failed: " << hipObjErrStr(err);
+        return;
+    }
+
+    NIXL_INFO << "Object storage backend initialized with hipObject S3 RDMA client ("
+              << hipObjGetVersionString() << ", gpu=" << gpu_device
+              << ", nic=" << (nic_hint.empty() ? "auto" : nic_hint) << ")";
+}
+
+S3HipObjEngineImpl::~S3HipObjEngineImpl() {
+    if (ownsHipObjInit_) {
+        (void)hipObjShutdown();
+    }
+}
