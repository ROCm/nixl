+# --- hipObject (ROCm/hipObject), for the OBJ plugin's hipobj engine ---------
+# The ROCm counterpart of cuobj_dep above. Same shape, different discovery:
+# hipObject installs a CMake package and no pkg-config module, so this is
+# path-driven like mori_path rather than a dependency() lookup.
+#
+# Left empty -- the default -- hipobj_dep is not found and
+# src/plugins/obj/meson.build leaves the hipobj engine out, exactly as it does
+# the Dell one without cuObject. Everything else in the OBJ plugin is
+# unaffected either way.
+hipobj_dep = dependency('', required: false)
+hipobj_path = get_option('hipobj_path')
+if hipobj_path != ''
+    hipobj_inc = hipobj_path + '/include'
+    hipobj_lib_dir = hipobj_path + '/lib'
+    # The header lives under include/hipobj/, so consumers say
+    # <hipobj/hipobj.h>; asserting the full path catches a prefix pointed at
+    # the source tree or at a half-finished install.
+    if not fs.exists(hipobj_inc / 'hipobj' / 'hipobj.h')
+        error('hipobj_path=' + hipobj_path + ' has no include/hipobj/hipobj.h; ' +
+              'point it at a `cmake --install` of ROCm/hipObject.')
+    endif
+    hipobj_lib = cpp.find_library('hipobj', dirs: [hipobj_lib_dir], required: true)
+    hipobj_dep = declare_dependency(
+        dependencies: [hipobj_lib],
+        # is_system (-isystem): hipObject's headers are third-party here and
+        # NIXL compiles with -Werror.
+        include_directories: include_directories(hipobj_inc, is_system: true),
+        link_args: ['-L' + hipobj_lib_dir, '-Wl,-rpath,' + hipobj_lib_dir])
+    add_project_arguments('-DHAVE_HIPOBJ_CLIENT', language: ['cpp'])
+    message('hipObject found at ' + hipobj_path + '; OBJ hipobj engine enabled')
+endif
