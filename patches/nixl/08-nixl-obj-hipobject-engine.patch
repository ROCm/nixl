+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef NIXL_OBJ_PLUGIN_S3_HIPOBJ_CLIENT_H
+#define NIXL_OBJ_PLUGIN_S3_HIPOBJ_CLIENT_H
+
+#include "s3_accel/client.h"
+#include "s3_accel/amd/rdma_interface.h"
+
+/**
+ * S3 client that speaks the cuObject/hipObject RDMA protocol.
+ *
+ * The AMD counterpart of awsS3DellObsClient. The difference is not only the
+ * header name -- Dell's x-rdma-info against this one's x-amz-rdma-token -- but
+ * that this protocol answers: the server reports what it did with the token in
+ * an x-amz-rdma-reply header, including declining RDMA altogether, and the
+ * caller has to read it. See rdma_interface.h.
+ */
+class awsS3HipObjClient : public awsS3AccelClient, public iHipObjS3RdmaClient {
+public:
+    /**
+     * @param custom_params Custom parameters containing S3 configuration
+     * @param executor Optional executor for async operations
+     */
+    explicit awsS3HipObjClient(
+        nixl_b_params_t *custom_params,
+        std::shared_ptr<Aws::Utils::Threading::Executor> executor = nullptr);
+
+    ~awsS3HipObjClient() override = default;
+
+    void
+    putObjectRdmaAsync(std::string_view key,
+                       size_t data_len,
+                       size_t offset,
+                       std::string_view rdma_token,
+                       rdma_object_callback_t callback) override;
+
+    void
+    getObjectRdmaAsync(std::string_view key,
+                       size_t data_len,
+                       size_t offset,
+                       std::string_view rdma_token,
+                       rdma_object_callback_t callback) override;
+};
