+    return s3Client_.get();
+}
diff --git a/src/plugins/obj/s3_accel/amd/engine_impl.h b/src/plugins/obj/s3_accel/amd/engine_impl.h
new file mode 100644
index 0000000..0947fe8
--- /dev/null
+++ b/src/plugins/obj/s3_accel/amd/engine_impl.h
@@ -0,0 +1,146 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef NIXL_OBJ_PLUGIN_S3_HIPOBJ_ENGINE_IMPL_H
+#define NIXL_OBJ_PLUGIN_S3_HIPOBJ_ENGINE_IMPL_H
+
+#include "s3_accel/engine_impl.h"
+#include "s3_accel/amd/client.h"
+#include <cstdint>
+#include <unordered_map>
+
+/**
+ * S3-over-RDMA engine on ROCm, built on hipObject.
+ *
+ * This is the AMD counterpart of S3DellObsObjEngineImpl, and the shape is the
+ * same because the protocol is: register a buffer with the NIC, mint a token
+ * that describes it, send an otherwise ordinary S3 request carrying that
+ * token, and let the server move the payload by RDMA instead of in the HTTP
+ * body. Where Dell's engine calls cuObject and sends x-rdma-info, this one
+ * calls hipObject and sends x-amz-rdma-token -- the header cuObject v1.2.0
+ * introduced and hipObject speaks on the client side.
+ *
+ * It is selected with `accelerated=true` and `type=hipobj` in the backend's
+ * custom parameters.
+ *
+ * TWO LIMITS WORTH KNOWING, both from hipObject rather than from here:
+ *
+ * 1. A transfer must start at the base of a registered buffer.
+ *    hipObjGetRdmaToken() looks the buffer up by exact pointer and mints the
+ *    token for [devPtr, devPtr + size) -- it passes offset 0 internally and
+ *    has no parameter for anything else, unlike hipObjGet()/hipObjPut().
+ *    A descriptor pointing into the middle of a registration would therefore
+ *    yield a token naming the base, and the server would RDMA to the wrong
+ *    address, so prepXfer() refuses it instead.
+ *
+ * 2. A PUT writes the whole object.  hipObject sends no object offset, and
+ *    S3 PutObject has no ranged form, so there is nowhere for one to go. GET
+ *    is unaffected: the Range header carries it.
+ */
+class S3HipObjEngineImpl : public S3AccelObjEngineImpl {
+public:
+    /**
+     * Initialises hipObject and creates the RDMA-capable S3 client.
+     *
+     * @param init_params Backend initialization parameters
+     */
+    explicit S3HipObjEngineImpl(const nixlBackendInitParams *init_params);
+
+    /**
+     * Constructor that accepts an injected S3 client (for testing).
+     *
+     * @param init_params Backend initialization parameters
+     * @param s3_client Pre-configured S3 client (can be mock for testing)
+     */
+    S3HipObjEngineImpl(const nixlBackendInitParams *init_params,
+                       std::shared_ptr<iS3Client> s3_client);
+
+    ~S3HipObjEngineImpl() override;
+
+    /**
+     * Register memory with the backend.
+     *
+     * OBJ_SEG records the object key. DRAM_SEG and VRAM_SEG are registered
+     * with the NIC through hipObjBufRegisterHost() and hipObjBufRegister()
+     * respectively; hipObject falls back to a host staging buffer when the
+     * device memory cannot be registered directly, which postXfer() then
+     * synchronises.
+     */
+    nixl_status_t
+    registerMem(const nixlBlobDesc &mem, const nixl_mem_t &nixl_mem, nixlBackendMD *&out) override;
+
+    /**
+     * Deregister memory, releasing the hipObject registration.
+     */
+    nixl_status_t
+    deregisterMem(nixlBackendMD *meta) override;
+
+    /**
+     * Prepare a transfer: resolve the object key and mint one RDMA token per
+     * descriptor. The tokens live on the request handle and are released with
+     * it.
+     */
+    nixl_status_t
+    prepXfer(const nixl_xfer_op_t &operation,
+             const nixl_meta_dlist_t &local,
+             const nixl_meta_dlist_t &remote,
+             const std::string &remote_agent,
+             const std::string &local_agent,
+             nixlBackendReqH *&handle,
+             const nixl_opt_b_args_t *opt_args) const override;
+
+    /**
+     * Post the S3 requests that carry the tokens, staging the buffer to host
+     * memory first on a write and back to the device on a read when hipObject
+     * is staging (a no-op when it is not).
+     */
+    nixl_status_t
+    postXfer(const nixl_xfer_op_t &operation,
+             const nixl_meta_dlist_t &local,
+             const nixl_meta_dlist_t &remote,
+             const std::string &remote_agent,
+             nixlBackendReqH *&handle,
+             const nixl_opt_b_args_t *opt_args = nullptr) const override;
+
+    nixl_status_t
+    checkXfer(nixlBackendReqH *handle) const override;
+
+    nixl_status_t
+    releaseReqH(nixlBackendReqH *handle) const override;
+
+    /**
+     * VRAM_SEG is the point of this engine: the server RDMAs straight into
+     * GPU memory when the NIC can reach it.
+     */
+    nixl_mem_list_t
+    getSupportedMems() const override {
+        return {OBJ_SEG, DRAM_SEG, VRAM_SEG};
+    }
+
+protected:
+    iS3Client *
+    getClient() const override;
+
+private:
+    /**
+     * Bring up hipObject and the RDMA-capable client. Shared by both
+     * constructors, which differ only in whether they were handed a client.
+     */
+    void
+    init(const nixlBackendInitParams *init_params, std::shared_ptr<iS3Client> s3_client);
+
+    /// True when this engine called hipObjInit() and must therefore shut it
+    /// down. hipObject is initialised once per process, so a second engine in
+    /// the same process finds it already up and must leave it that way.
+    bool ownsHipObjInit_ = false;
+    /// True when hipObject is usable; every entry point checks it, because a
+    /// failed init must not look like a working engine.
+    bool hipObjReady_ = false;
+    /// Registered buffer base address -> length, for the base-address check
+    /// that limit 1 above describes.
+    std::unordered_map<uintptr_t, size_t> registeredBufs_;
+};
+
+#endif // NIXL_OBJ_PLUGIN_S3_HIPOBJ_ENGINE_IMPL_H
diff --git a/src/plugins/obj/s3_accel/amd/rdma_interface.h b/src/plugins/obj/s3_accel/amd/rdma_interface.h
new file mode 100644
index 0000000..85d727e
--- /dev/null
+++ b/src/plugins/obj/s3_accel/amd/rdma_interface.h
@@ -0,0 +1,79 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef NIXL_OBJ_PLUGIN_S3_HIPOBJ_RDMA_INTERFACE_H
+#define NIXL_OBJ_PLUGIN_S3_HIPOBJ_RDMA_INTERFACE_H
+
+#include <string>
+#include <string_view>
+#include <cstdint>
+#include <functional>
+#include "nixl_types.h"
+
+/**
+ * Completion callback for an RDMA-accelerated S3 request.
+ *
+ * Unlike put_object_callback_t, this carries the x-amz-rdma-reply header back
+ * to the caller. It has to: an S3 server that does not implement the protocol
+ * answers a perfectly valid HTTP 200 with that header set to 501 and an empty
+ * body, having moved no data at all. Reporting only the HTTP status would make
+ * that case indistinguishable from a transfer that succeeded, and the first
+ * symptom would be a buffer full of whatever it held before.
+ *
+ * @param success   Whether the S3 request itself succeeded
+ * @param rdma_reply The x-amz-rdma-reply header value, or empty if absent
+ */
+using rdma_object_callback_t = std::function<void(bool success, std::string rdma_reply)>;
+
+/**
+ * Interface for S3 clients that speak the cuObject/hipObject RDMA protocol:
+ * an ordinary S3 request carrying an x-amz-rdma-token header that describes a
+ * registered client buffer, to which the server RDMA WRITEs (GET) or from
+ * which it RDMA READs (PUT) before answering.
+ */
+class iHipObjS3RdmaClient {
+public:
+    virtual ~iHipObjS3RdmaClient() = default;
+
+    /**
+     * Asynchronously put an object to S3 by RDMA.
+     *
+     * The body is empty -- the server pulls the payload out of the buffer the
+     * token names.
+     *
+     * @param key The object key
+     * @param data_len Number of bytes the server should read
+     * @param offset Offset within the object
+     * @param rdma_token Hex-encoded token from hipObjGetRdmaToken()
+     * @param callback Invoked on completion
+     */
+    virtual void
+    putObjectRdmaAsync(std::string_view key,
+                       size_t data_len,
+                       size_t offset,
+                       std::string_view rdma_token,
+                       rdma_object_callback_t callback) = 0;
+
+    /**
+     * Asynchronously get an object from S3 by RDMA.
+     *
+     * The response body is empty -- the payload arrives in the buffer the
+     * token names, before the headers come back.
+     *
+     * @param key The object key
+     * @param data_len Number of bytes to fetch
+     * @param offset Offset within the object to start from
+     * @param rdma_token Hex-encoded token from hipObjGetRdmaToken()
+     * @param callback Invoked on completion
+     */
+    virtual void
+    getObjectRdmaAsync(std::string_view key,
+                       size_t data_len,
+                       size_t offset,
+                       std::string_view rdma_token,
+                       rdma_object_callback_t callback) = 0;
+};
+
+#endif // NIXL_OBJ_PLUGIN_S3_HIPOBJ_RDMA_INTERFACE_H
