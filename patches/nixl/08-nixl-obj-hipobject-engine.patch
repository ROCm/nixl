+/**
+ * One descriptor's worth of transfer: the buffer, where in the object it goes,
+ * and the token that names the buffer to the server.
+ */
+struct hipObjTransferReq {
+    uintptr_t addr = 0;
+    size_t size = 0;
+    size_t offset = 0;
+    std::string obj_key;
+    hipObjTokenPtr token;
+};
+
+/**
+ * Backend request handle. Holds the per-descriptor requests, whose tokens it
+ * owns, and the futures that bridge the S3 client's callbacks to NIXL's
+ * polling interface.
+ */
+class nixlHipObjBackendReqH : public nixlBackendReqH {
+public:
+    std::vector<hipObjTransferReq> reqs_;
+    std::vector<std::future<nixl_status_t>> statusFutures_;
+
+    nixlHipObjBackendReqH() = default;
+    ~nixlHipObjBackendReqH() = default;
+
+    /**
+     * First error wins; otherwise NIXL_IN_PROG while any future is pending,
+     * and NIXL_SUCCESS once all have completed.
+     */
+    nixl_status_t
+    getOverallStatus() {
+        bool has_pending = false;
+        auto it = statusFutures_.begin();
+        while (it != statusFutures_.end()) {
+            if (it->wait_for(std::chrono::seconds(0)) == std::future_status::ready) {
+                auto current_status = it->get();
+                if (current_status != NIXL_SUCCESS) {
+                    statusFutures_.clear();
+                    return current_status;
+                }
+                it = statusFutures_.erase(it);
+            } else {
+                ++it;
+                has_pending = true;
+            }
+        }
+        return has_pending ? NIXL_IN_PROG : NIXL_SUCCESS;
+    }
+};
+
+/**
+ * Metadata for a registered object or memory region.
+ */
+class nixlHipObjMetadata : public nixlBackendMD {
+public:
+    /// For object segments.
+    nixlHipObjMetadata(nixl_mem_t nixl_mem, uint64_t dev_id, std::string obj_key)
+        : nixlBackendMD(true),
+          nixlMem(nixl_mem),
+          devId(dev_id),
+          objKey(std::move(obj_key)),
+          localAddr(0),
+          localLen(0) {}
+
+    /// For DRAM/VRAM segments.
+    nixlHipObjMetadata(nixl_mem_t nixl_mem, uintptr_t addr, size_t len)
+        : nixlBackendMD(true),
+          nixlMem(nixl_mem),
+          devId(0),
+          localAddr(addr),
+          localLen(len) {}
+
+    ~nixlHipObjMetadata() = default;
+
+    nixl_mem_t nixlMem;
+    uint64_t devId;
+    std::string objKey;
+    uintptr_t localAddr;
+    size_t localLen;
+};
+
+/**
+ * Decide what the server's x-amz-rdma-reply means.
+ *
+ * An absent header is the awkward case. A server that never saw the token
+ * answers a normal 200 with a normal body, having moved nothing by RDMA, and
+ * the registered buffer still holds whatever it held before. Treating that as
+ * success would report a transfer that did not happen, so it is an error here.
+ *
+ * @param reply The raw header value, or empty if there was none
+ * @return NIXL_SUCCESS, or the error the reply describes
+ */
+nixl_status_t
+statusFromRdmaReply(const std::string &reply) {
+    if (reply.empty()) {
+        NIXL_ERROR << "S3 response carried no x-amz-rdma-reply header: the server does not "
+                      "speak the RDMA object protocol, and no data was transferred by RDMA";
+        return NIXL_ERR_BACKEND;
+    }
+
+    int http_code = 0;
+    const hipObjError_t err = hipObjParseRdmaReply(reply.c_str(), reply.size(), &http_code);
+    if (err.opError != hipObjSuccess) {
+        // THE TWO SPECS DISAGREE, AND THIS IS THE SEAM.
+        //
+        // hipObject's docs/interop.rst says the only token-bearing form of
+        // x-amz-rdma-reply is "200:<88-hex>", and its parser enforces exactly
+        // that -- a status it does not recognise, or a token after any status
+        // but 200, is rejected outright rather than reported.
+        //
+        // rocm-ernic's S3 server answers a ranged GET with "206:<88-hex>",
+        // which is the correct HTTP status for a Range request and which
+        // hipObject's own public header lists among the codes a reply may
+        // carry (200, 204, 206, 501). So a GET that completed perfectly well
+        // arrives here as hipObjInvalidValue.
+        //
+        // Reading the leading status ourselves rather than failing is the
+        // right call for a client: the transfer succeeded, the server said so,
+        // and the disagreement is about which statuses may be accompanied by a
+        // peer token -- which this engine does not use. The token is ignored
+        // either way.
+        const size_t colon = reply.find(':');
+        const std::string_view status(reply.data(), colon == std::string::npos ? reply.size() :
+                                                                                 colon);
+        if (status.size() != 3 ||
+            std::any_of(status.begin(), status.end(), [](char c) { return !isdigit(c); })) {
+            NIXL_ERROR << "Could not parse x-amz-rdma-reply '" << reply << "': "
+                       << hipObjErrStr(err);
+            return NIXL_ERR_BACKEND;
+        }
+        http_code = std::stoi(std::string(status));
+        NIXL_DEBUG << "hipObjParseRdmaReply rejected '" << reply << "'; read status " << http_code
+                   << " directly";
+    }
+
+    if (http_code == HIPOBJ_RDMA_REPLY_NOT_IMPLEMENTED) {
+        NIXL_ERROR << "Server declined RDMA (x-amz-rdma-reply 501) and fell back to HTTP, which "
+                      "this engine cannot consume: no data reached the registered buffer";
+        return NIXL_ERR_BACKEND;
+    }
+
+    // 200, 204 and 206 all mean the server completed the RDMA side.
+    if (http_code != 200 && http_code != 204 && http_code != 206) {
+        NIXL_ERROR << "Server reported x-amz-rdma-reply " << http_code;
+        return NIXL_ERR_BACKEND;
+    }
+
+    return NIXL_SUCCESS;
+}
