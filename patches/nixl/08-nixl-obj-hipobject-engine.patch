diff --git a/src/plugins/obj/s3_accel/amd/client.cpp b/src/plugins/obj/s3_accel/amd/client.cpp
new file mode 100644
index 0000000..99276c7
--- /dev/null
+++ b/src/plugins/obj/s3_accel/amd/client.cpp
@@ -0,0 +1,182 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "client.h"
+#include "object/s3/utils.h"
+#include <aws/s3/model/PutObjectRequest.h>
+#include <aws/s3/model/GetObjectRequest.h>
+#include <aws/core/http/HttpResponse.h>
+#include <absl/strings/str_format.h>
+#include <memory>
+#include <string>
+#include "common/nixl_log.h"
+
+namespace {
+
+/// The request header that carries the client's registered-buffer token.
+constexpr const char *kRdmaTokenHeader = "x-amz-rdma-token";
+/// The response header in which the server says what it did with it.
+constexpr const char *kRdmaReplyHeader = "x-amz-rdma-reply";
+
+/**
+ * Arrange for the x-amz-rdma-reply header to survive into the completion
+ * callback.
+ *
+ * The AWS SDK's generated result types expose only the headers the S3 model
+ * knows about -- GetObjectResult has accessors for Content-Range and the
+ * x-amz-meta-* map and nothing else, and an unmodelled header is parsed and
+ * dropped. The headers-received event handler is the one place the raw
+ * HttpResponse is reachable, so the reply is copied out there and read later.
+ *
+ * The handler runs on the HTTP transfer thread and the completion callback
+ * runs after the response is complete, so the shared string is written before
+ * it is read.
+ *
+ * @return The shared slot the handler will fill
+ */
+std::shared_ptr<std::string>
+captureRdmaReply(Aws::AmazonWebServiceRequest &request) {
+    auto reply = std::make_shared<std::string>();
+    request.SetHeadersReceivedEventHandler(
+        [reply](const Aws::Http::HttpRequest *, Aws::Http::HttpResponse *response) {
+            if (response != nullptr && response->HasHeader(kRdmaReplyHeader)) {
+                *reply = response->GetHeader(kRdmaReplyHeader);
+            }
+        });
+    return reply;
+}
+
+} // namespace
+
+awsS3HipObjClient::awsS3HipObjClient(nixl_b_params_t *custom_params,
+                                     std::shared_ptr<Aws::Utils::Threading::Executor> executor)
+    : awsS3AccelClient(custom_params, executor) {
+    NIXL_DEBUG << "Initialized hipObject S3 RDMA client";
+}
+
+void
+awsS3HipObjClient::putObjectRdmaAsync(std::string_view key,
+                                      size_t data_len,
+                                      size_t offset,
+                                      std::string_view rdma_token,
+                                      rdma_object_callback_t callback) {
+    NIXL_DEBUG << absl::StrFormat(
+        "putObjectRdmaAsync: key=%s, data_len=%zu, offset=%zu, token_len=%zu",
+        std::string(key).c_str(),
+        data_len,
+        offset,
+        rdma_token.size());
+
+    if (data_len == 0) {
+        NIXL_ERROR << "putObjectRdmaAsync: data_len is 0";
+        callback(false, "");
+        return;
+    }
+
+    if (rdma_token.empty()) {
+        NIXL_ERROR << "putObjectRdmaAsync: rdma_token is empty";
+        callback(false, "");
+        return;
+    }
+
+    Aws::S3::Model::PutObjectRequest request;
+    request.WithBucket(bucketName_).WithKey(Aws::String(key));
+    request.SetAdditionalCustomHeaderValue(kRdmaTokenHeader, std::string(rdma_token));
+
+    // The payload does not travel in the body -- the server RDMA READs it out
+    // of the buffer the token names -- so the body is empty and must be
+    // declared so, or the SDK waits for a stream that never comes.
+    request.SetContentLength(0);
+
+    // Where the data goes within the object. hipObject deliberately sends no
+    // object offset of its own (the token describes the client buffer, not the
+    // object), so saying so is the request's job. S3 PutObject has no ranged
+    // form, so a non-zero offset here has no way to be expressed.
+    if (offset != 0) {
+        NIXL_ERROR << absl::StrFormat(
+            "putObjectRdmaAsync: object offset %zu is not expressible in a PutObject request",
+            offset);
+        callback(false, "");
+        return;
+    }
+
+    auto reply = captureRdmaReply(request);
+
+    s3Client_->PutObjectAsync(
+        request,
+        [callback, reply](const Aws::S3::S3Client *,
+                          const Aws::S3::Model::PutObjectRequest &,
+                          const Aws::S3::Model::PutObjectOutcome &outcome,
+                          const std::shared_ptr<const Aws::Client::AsyncCallerContext> &) {
+            if (!outcome.IsSuccess()) {
+                const auto &error = outcome.GetError();
+                NIXL_ERROR << absl::StrFormat("putObjectRdmaAsync: PutObject failed - %s: %s "
+                                              "(HTTP %d)",
+                                              error.GetExceptionName().c_str(),
+                                              error.GetMessage().c_str(),
+                                              static_cast<int>(error.GetResponseCode()));
+            }
+            callback(outcome.IsSuccess(), *reply);
+        },
+        nullptr);
+}
+
+void
+awsS3HipObjClient::getObjectRdmaAsync(std::string_view key,
+                                      size_t data_len,
+                                      size_t offset,
+                                      std::string_view rdma_token,
+                                      rdma_object_callback_t callback) {
+    NIXL_DEBUG << absl::StrFormat(
+        "getObjectRdmaAsync: key=%s, data_len=%zu, offset=%zu, token_len=%zu",
+        std::string(key).c_str(),
+        data_len,
+        offset,
+        rdma_token.size());
+
+    if (data_len == 0) {
+        NIXL_ERROR << "getObjectRdmaAsync: data_len is 0";
+        callback(false, "");
+        return;
+    }
+
+    if (offset > (SIZE_MAX - (data_len - 1))) {
+        NIXL_ERROR << "getObjectRdmaAsync: offset + data_len would overflow";
+        callback(false, "");
+        return;
+    }
+
+    if (rdma_token.empty()) {
+        NIXL_ERROR << "getObjectRdmaAsync: rdma_token is empty";
+        callback(false, "");
+        return;
+    }
+
+    Aws::S3::Model::GetObjectRequest request;
+    request.WithBucket(bucketName_)
+        .WithKey(Aws::String(key))
+        .WithRange(absl::StrFormat("bytes=%zu-%zu", offset, offset + data_len - 1));
+    request.SetAdditionalCustomHeaderValue(kRdmaTokenHeader, std::string(rdma_token));
+
+    auto reply = captureRdmaReply(request);
+
+    s3Client_->GetObjectAsync(
+        request,
+        [callback, reply](const Aws::S3::S3Client *,
+                          const Aws::S3::Model::GetObjectRequest &,
+                          const Aws::S3::Model::GetObjectOutcome &outcome,
+                          const std::shared_ptr<const Aws::Client::AsyncCallerContext> &) {
+            if (!outcome.IsSuccess()) {
+                const auto &error = outcome.GetError();
+                NIXL_ERROR << absl::StrFormat("getObjectRdmaAsync: GetObject failed - %s: %s "
+                                              "(HTTP %d)",
+                                              error.GetExceptionName().c_str(),
+                                              error.GetMessage().c_str(),
+                                              static_cast<int>(error.GetResponseCode()));
+            }
+            callback(outcome.IsSuccess(), *reply);
+        },
+        nullptr);
+}
