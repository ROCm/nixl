+nixl_status_t
+S3HipObjEngineImpl::registerMem(const nixlBlobDesc &mem,
+                                const nixl_mem_t &nixl_mem,
+                                nixlBackendMD *&out) {
+    if (!hipObjReady_) {
+        NIXL_ERROR << "hipObject is not initialized";
+        return NIXL_ERR_BACKEND;
+    }
+
+    const auto supported_mems = {OBJ_SEG, DRAM_SEG, VRAM_SEG};
+    if (std::find(supported_mems.begin(), supported_mems.end(), nixl_mem) ==
+        supported_mems.end()) {
+        return NIXL_ERR_NOT_SUPPORTED;
+    }
+
+    if (nixl_mem == OBJ_SEG) {
+        auto obj_md = std::make_unique<nixlHipObjMetadata>(
+            nixl_mem, mem.devId, mem.metaInfo.empty() ? std::to_string(mem.devId) : mem.metaInfo);
+        devIdToObjKey_[mem.devId] = obj_md->objKey;
+        out = obj_md.release();
+        return NIXL_SUCCESS;
+    }
+
+    NIXL_DEBUG << absl::StrFormat(
+        "registerMem: addr=0x%x, len=%zu, nixl_mem=%d", mem.addr, mem.len, nixl_mem);
+
+    auto mem_md = std::make_unique<nixlHipObjMetadata>(nixl_mem, mem.addr, mem.len);
+
+    // VRAM goes through hipObjBufRegister, which tries dmabuf first and falls
+    // back to a host staging buffer when the NIC cannot reach device memory.
+    // DRAM has its own entry point and never stages.
+    void *ptr = reinterpret_cast<void *>(mem.addr);
+    const hipObjError_t err = (nixl_mem == VRAM_SEG) ? hipObjBufRegister(ptr, mem.len) :
+                                                       hipObjBufRegisterHost(ptr, mem.len);
+    if (err.opError != hipObjSuccess) {
+        NIXL_ERROR << "hipObjBufRegister failed for " << mem.len
+                   << " bytes: " << hipObjErrStr(err);
+        return (err.opError == hipObjSizeTooLarge) ? NIXL_ERR_NOT_SUPPORTED : NIXL_ERR_BACKEND;
+    }
+
+    registeredBufs_[mem.addr] = mem.len;
+    out = mem_md.release();
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+S3HipObjEngineImpl::deregisterMem(nixlBackendMD *meta) {
+    auto *md = static_cast<nixlHipObjMetadata *>(meta);
+    if (md == nullptr) {
+        return NIXL_SUCCESS;
+    }
+
+    std::unique_ptr<nixlHipObjMetadata> owned(md);
+
+    if (md->nixlMem == OBJ_SEG) {
+        devIdToObjKey_.erase(md->devId);
+        return NIXL_SUCCESS;
+    }
+
+    const hipObjError_t err =
+        hipObjBufDeregister(reinterpret_cast<void *>(md->localAddr));
+    if (err.opError != hipObjSuccess) {
+        NIXL_ERROR << "hipObjBufDeregister failed: " << hipObjErrStr(err);
+        // The registration is still live, so the metadata must stay valid for
+        // the caller to retry with. Hand ownership back.
+        owned.release();
+        return NIXL_ERR_BACKEND;
+    }
+
+    registeredBufs_.erase(md->localAddr);
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+S3HipObjEngineImpl::prepXfer(const nixl_xfer_op_t &operation,
+                             const nixl_meta_dlist_t &local,
+                             const nixl_meta_dlist_t &remote,
+                             const std::string &remote_agent,
+                             const std::string &local_agent,
+                             nixlBackendReqH *&handle,
+                             const nixl_opt_b_args_t *opt_args) const {
+    if (!hipObjReady_) {
+        NIXL_ERROR << "hipObject is not initialized";
+        return NIXL_ERR_BACKEND;
+    }
+
+    if (!isValidPrepXferParams(operation, local, remote, remote_agent, local_agent)) {
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    auto req_h = std::make_unique<nixlHipObjBackendReqH>();
+
+    for (int i = 0; i < local.descCount(); ++i) {
+        hipObjTransferReq req;
+        req.addr = local[i].addr;
+        req.size = local[i].len;
+        req.offset = remote[i].addr;
+
+        const auto obj_key_search = devIdToObjKey_.find(remote[i].devId);
+        if (obj_key_search == devIdToObjKey_.end()) {
+            NIXL_ERROR << "The object segment key " << remote[i].devId
+                       << " is not registered with the backend";
+            return NIXL_ERR_INVALID_PARAM;
+        }
+        req.obj_key = obj_key_search->second;
+
+        // See limit 1 in the class comment: the token always describes the
+        // registration's base, so a descriptor that starts anywhere else would
+        // silently name the wrong memory.
+        const auto reg = registeredBufs_.find(req.addr);
+        if (reg == registeredBufs_.end()) {
+            NIXL_ERROR << absl::StrFormat(
+                "Transfer must start at the base of a registered buffer; 0x%x is not one. "
+                "hipObjGetRdmaToken() cannot describe an offset into a registration.",
+                req.addr);
+            return NIXL_ERR_INVALID_PARAM;
+        }
+        if (req.size > reg->second) {
+            NIXL_ERROR << absl::StrFormat("Transfer of %zu bytes exceeds the %zu-byte "
+                                          "registration at 0x%x",
+                                          req.size,
+                                          reg->second,
+                                          req.addr);
+            return NIXL_ERR_INVALID_PARAM;
+        }
+
+        const int op = (operation == NIXL_WRITE) ? HIPOBJ_RDMA_OP_PUT : HIPOBJ_RDMA_OP_GET;
+        char *token = nullptr;
+        const hipObjError_t err =
+            hipObjGetRdmaToken(reinterpret_cast<void *>(req.addr), req.size, op, &token);
+        if (err.opError != hipObjSuccess) {
+            NIXL_ERROR << "hipObjGetRdmaToken failed: " << hipObjErrStr(err);
+            return NIXL_ERR_BACKEND;
+        }
+        req.token.reset(token);
+
+        req_h->reqs_.push_back(std::move(req));
+    }
+
+    handle = req_h.release();
+    return NIXL_SUCCESS;
+}
+
+nixl_status_t
+S3HipObjEngineImpl::postXfer(const nixl_xfer_op_t &operation,
+                             const nixl_meta_dlist_t &local,
+                             const nixl_meta_dlist_t &remote,
+                             const std::string &remote_agent,
+                             nixlBackendReqH *&handle,
+                             const nixl_opt_b_args_t *opt_args) const {
+    if (handle == nullptr) {
+        NIXL_ERROR << "transfer request handle is null";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+
+    auto *req_h = static_cast<nixlHipObjBackendReqH *>(handle);
+
+    auto *rdma_client = dynamic_cast<iHipObjS3RdmaClient *>(s3Client_.get());
+    if (rdma_client == nullptr) {
+        NIXL_ERROR << "hipObject RDMA operations require an iHipObjS3RdmaClient";
+        return NIXL_ERR_BACKEND;
+    }
+
+    for (const auto &req : req_h->reqs_) {
+        auto status_promise = std::make_shared<std::promise<nixl_status_t>>();
+        req_h->statusFutures_.push_back(status_promise->get_future());
+
+        const std::string_view token(req.token.get());
+
+        if (operation == NIXL_WRITE) {
+            // When hipObject staged this buffer through host memory, the
+            // server will RDMA READ the staging copy, so the device's contents
+            // have to be there first. A no-op, reporting success, for a buffer
+            // the NIC registered directly.
+            const hipObjError_t sync = hipObjBufSync(
+                reinterpret_cast<void *>(req.addr), req.size, 0, HIPOBJ_SYNC_TO_HOST);
+            if (sync.opError != hipObjSuccess) {
+                NIXL_ERROR << "hipObjBufSync to host failed: " << hipObjErrStr(sync);
+                status_promise->set_value(NIXL_ERR_BACKEND);
+                continue;
+            }
+
+            rdma_client->putObjectRdmaAsync(
+                req.obj_key,
+                req.size,
+                req.offset,
+                token,
+                [status_promise](bool success, std::string reply) {
+                    status_promise->set_value(success ? statusFromRdmaReply(reply) :
+                                                        NIXL_ERR_BACKEND);
+                });
+        } else {
+            // The mirror image: the payload lands in the staging buffer, so it
+            // has to be copied up to the device before the transfer can be
+            // called complete. Doing it here, inside the completion callback,
+            // is what keeps checkXfer()'s NIXL_SUCCESS meaning "the data is
+            // where the caller asked for it".
+            const uintptr_t addr = req.addr;
+            const size_t size = req.size;
+            rdma_client->getObjectRdmaAsync(
+                req.obj_key,
+                req.size,
+                req.offset,
+                token,
+                [status_promise, addr, size](bool success, std::string reply) {
+                    if (!success) {
+                        status_promise->set_value(NIXL_ERR_BACKEND);
+                        return;
+                    }
+                    const nixl_status_t status = statusFromRdmaReply(reply);
+                    if (status != NIXL_SUCCESS) {
+                        status_promise->set_value(status);
+                        return;
+                    }
+                    const hipObjError_t sync = hipObjBufSync(
+                        reinterpret_cast<void *>(addr), size, 0, HIPOBJ_SYNC_TO_DEVICE);
+                    if (sync.opError != hipObjSuccess) {
+                        NIXL_ERROR << "hipObjBufSync to device failed: " << hipObjErrStr(sync);
+                        status_promise->set_value(NIXL_ERR_BACKEND);
+                        return;
+                    }
+                    status_promise->set_value(NIXL_SUCCESS);
+                });
+        }
+    }
+
+    return NIXL_IN_PROG;
+}
+
+nixl_status_t
+S3HipObjEngineImpl::checkXfer(nixlBackendReqH *handle) const {
+    if (handle == nullptr) {
+        NIXL_ERROR << "transfer request handle is null";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    return static_cast<nixlHipObjBackendReqH *>(handle)->getOverallStatus();
+}
+
+nixl_status_t
+S3HipObjEngineImpl::releaseReqH(nixlBackendReqH *handle) const {
+    if (handle == nullptr) {
+        NIXL_ERROR << "transfer request handle is null";
+        return NIXL_ERR_INVALID_PARAM;
+    }
+    delete static_cast<nixlHipObjBackendReqH *>(handle);
+    return NIXL_SUCCESS;
+}
