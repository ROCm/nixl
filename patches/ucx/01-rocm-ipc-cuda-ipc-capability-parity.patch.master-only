# rocm_ipc: bring its advertised capabilities to parity with cuda_ipc.
#
# THE PROBLEM
#
# UCP's RMA API never routes to rocm_ipc on ROCm, so ucp_put/ucp_get on GPU
# memory degrade to rma_am over TCP.  Reproducible with no NIXL at all:
#
#   ucx_perftest -t ucp_put_bw -m rocm ...  -> rma(sysv/posix)            ~0.4 GB/s
#   ucx_perftest -t tag_bw     -m rocm ...  -> tag(... rocm_ipc/rocm_ipc)  ~511 GB/s
#
# rocm_ipc is not slow -- the rendezvous path uses it at full speed.  It is
# simply never eligible for the lanes the RMA API uses.
#
# THE CAUSE
#
# Comparing rocm_ipc with cuda_ipc, which does not have this problem, the two
# transports are functionally equivalent but advertise different capabilities:
#
#   cuda_ipc md_attr->flags: REG | NEED_RKEY | INVALIDATE | INVALIDATE_RMA |
#                            INVALIDATE_AMO | MEMTYPE_COPY | RKEY_PTR
#   rocm_ipc md_attr->flags: REG | NEED_RKEY | MEMTYPE_COPY
#
#   cuda_ipc iface cap.flags: ... | ERRHANDLE_PEER_FAILURE
#   rocm_ipc iface cap.flags: ... (no ERRHANDLE_PEER_FAILURE)
#
# Two of those gaps are load-bearing:
#
#   * UCT_MD_FLAG_INVALIDATE_RMA -- ucp_wireup_add_rma_bw_lanes() adds this to
#     its criteria whenever the endpoint requests peer error handling:
#
#         if ((ep_init_flags & UCP_EP_INIT_ERR_MODE_PEER_FAILURE) &&
#             ucp_context_rndv_is_enabled(context)) {
#             bw_info.criteria.local_md_flags |= UCT_MD_FLAG_INVALIDATE_RMA;
#         }
#
#     NIXL creates its endpoints with UCP_ERR_HANDLING_MODE_PEER by default, so
#     rocm_ipc is filtered out of the rma_bw lanes before scoring.
#
#   * UCT_MD_FLAG_RKEY_PTR -- rocm_ipc implements uct_rocm_ipc_rkey_ptr (it maps
#     the peer allocation and returns a local pointer) but advertises neither
#     the MD flag nor UCT_COMPONENT_FLAG_RKEY_PTR, so UCP's "check rkey_ptr"
#     block never considers it for an RKEY_PTR lane either.  openucx/ucx#11069
#     is the equivalent fix for cuda_ipc's component flag.
#
# WHAT THIS PATCH DOES
#
#   rocm_ipc_iface.c  + UCT_IFACE_FLAG_ERRHANDLE_PEER_FAILURE
#   rocm_ipc_md.c     + INVALIDATE | INVALIDATE_RMA | INVALIDATE_AMO | RKEY_PTR
#                     + UCT_COMPONENT_FLAG_RKEY_PTR on the component
#                     + UCT_MD_MEM_DEREG_CHECK_PARAMS(params, 1)
#
# The last line is the honest counterpart of claiming INVALIDATE: the macro
# rejects a dereg-with-invalidate when the transport says it cannot do it.
# (cuda_ipc claims the flags but still passes 0 there; that only goes unnoticed
# because the check compiles out unless ENABLE_PARAMS_CHECK.)  Invalidation is
# meaningful for an IPC transport in the same sense it is for cuda_ipc:
# deregistration destroys the mapping, and both implementations' mem_dereg are
# otherwise no-ops.
#
# Applies to openucx/ucx master.  v1.19.x has no uct_rocm_ipc_rkey_ptr
# implementation, so the RKEY_PTR half is meaningless there; build with
#   make ... UCX_GIT_URL=https://github.com/openucx/ucx.git UCX_REF=master
#
# MEASURED RESULT ON MI300X (gfx942), openucx master + this patch
#
# It does exactly half the job, and the half it does is verifiable:
#
#   without patch:  no rma_bw lane for rocm_ipc at all
#   with patch:     ep lane[2]: 7:rocm_ipc/rocm_ipc.0 md[6] -> ... rma_bw#0
#
# So the INVALIDATE_RMA flag is genuinely what was keeping rocm_ipc out of the
# rma_bw lanes under NIXL's peer error handling.  That part is fixed.
#
# It does NOT change end-to-end bandwidth, because UCP's protocol selection for
# the RMA API never uses that lane.  With UCX_PROTO_INFO=y, even for a
# GPU-to-GPU transfer:
#
#   | remote memory write by ucp_put*(multi) from rocm/GPU1 to rocm/dev[0] |
#   | 0..inf | software emulation | tcp/eth2                              |
#
# "software emulation" across the whole size range, on tcp, while an rma_bw
# lane on rocm_ipc sits unused.  rma_bw lanes are consumed by the RENDEZVOUS
# protocols (tag/AM), which is why `ucx_perftest -t tag_bw -m rocm` reaches
# ~511 GB/s on the very same lane while `-t ucp_put_bw -m rocm` gets ~0.4 GB/s.
#
# The remaining gap is therefore in UCP's protocol layer, not in transport
# capabilities: there is no put/get zcopy protocol for GPU memory that will use
# an rma_bw lane.  That is a feature, not a flag, and it needs a decision from
# the people who own UCP protocol selection -- which is why this patch is
# offered as a diagnosis and a partial fix rather than the answer.
#
diff --git a/src/uct/rocm/ipc/rocm_ipc_iface.c b/src/uct/rocm/ipc/rocm_ipc_iface.c
index 89c82d1..4f89324 100644
--- a/src/uct/rocm/ipc/rocm_ipc_iface.c
+++ b/src/uct/rocm/ipc/rocm_ipc_iface.c
@@ -124,7 +124,8 @@ static ucs_status_t uct_rocm_ipc_iface_query(uct_iface_h tl_iface,
     iface_attr->cap.flags               = UCT_IFACE_FLAG_GET_ZCOPY |
                                           UCT_IFACE_FLAG_PUT_ZCOPY | UCT_IFACE_FLAG_PENDING |
                                           UCT_IFACE_FLAG_CONNECT_TO_IFACE |
-                                          UCT_IFACE_FLAG_DEVICE_EP;
+                                          UCT_IFACE_FLAG_DEVICE_EP |
+                                          UCT_IFACE_FLAG_ERRHANDLE_PEER_FAILURE;
     iface_attr->ctl_device              = UCS_SYS_DEVICE_ID_UNKNOWN;
 
     iface_attr->latency = ucs_linear_func_make(iface->config.latency, 0);
diff --git a/src/uct/rocm/ipc/rocm_ipc_md.c b/src/uct/rocm/ipc/rocm_ipc_md.c
index d66dbe0..afbec2d 100644
--- a/src/uct/rocm/ipc/rocm_ipc_md.c
+++ b/src/uct/rocm/ipc/rocm_ipc_md.c
@@ -28,8 +28,13 @@ static ucs_status_t uct_rocm_ipc_md_query(uct_md_h md, uct_md_attr_v2_t *md_attr
 {
     uct_md_base_md_query(md_attr);
     md_attr->rkey_packed_size = sizeof(uct_rocm_ipc_key_t);
-    md_attr->flags            = UCT_MD_FLAG_REG | UCT_MD_FLAG_NEED_RKEY |
-                                UCT_MD_FLAG_MEMTYPE_COPY;
+    md_attr->flags            = UCT_MD_FLAG_REG |
+                                UCT_MD_FLAG_NEED_RKEY |
+                                UCT_MD_FLAG_INVALIDATE |
+                                UCT_MD_FLAG_INVALIDATE_RMA |
+                                UCT_MD_FLAG_INVALIDATE_AMO |
+                                UCT_MD_FLAG_MEMTYPE_COPY |
+                                UCT_MD_FLAG_RKEY_PTR;
     md_attr->reg_mem_types    = UCS_BIT(UCS_MEMORY_TYPE_ROCM);
     md_attr->cache_mem_types  = UCS_BIT(UCS_MEMORY_TYPE_ROCM);
     md_attr->access_mem_types = UCS_BIT(UCS_MEMORY_TYPE_ROCM);
@@ -113,7 +118,7 @@ uct_rocm_ipc_mem_dereg(uct_md_h md,
 {
     uct_rocm_ipc_key_t *mem_hndl;
 
-    UCT_MD_MEM_DEREG_CHECK_PARAMS(params, 0);
+    UCT_MD_MEM_DEREG_CHECK_PARAMS(params, 1);
 
     mem_hndl = params->memh;
     ucs_free(mem_hndl);
@@ -273,7 +278,7 @@ uct_rocm_ipc_component_t uct_rocm_ipc_component = {
         },
         .cm_config          = UCS_CONFIG_EMPTY_GLOBAL_LIST_ENTRY,
         .tl_list            = UCT_COMPONENT_TL_LIST_INITIALIZER(&uct_rocm_ipc_component.super),
-        .flags              = 0,
+        .flags              = UCT_COMPONENT_FLAG_RKEY_PTR,
         .md_vfs_init        =
                 (uct_component_md_vfs_init_func_t)ucs_empty_function
     },
