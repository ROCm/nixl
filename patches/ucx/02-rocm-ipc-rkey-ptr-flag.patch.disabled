# rocm_ipc: advertise peer-failure handling AND the rkey_ptr it implements.
#
# Two one-line capability changes, against openucx/ucx MASTER (not v1.19.x --
# v1.19.x's rocm_ipc rkey_ptr is ucs_empty_function_return_unsupported, so
# there is nothing to advertise there):
#
#   rocm_ipc_iface.c  + UCT_IFACE_FLAG_ERRHANDLE_PEER_FAILURE
#   rocm_ipc_md.c     .flags = 0 -> UCT_COMPONENT_FLAG_RKEY_PTR
#
# The second is the interesting one.  master implements uct_rocm_ipc_rkey_ptr
# for real (it maps the peer allocation and returns a local pointer), but the
# component still declares .flags = 0, so UCP's "check rkey_ptr" block in
# ucp_wireup_add_rma_bw_lanes never considers rocm_ipc for an RKEY_PTR lane.
# cuda_ipc is in exactly the same state, and openucx/ucx#11069 is open to fix
# it there -- this is the ROCm equivalent of that PR.
#
# RESULT ON gfx942: no change.  Still rma_am(tcp), lane selection identical.
# Disabled for the same reason as the peer-failure flag alone: it does not fix
# the problem here and it asserts capabilities, so it is recorded rather than
# shipped.  See README.md for the full matrix of what was tried.
#
diff --git a/src/uct/rocm/ipc/rocm_ipc_iface.c b/src/uct/rocm/ipc/rocm_ipc_iface.c
index 89c82d1..4f89324 100644
--- a/src/uct/rocm/ipc/rocm_ipc_iface.c
+++ b/src/uct/rocm/ipc/rocm_ipc_iface.c
@@ -124,7 +124,8 @@ static ucs_status_t uct_rocm_ipc_iface_query(uct_iface_h tl_iface,
     iface_attr->cap.flags               = UCT_IFACE_FLAG_GET_ZCOPY |
                                           UCT_IFACE_FLAG_PUT_ZCOPY | UCT_IFACE_FLAG_PENDING |
                                           UCT_IFACE_FLAG_CONNECT_TO_IFACE |
-                                          UCT_IFACE_FLAG_DEVICE_EP;
+                                          UCT_IFACE_FLAG_DEVICE_EP |
+                                          UCT_IFACE_FLAG_ERRHANDLE_PEER_FAILURE;
     iface_attr->ctl_device              = UCS_SYS_DEVICE_ID_UNKNOWN;
 
     iface_attr->latency = ucs_linear_func_make(iface->config.latency, 0);
diff --git a/src/uct/rocm/ipc/rocm_ipc_md.c b/src/uct/rocm/ipc/rocm_ipc_md.c
index d66dbe0..68bd451 100644
--- a/src/uct/rocm/ipc/rocm_ipc_md.c
+++ b/src/uct/rocm/ipc/rocm_ipc_md.c
@@ -273,7 +273,7 @@ uct_rocm_ipc_component_t uct_rocm_ipc_component = {
         },
         .cm_config          = UCS_CONFIG_EMPTY_GLOBAL_LIST_ENTRY,
         .tl_list            = UCT_COMPONENT_TL_LIST_INITIALIZER(&uct_rocm_ipc_component.super),
-        .flags              = 0,
+        .flags              = UCT_COMPONENT_FLAG_RKEY_PTR,
         .md_vfs_init        =
                 (uct_component_md_vfs_init_func_t)ucs_empty_function
     },
